rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // E-mail confirmado (login com Google já vem confirmado).
    // Exigido para ações que chegam em outras pessoas: mensagens, seguir,
    // vínculos, negócios, anúncios e publicações. Freia contas falsas e robôs.
    // Conta suspensa ou banida pela equipe (sancoes/{uid}) também não age.
    function emailOk() {
      return request.auth.token.email_verified == true && !sancionado(request.auth.uid);
    }

    // Para anunciar (criar perfil de negócio ou anúncio de imóvel), a conta precisa ser verificada:
    // usuarios/{uid}.verificado só vira true pela moderação com o pedido aprovado (seloLiberado) ou pelo dono do site.
    function contaVerificada() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('verificado', false) == true;
    }

    // Administrador: documento admins/{uid} criado à mão no console do Firebase.
    function admin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Papel na equipe (campo "papel" no documento admins/{uid}, definido no console).
    // Sem o campo = "dono" (acesso total). Outros: moderacao, suporte, comercial.
    function papel() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('papel', 'dono');
    }
    // Moderação: selo, esconder/remover conteúdo, suspender/banir, denúncias, comunicados.
    function podeModerar() {
      return admin() && papel() in ['dono', 'moderacao'];
    }
    // Selo de verificado: tirar é livre para a moderação; dar, só com o pedido aprovado
    // (verificacoes/{uid}) ou pelo dono do site (casos especiais, com motivo no registro).
    function seloLiberado(uid) {
      return request.resource.data.get('verificado', false) != true
          || resource.data.get('verificado', false) == true
          || papel() == 'dono'
          || (exists(/databases/$(database)/documents/verificacoes/$(uid))
              && get(/databases/$(database)/documents/verificacoes/$(uid)).data.status == 'aprovada');
    }
    // Comercial: propostas de sócios e parcerias.
    function podeComercial() {
      return admin() && papel() in ['dono', 'comercial'];
    }
    // Só os donos do site: planos (pagamentos, negociações, receita) e o registro de ações da equipe.
    function donoDoSite() {
      return admin() && papel() == 'dono';
    }

    // Suspensão (até uma data) ou banimento (sem data).
    function sancionado(uid) {
      let s = /databases/$(database)/documents/sancoes/$(uid);
      return exists(s)
          && (get(s).data.tipo == 'banimento'
              || (get(s).data.get('ate', null) is timestamp && get(s).data.ate > request.time));
    }

    // Banido de um programa (um tipo de perfil de negócio ou a Comunidade): programa_banidos/{uid}_{tipo},
    // sem data = para sempre; com `ate`, até essa data.
    function banidoDoPrograma(uid, tipo) {
      let b = /databases/$(database)/documents/programa_banidos/$(uid + '_' + tipo);
      return exists(b) && (get(b).data.get('ate', null) == null || get(b).data.ate > request.time);
    }

    // Campos que só podem ser alterados pelo painel/admin (Admin SDK ignora as regras).
    function camposProtegidos() {
      return ['verificado', 'avaliacaoMedia', 'totalAvaliacoes'];
    }

    function naoTocaCamposProtegidosNoCreate() {
      return !request.resource.data.keys().hasAny(camposProtegidos());
    }

    // No update também ficam travados plano/valorPlanoMensal/tipoUsuario:
    // são definidos no cadastro e nunca mudam pelo site.
    function naoTocaCamposProtegidosNoUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(camposProtegidos().concat(['plano', 'valorPlanoMensal', 'tipoUsuario']));
    }

    // Campo de texto opcional com tamanho máximo (evita documentos gigantes).
    // (Lê o campo uma vez só com get: gasta menos do limite de 1.000 expressões por gravação.)
    function textoAte(campo, max) {
      return valorTextoAte(request.resource.data.get(campo, null), max);
    }

    // Mesmo limite, para um valor qualquer (ex.: campo dentro de um mapa).
    function valorTextoAte(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // Enquete (publicação ou flash): pergunta (até 120) e 2 a 4 opções (até 40 cada).
    // No flash, x e y dizem onde a enquete fica na tela (0 a 1).
    // fimEm: quando a votação acaba (depois de inicio, até maxMin minutos depois; sem fimEm = enquete antiga, sem fim).
    function enqueteOk(e, inicio, maxMin) {
      return e is map && e.keys().hasOnly(['pergunta', 'opcoes', 'x', 'y', 'fimEm', 'anonima'])
          && (!('anonima' in e) || e.anonima is bool)
          && (!('fimEm' in e) || (e.fimEm is timestamp && e.fimEm > inicio && e.fimEm <= inicio + duration.value(maxMin, 'm')))
          && e.pergunta is string && e.pergunta.size() >= 1 && e.pergunta.size() <= 120
          // 2 a 4 opções de 1 a 40 letras, conferidas numa expressão só (opção não tem quebra de linha)
          && e.opcoes is list && e.opcoes.size() >= 2 && e.opcoes.size() <= 4
          && e.opcoes.join('\n').matches('^[^\n]{1,40}(\n[^\n]{1,40}){1,3}$')
          && (!('x' in e) || (e.x is number && e.x >= 0 && e.x <= 1))
          && (!('y' in e) || (e.y is number && e.y >= 0 && e.y <= 1));
    }
    // Caixa de perguntas (publicação ou flash): o autor pergunta e quem vê responde com texto.
    // anonima: quem responde não aparece para o autor (só a moderação sabe, em caixa_autoria).
    function caixaOk(c) {
      return c is map && c.keys().hasOnly(['pergunta', 'anonima', 'x', 'y'])
          && c.pergunta is string && c.pergunta.size() >= 1 && c.pergunta.size() <= 120
          && c.anonima is bool
          && (!('x' in c) || (c.x is number && c.x >= 0 && c.x <= 1))
          && (!('y' in c) || (c.y is number && c.y >= 0 && c.y <= 1));
    }
    // Flash: figurinha que leva ao perfil de um negócio (qualquer negócio que exista).
    function linkFlashOk(l) {
      return l is map && l.keys().hasOnly(['negocioId', 'nome', 'tipo', 'x', 'y'])
          && l.negocioId is string && l.negocioId.matches('^[A-Za-z0-9_-]{1,100}$')
          && exists(/databases/$(database)/documents/negocios/$(l.negocioId))
          && valorTextoAte(l.get('nome', ''), 80)
          && l.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis', 'saude']
          && (!('x' in l) || (l.x is number && l.x >= 0 && l.x <= 1))
          && (!('y' in l) || (l.y is number && l.y >= 0 && l.y <= 1));
    }
    // Flash repostado: só quem foi mencionado no flash original (que ainda existe) reposta.
    function repostOk(r) {
      let orig = /databases/$(database)/documents/stories/$(r.storyId);
      return r is map && r.keys().hasOnly(['storyId', 'autorId', 'nome'])
          && r.storyId is string && r.storyId.matches('^[A-Za-z0-9]{1,64}$')
          && exists(orig)
          && get(orig).data.autorId == r.autorId
          && get(orig).data.get('mencoes', []).hasAny([request.auth.uid])
          && valorTextoAte(r.get('nome', ''), 80);
    }
    // Flash nos perfis de negócio da própria pessoa (ids = uid_tipo, até 4) e se aparece também no perfil pessoal.
    function negociosFlashOk(d) {
      let n = '(' + request.auth.uid + '_(servicos|delivery|lojinha|imoveis|saude))';
      return (!('negocios' in d) || (d.negocios is list && d.negocios.size() >= 1 && d.negocios.size() <= 4
                                      && d.negocios.join(' ').matches('^' + n + '( ' + n + '){0,3}$')))
          && (!('perfil' in d) || (d.perfil is bool && (d.perfil || 'negocios' in d)));
    }
    // Publicação do Diário compartilhada no flash: a publicação existe, o autor confere e ele não desligou
    // "Permitir que compartilhem minhas publicações no Flash" (pref_publicas.permiteFlash; sem o documento, pode).
    function postFlashOk(r) {
      let orig = /databases/$(database)/documents/diario/$(r.postId);
      let pref = /databases/$(database)/documents/pref_publicas/$(r.autorId);
      return r is map && r.keys().hasOnly(['postId', 'autorId', 'nome'])
          && r.postId is string && r.postId.matches('^[A-Za-z0-9]{1,64}$')
          && r.autorId is string
          && exists(orig) && get(orig).data.autorId == r.autorId
          && (r.autorId == request.auth.uid || !exists(pref) || get(pref).data.get('permiteFlash', true) != false)
          && valorTextoAte(r.get('nome', ''), 80);
    }
    function extrasFlashOk(d) {
      return negociosFlashOk(d)
          && (!('caixa' in d) || caixaOk(d.caixa))
          && (!('link' in d) || linkFlashOk(d.link))
          && (!('repostDe' in d) || repostOk(d.repostDe))
          && (!('postDe' in d) || postFlashOk(d.postDe));
    }
    // Lista de uids (até max), conferida com uma expressão só.
    function uidsOk(l, max) {
      return l is list && l.size() <= max
          && (l.size() == 0 || l.join(' ').matches('^[A-Za-z0-9]{1,64}( [A-Za-z0-9]{1,64})*$'));
    }

    // Local para o Brasil todo: estado (UF) e código IBGE da cidade (7 dígitos; os dois
    // primeiros são o código do estado, então cidade e estado precisam combinar).
    // Feito com expressões regulares (uma tabela de 27 estados estourava o limite de
    // 1.000 expressões por gravação do Firestore).
    function localOk() {
      let d = request.resource.data;
      let uf = d.get('uf', null);
      let ibge = d.get('cidadeIbge', null);
      return (uf == null || uf == ''
              || (uf is string && uf.matches('^(AC|AL|AP|AM|BA|CE|DF|ES|GO|MA|MT|MS|MG|PA|PB|PR|PE|PI|RJ|RN|RS|RO|RR|SC|SP|SE|TO)$')))
          && (ibge == null
              || (ibge is int && uf is string
                  && (uf + string(ibge)).matches('^(RO11|AC12|AM13|RR14|PA15|AP16|TO17|MA21|PI22|CE23|RN24|PB25|PE26|AL27|SE28|BA29|MG31|ES32|RJ33|SP35|PR41|SC42|RS43|MS50|MT51|GO52|DF53)[0-9]{5}$')));
    }
    // Endereço detalhado opcional (negócios e anúncios): CEP com 8 números e textos curtos.
    function enderecoOk() {
      let cep = request.resource.data.get('cep', null);
      return (cep == null || cep == '' || (cep is string && cep.matches('^[0-9]{8}$')))
          && textoAte('bairro', 60)
          && textoAte('rua', 100)
          && textoAte('numero', 10)
          && textoAte('complemento', 60);
    }

    // Lista opcional com no máximo N itens.
    function listaAte(campo, max) {
      return listaValorAte(request.resource.data.get(campo, null), max);
    }
    function listaValorAte(v, max) {
      return v == null || (v is list && v.size() <= max);
    }

    // Foto só pode vir do próprio site: imagem dentro do documento (sem Storage),
    // Firebase Storage do projeto ou foto da conta Google. Bloqueia imagens de
    // sites de terceiros (rastreamento por IP, conteúdo impróprio).
    // Ponto do endereço (negócio ou anúncio) para "Perto de você": só lat/lng dentro do Brasil.
    function geoOk(g) {
      return g == null
          || (g is map && g.keys().hasOnly(['lat', 'lng'])
              && g.lat is number && g.lat >= -34 && g.lat <= 6
              && g.lng is number && g.lng >= -75 && g.lng <= -28);
    }
    function fotoOk(v) {
      return v == null || v == ''
          || (v is string && v.matches('^(data:image/(jpeg|png|webp);base64,|https://firebasestorage[.]googleapis[.]com/|https://lh3[.]googleusercontent[.]com/).*'));
    }

    function campoFotoOk(campo) {
      return !(campo in request.resource.data) || fotoOk(request.resource.data[campo]);
    }

    // Só os campos que mudaram (para não travar documentos antigos com campos a mais).
    function mudou() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Escondido pela equipe (moderação): o dono não pode mostrar de novo nem tirar a marca.
    function travaModeracao() {
      return !mudou().hasAny(['ocultoPelaEquipe'])
          && !(resource.data.get('ocultoPelaEquipe', false) == true && mudou().hasAny(['ocultoAte']));
    }

    // A equipe esconde/mostra: só ocultoAte e a marca ocultoPelaEquipe.
    function moderacaoOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ocultoAte', 'ocultoPelaEquipe'])
          && dataOuNulo('ocultoAte')
          && request.resource.data.get('ocultoPelaEquipe', false) is bool;
    }

    // Campos novos ou alterados (campos antigos removidos não contam).
    function gravou() {
      let d = request.resource.data.diff(resource.data);
      return d.addedKeys().union(d.changedKeys());
    }

    // Bloqueio: bloqueios/{quemBloqueou}_{quemFoiBloqueado}
    function bloqueou(a, b) {
      return exists(/databases/$(database)/documents/bloqueios/$(a + '_' + b));
    }

    function bloqueioEntre(a, b) {
      return bloqueou(a, b) || bloqueou(b, a);
    }

    // ---------- avaliações e reclamações justas ----------
    // Id da conversa / do vínculo entre duas pessoas (ids em ordem).
    function par(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Conta com pelo menos 3 dias (usuarios.criadoEm é gravado no cadastro e não muda).
    function contaAntiga(uid) {
      let u = /databases/$(database)/documents/usuarios/$(uid);
      return exists(u)
          && get(u).data.get('criadoEm', null) is timestamp
          && get(u).data.criadoEm < request.time - duration.value(3, 'd');
    }

    // Quem já escreveu na conversa entre a e b (conversas.falaram, cada um marca só o seu).
    function falou(a, b, quem) {
      let c = /databases/$(database)/documents/conversas/$(par(a, b));
      return exists(c) && get(c).data.get('falaram', {}).get(quem, false) == true;
    }

    // Conta desativada (ou com exclusão pedida): perfis_publicos.desativadaAte no futuro.
    function desativada(uid) {
      let p = /databases/$(database)/documents/perfis_publicos/$(uid);
      return exists(p)
          && get(p).data.get('desativadaAte', null) is timestamp
          && get(p).data.desativadaAte > request.time;
    }

    // Campo opcional de data (ex.: ocultoAte): ausente, nulo ou uma data.
    function dataOuNulo(campo) {
      return !(campo in request.resource.data)
          || request.resource.data[campo] == null
          || request.resource.data[campo] is timestamp;
    }

    // Quem da equipe assumiu um item: alguém da equipe (ou ninguém), com nome curto.
    function responsavelOk() {
      let r = request.resource.data.get('responsavel', null);
      return (r == null || (r is string && exists(/databases/$(database)/documents/admins/$(r))))
          && valorTextoAte(request.resource.data.get('responsavelNome', null), 80)
          && (!mudou().hasAny(['responsavel']) || request.resource.data.get('assumidoEm', null) == request.time);
    }

    // Anti-spam: cada mensagem, publicação ou comentário conta no limite diário da pessoa
    // (ritmo/{uid}, gravado junto na mesma operação).
    function ritmoOk(tipo) {
      let r = getAfter(/databases/$(database)/documents/ritmo/$(request.auth.uid)).data;
      return r.ultimaEm == request.time && r.ultimoTipo == tipo;
    }

    function donoDoNegocio(negocioId) {
      return get(/databases/$(database)/documents/negocios/$(negocioId)).data.donoId;
    }


    // =====================================================
    // DADOS PRIVADOS DOS USUÁRIOS
    // Cada usuário só pode acessar os próprios dados.
    // =====================================================
    match /usuarios/{userId} {

      allow read: if logado()
                  && request.auth.uid == userId;
      // Dados pessoais (e-mail, telefone, nascimento): na equipe, só dono e moderação (LGPD: o mínimo necessário).
      allow read: if podeModerar();
      // A equipe aprova ou recusa o selo de verificado.
      allow update: if podeModerar()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificado', 'solicitacaoVerificacao', 'verificacaoRespondidaEm'])
                    && seloLiberado(userId);

      // criadoEm é a data real do cadastro (conta antiga = pode avaliar/reclamar).
      allow create: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.aceiteTermos == true
                    && (!('criadoEm' in request.resource.data) || request.resource.data.criadoEm == request.time)
                    && naoTocaCamposProtegidosNoCreate();

      // criadoEm não muda depois de gravado (cadastro antigo sem a data só pode gravar a data de agora).
      allow update: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && (!mudou().hasAny(['criadoEm'])
                        || (!('criadoEm' in resource.data) && request.resource.data.criadoEm == request.time))
                    && naoTocaCamposProtegidosNoUpdate();

      allow delete: if logado()
                    && request.auth.uid == userId;
    }


    // =====================================================
    // PERFIL PÚBLICO
    // Usado somente para busca e exibição pública.
    // NÃO deve conter e-mail, telefone ou data de nascimento.
    // =====================================================
    match /perfis_publicos/{userId} {

      // O @ exibido no perfil precisa estar reservado em nicknames/ pelo
      // próprio usuário. getAfter enxerga a reserva feita na mesma transação
      // (cadastro) ou numa escrita anterior (edição do perfil).
      function nickDoDono() {
        let d = request.resource.data;
        return !('nickname' in d)
            || d.nickname == null
            || d.nickname == ''
            || getAfter(/databases/$(database)/documents/nicknames/$(d.nickname)).data.uid == request.auth.uid;
      }

      // Trocou de @: o antigo tem que ser liberado na mesma gravação (ninguém guarda vários @).
      function liberouNickAntigo() {
        let antigo = resource.data.get('nickname', '');
        return antigo == null || antigo == '' || antigo == request.resource.data.get('nickname', '')
            || !existsAfter(/databases/$(database)/documents/nicknames/$(antigo));
      }

      function tamanhosOk() {
        return textoAte('nome', 80)
            && textoAte('bio', 400)
            && textoAte('cidade', 80)
            && localOk()
            && listaAte('busca', 12)
            && dataOuNulo('desativadaAte');
      }

      // Campos que o site grava no perfil público. Qualquer outro é recusado.
      function camposPerfil() {
        return ['uid', 'nome', 'nickname', 'cidade', 'uf', 'cidadeIbge', 'bio', 'fotoPerfil', 'fotoCapa',
                'socialVisibilidade', 'duoCapa', 'ultimoAcesso', 'criadoEm', 'atualizadoEm',
                'busca',   // palavras do nome e do @ (minúsculas, sem acento) para a busca de pessoas
                'desativadaAte',   // conta desativada até esta data (ou exclusão pedida)
                'atendimento'];    // negócios: horário, modo ausente e tempo médio de resposta
      }

      function opcoesOk() {
        let d = request.resource.data;
        return (!('socialVisibilidade' in d) || d.socialVisibilidade in ['todos', 'seguidores', 'amigos', 'ocultar'])
            && (!('duoCapa' in d) || d.duoCapa in ['clicavel', 'foto', 'rosa', 'ocultar'])
            && (!('nickname' in d) || valorTextoAte(d.nickname, 20))
            && atendimentoOk();
      }

      // Faixa de horário "HH:MM-HH:MM" (00:00 a 23:59).
      function faixaOk(v) {
        return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$');
      }
      // Horário de cada dia da semana: lista com 7 textos, de domingo (0) a sábado (6),
      // "HH:MM-HH:MM" ou "" (fechado). Uma expressão regular só confere a lista toda
      // (uma por dia estourava o limite de 1.000 expressões por gravação).
      function semanaOk(s) {
        return s == null
            || (s is list && s.size() == 7
                && s.join(';').matches('^(([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9])?(;(([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9])?){6}$'));
      }

      // Atendimento (negócios): horário (resumo e por dia), pausa de almoço, aviso de
      // ausência com data de volta e tempo médio de resposta.
      function atendimentoOk() {
        let a = request.resource.data.get('atendimento', null);
        return a == null
            || (a is map
                && a.keys().hasOnly(['horario', 'semana', 'almoco', 'ausente', 'mensagem', 'volta', 'resposta'])
                && (!('semana' in a) || semanaOk(a.semana))
                && (!('almoco' in a) || a.almoco == null || faixaOk(a.almoco))
                && (!('volta' in a) || a.volta == null || a.volta is timestamp)
                && (!('ausente' in a) || a.ausente is bool)
                && (!('mensagem' in a) || (a.mensagem is string && a.mensagem.size() <= 200))
                && (!('horario' in a) || a.horario == null
                    || (a.horario is map && a.horario.keys().hasOnly(['dias', 'inicio', 'fim'])
                        && a.horario.dias is list && a.horario.dias.size() <= 7
                        && a.horario.inicio is string && a.horario.inicio.size() == 5
                        && a.horario.fim is string && a.horario.fim.size() == 5))
                && (!('resposta' in a)
                    || (a.resposta is map && a.resposta.keys().hasOnly(['media', 'n'])
                        && a.resposta.media is number && a.resposta.media >= 0 && a.resposta.media <= 1440
                        && a.resposta.n is int && a.resposta.n >= 0 && a.resposta.n <= 1000)));
      }

      // Foto nova precisa vir do próprio site (fotos antigas não travam a edição).
      function fotosOk() {
        return ((resource != null && !mudou().hasAny(['fotoPerfil'])) || campoFotoOk('fotoPerfil'))
            && ((resource != null && !mudou().hasAny(['fotoCapa'])) || campoFotoOk('fotoCapa'));
      }

      // Quem foi bloqueado não abre o perfil de quem bloqueou (a busca em lista continua
      // aberta a quem está logado, mas o perfil em si não carrega).
      allow get: if logado()
                 && (request.auth.uid == userId || !bloqueou(userId, request.auth.uid) || admin());
      allow list: if logado();
      // A equipe marca o selo e esconde contas suspensas/banidas.
      allow update: if podeModerar()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificado', 'desativadaAte'])
                    && dataOuNulo('desativadaAte')
                    // o selo público só acende se a conta já tem o selo (dado pelas regras de usuarios)
                    && (request.resource.data.get('verificado', false) != true
                        || get(/databases/$(database)/documents/usuarios/$(userId)).data.get('verificado', false) == true);

      allow create: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && naoTocaCamposProtegidosNoCreate()
                    && request.resource.data.keys().hasOnly(camposPerfil())
                    && nickDoDono()
                    && tamanhosOk()
                    && opcoesOk()
                    && fotosOk();

      allow update: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && naoTocaCamposProtegidosNoUpdate()
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname'])
                        || (nickDoDono() && liberouNickAntigo()))
                    && gravou().hasOnly(camposPerfil())
                    && (!mudou().hasAny(['desativadaAte']) || !sancionado(request.auth.uid))
                    && tamanhosOk()
                    && opcoesOk()
                    && fotosOk();

      allow delete: if logado()
                    && request.auth.uid == userId;
    }


    // =====================================================
    // RESERVA DE NICKNAMES
    // =====================================================
    match /nicknames/{nickname} {

      allow read: if true;

      // Só reserva o @ que o próprio perfil passa a usar na mesma gravação (sem guardar @ sobrando).
      allow create: if logado()
                    && request.auth.uid == request.resource.data.uid
                    && nickname.matches('^[a-z0-9._]{3,20}$')
                    && getAfter(/databases/$(database)/documents/perfis_publicos/$(request.auth.uid)).data.get('nickname', '') == nickname;

      allow update: if false;

      allow delete: if logado()
                    && request.auth.uid == resource.data.uid;
    }


    // =====================================================
    // SEGUIDORES
    // Documento: relacoes/{seguidorId}_{alvoId}
    // =====================================================
    match /relacoes/{id} {

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['tipo', 'seguidorId', 'alvoId', 'criadoEm'])
                    && request.resource.data.tipo == 'seguir'
                    && request.resource.data.seguidorId == request.auth.uid
                    && request.resource.data.alvoId is string
                    && request.resource.data.alvoId != request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.alvoId
                    && !bloqueioEntre(request.auth.uid, request.resource.data.alvoId);

      allow update: if false;

      // Quem segue pode deixar de seguir; quem é seguido pode remover o seguidor.
      allow delete: if logado()
                    && (resource.data.seguidorId == request.auth.uid
                        || resource.data.alvoId == request.auth.uid);
    }


    // =====================================================
    // BLOQUEIOS
    // Documento: bloqueios/{bloqueadorId}_{bloqueadoId}
    // =====================================================
    match /bloqueios/{id} {

      allow get: if logado()
                 && (id.split('_')[0] == request.auth.uid
                     || id.split('_')[1] == request.auth.uid);
      allow read: if admin();

      allow list: if logado()
                  && (resource.data.bloqueadorId == request.auth.uid
                      || resource.data.bloqueadoId == request.auth.uid);

      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['bloqueadorId', 'bloqueadoId', 'criadoEm'])
                    && request.resource.data.bloqueadorId == request.auth.uid
                    && request.resource.data.bloqueadoId is string
                    && request.resource.data.bloqueadoId != request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.bloqueadoId;

      allow update: if false;

      allow delete: if logado()
                    && resource.data.bloqueadorId == request.auth.uid;
    }


    // =====================================================
    // VÍNCULOS SOCIAIS (duo, família, amigos)
    // Documento: vinculos/{uidMenor}_{uidMaior}
    // =====================================================
    match /vinculos/{id} {

      function inversos() {
        return {
          'duo': 'duo', 'namoro': 'namoro', 'casamento': 'casamento',
          'melhor_amigo': 'melhor_amigo', 'amigo': 'amigo', 'irmao': 'irmao',
          'pai_mae': 'filho', 'filho': 'pai_mae', 'primo': 'primo',
          'tio': 'sobrinho', 'sobrinho': 'tio', 'avo': 'neto', 'neto': 'avo',
          'parceiro': 'parceiro'
        };
      }

      // Pedidos pendentes só são visíveis para os dois envolvidos.
      allow read: if logado()
                  && (resource.data.status == 'aceito'
                      || request.auth.uid in resource.data.participantes);
      allow read: if admin();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['participantes', 'de', 'para', 'tipoDe', 'tipoPara', 'status', 'criadoEm'])
                    && request.resource.data.de == request.auth.uid
                    && request.resource.data.para is string
                    && request.resource.data.para != request.auth.uid
                    && request.resource.data.participantes is list
                    && request.resource.data.participantes.size() == 2
                    && request.auth.uid in request.resource.data.participantes
                    && request.resource.data.para in request.resource.data.participantes
                    && request.resource.data.participantes[0] < request.resource.data.participantes[1]
                    && id == request.resource.data.participantes[0] + '_' + request.resource.data.participantes[1]
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.tipoDe in inversos()
                    && request.resource.data.tipoPara == inversos()[request.resource.data.tipoDe]
                    && !bloqueioEntre(request.auth.uid, request.resource.data.para);

      // Só quem recebeu o pedido pode aceitar, e só muda o status.
      allow update: if logado()
                    && resource.data.status == 'pendente'
                    && request.auth.uid == resource.data.para
                    && request.resource.data.status == 'aceito'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceitoEm']);

      // Qualquer um dos dois pode cancelar, recusar ou desfazer.
      allow delete: if logado()
                    && request.auth.uid in resource.data.participantes;
    }


    // =====================================================
    // PERFIS DE NEGÓCIO (serviços, delivery, lojinha, imóveis)
    // Documento: negocios/{donoId}_{tipo}
    // =====================================================
    match /negocios/{id} {

      // Campos que o site grava. Qualquer outro campo é recusado.
      function camposNegocio() {
        return ['donoId', 'tipo', 'nome', 'descricao', 'cidade', 'uf', 'cidadeIbge', 'bairro', 'rua', 'numero', 'complemento', 'cep',
                'whatsapp', 'foto', 'fotos', 'itens',
                'categoria', 'categorias', 'categoriaPersonalizada', 'criadoEm', 'atualizadoEm',
                'precoDesde', 'horario', 'atendimento', 'dias', 'regiao', 'experiencia', 'diferenciais', 'pagamentos', 'cnh', 'veiculo',
                'horaAbre', 'horaFecha', 'tempoMin', 'tempoMax', 'taxaEntrega', 'pedidoMinimo', 'opcoesEntrega',
                'entrega', 'tipoAnunciante', 'creci',
                'instagram', 'site', 'capa', 'cnpj', 'promocao', 'semana', 'geo',
                'saude',       // perfil de Saúde: profissão, registro no conselho, especialidades, convênios...
                'busca',       // palavras e começos de palavras para a busca nacional (busca.js), até 100
                'principal',   // sem plano, só o perfil deste tipo fica no ar (o dono escolhe; o site esconde os outros)
                'ocultoAte'];  // escondido enquanto a conta do dono estiver desativada
      }

      // Saúde: um mapa só, sempre com os 15 campos (o site grava todos), conferido com dois regex
      // (gasta pouco do limite de 1.000 expressões: a gravação de um negócio completo já chega perto).
      function saudeOk(s) {
        return s.keys().hasOnly(['profissao', 'profissaoOutra', 'especialidades', 'registro', 'registroUf', 'rqe', 'modalidades',
                                 'convenios', 'particular', 'valorConsulta', 'duracao', 'publico', 'idiomas', 'acessivel', 'formacao'])
            && [s.profissao, s.profissaoOutra, s.registro, s.registroUf, s.rqe, s.formacao, s.modalidades.join(','), s.publico.join(','),
                string(s.particular), string(s.acessivel), string(s.valorConsulta), string(s.duracao)].join('\n')
                 .matches('^(medico|enfermeiro|tecEnfermagem|psicologo|veterinario|dentista|fisioterapeuta|nutricionista|fonoaudiologo|terapeutaOcupacional|farmaceutico|educadorFisico|cuidador|outros)\n[^\n]{0,40}\n[0-9A-Za-z./ -]{0,20}\n([A-Z]{2})?\n[0-9A-Za-z./-]{0,12}\n[^\n]{0,200}\n((consultorio|online|domicilio)(,(consultorio|online|domicilio)){0,2})?\n([a-z]{3,14}(,[a-z]{3,14}){0,5})?\n(true|false)\n(true|false)\n(null|[0-9]{1,5}([.][0-9]{1,2})?)\n(null|[1-9][0-9]{0,2})$')
            && [s.especialidades.join('\n'), s.convenios.join('\n'), s.idiomas.join('\n')].join('\n').matches('^[^\n]{0,40}(\n[^\n]{0,40}){0,29}$');
      }

      // Promoção/cupom com prazo (até 62 dias): título, texto, código opcional (A-Z e 0-9).
      function promocaoOk(p) {
        return p is map
            && p.keys().hasOnly(['titulo', 'texto', 'codigo', 'ate'])
            && p.titulo is string && p.titulo.size() >= 3 && p.titulo.size() <= 60
            && valorTextoAte(p.get('texto', ''), 200)
            && (p.get('codigo', '') == '' || (p.codigo is string && p.codigo.matches('^[A-Z0-9]{3,20}$')))
            && p.ate is timestamp && p.ate < request.time + duration.value(62, 'd');
      }

      // Instagram (só o @, sem link), site (http/https, até 120) e CNPJ (14 números) num regex só;
      // capa (foto do site); horário de cada dia (7 textos "HH:MM-HH:MM" ou "", domingo a sábado) e promoção.
      // Só confere o que mudou: a gravação completa ficava perto do limite de 1.000 expressões.
      function extrasNegocioOk() {
        let d = request.resource.data;
        let m = resource == null ? d.keys() : mudou();
        return (!m.hasAny(['instagram', 'site', 'cnpj'])
                || [d.get('instagram', ''), d.get('site', ''), d.get('cnpj', '')].join('\n')
                     .matches('^[A-Za-z0-9._]{0,30}\n(https?://[^ \n]{3,112})?\n([0-9]{14})?$'))
            && (!m.hasAny(['capa']) || fotoOk(d.get('capa', null)))
            && (!m.hasAny(['semana']) || d.get('semana', null) == null
                || (d.semana is list && d.semana.size() == 7
                    && d.semana.join(';').matches('^(([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9])?(;(([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9])?){6}$')))
            && (!m.hasAny(['promocao']) || d.get('promocao', null) == null || promocaoOk(d.promocao))
            && (!m.hasAny(['geo']) || geoOk(d.get('geo', null)))
            && (!m.hasAny(['saude']) || saudeOk(d.get('saude', null)))
            && (!m.hasAny(['principal']) || d.get('principal', null) == null
                || d.principal in ['servicos', 'delivery', 'lojinha', 'imoveis', 'saude']);
      }

      function negocioOk() {
        return textoAte('nome', 80)
            && textoAte('descricao', 600)
            && textoAte('cidade', 60)
            && localOk()
            && enderecoOk()
            && textoAte('whatsapp', 20)
            && textoAte('regiao', 100)
            && textoAte('horario', 60)
            && textoAte('categoriaPersonalizada', 30)
            && listaAte('itens', 12)
            && listaAte('fotos', 5)
            && listaAte('busca', 100)
            && dataOuNulo('ocultoAte')
            && ((resource != null && !mudou().hasAny(['foto'])) || campoFotoOk('foto'))
            && extrasNegocioOk();
      }

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.donoId == request.auth.uid
                    && request.resource.data.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis', 'saude']
                    && id == request.auth.uid + '_' + request.resource.data.tipo
                    && request.resource.data.keys().hasOnly(camposNegocio())
                    && naoTocaCamposProtegidosNoCreate()
                    && !banidoDoPrograma(request.auth.uid, request.resource.data.tipo)
                    && contaVerificada()
                    && (request.resource.data.tipo != 'saude' || request.resource.data.get('saude', null) is map)
                    && negocioOk();

      allow update: if logado()
                    && emailOk()
                    && resource.data.donoId == request.auth.uid
                    && request.resource.data.donoId == resource.data.donoId
                    && request.resource.data.tipo == resource.data.tipo
                    && gravou().hasOnly(camposNegocio())
                    && naoTocaCamposProtegidosNoUpdate()
                    && travaModeracao()
                    && negocioOk();

      allow delete: if logado()
                    && resource.data.donoId == request.auth.uid;

      // A equipe esconde (ocultoAte) o conteúdo de contas suspensas/banidas.
      allow update: if podeModerar()
                    && moderacaoOk();
    }


    // =====================================================
    // ANÚNCIOS (vários imóveis por pessoa)
    // Documento: anuncios/{id}
    // =====================================================
    match /anuncios/{id} {

      function camposAnuncio() {
        return ['donoId', 'tipo', 'ativo', 'titulo', 'finalidade', 'categoria', 'preco', 'condominio', 'iptu',
                'quartos', 'suites', 'banheiros', 'vagas', 'area', 'andar', 'bairro', 'cidade', 'mobiliado',
                'uf', 'cidadeIbge', 'rua', 'numero', 'complemento', 'cep',
                'disponivel', 'hospedes', 'caracteristicas', 'condicoes', 'descricao', 'fotos', 'criadoEm', 'atualizadoEm',
                'categoriaPersonalizada',  // tipo escrito pela pessoa quando escolhe "Outro" (Chácara, Galpão...)
                'geo',                     // ponto do endereço (Perto de você)
                'busca',                   // palavras para a busca nacional (busca.js), até 100
                'ocultoAte'];
      }

      function anuncioOk() {
        return textoAte('titulo', 100)
            && textoAte('descricao', 1000)
            && textoAte('cidade', 60)
            && localOk()
            && enderecoOk()
            && textoAte('andar', 12)
            && textoAte('disponivel', 20)
            && textoAte('categoriaPersonalizada', 30)
            && geoOk(request.resource.data.get('geo', null))
            && listaAte('fotos', 5)
            && listaAte('busca', 100)
            && listaAte('caracteristicas', 20)
            && listaAte('condicoes', 12)
            && dataOuNulo('ocultoAte');
      }

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.donoId == request.auth.uid
                    && request.resource.data.tipo in ['imovel']
                    && request.resource.data.keys().hasOnly(camposAnuncio())
                    && naoTocaCamposProtegidosNoCreate()
                    && contaVerificada()
                    && anuncioOk();

      allow update: if logado()
                    && emailOk()
                    && resource.data.donoId == request.auth.uid
                    && request.resource.data.donoId == resource.data.donoId
                    && request.resource.data.tipo == resource.data.tipo
                    && gravou().hasOnly(camposAnuncio())
                    && naoTocaCamposProtegidosNoUpdate()
                    && travaModeracao()
                    && anuncioOk();

      allow delete: if logado()
                    && resource.data.donoId == request.auth.uid;

      // A equipe esconde (ocultoAte) o conteúdo de contas suspensas/banidas.
      allow update: if podeModerar()
                    && moderacaoOk();
    }


    // =====================================================
    // COMUNIDADE: doações, trocas, pedidos de ajuda, vagas em quarto compartilhado e achados e perdidos.
    // Documento: comunidade/{id}. É PROIBIDO vender ou cobrar: não aceita preço, "R$" nem "vendo/venda" no texto
    // (o quarto compartilhado só mostra a divisão das despesas, no campo próprio). Quem descumpre é banido do
    // programa (programa_banidos/{uid}_comunidade) e pode ter a conta suspensa.
    // =====================================================
    match /comunidade/{id} {
      function camposComunidade() {
        return ['donoId', 'categoria', 'tipoItem', 'titulo', 'descricao', 'fotos', 'estado', 'entrega', 'status',
                'bairro', 'cidade', 'uf', 'cidadeIbge', 'geo', 'quarto', 'achado', 'aceiteRegras', 'busca',
                'criadoEm', 'atualizadoEm', 'ocultoAte', 'ocultoPelaEquipe'];
      }
      // Vaga em quarto/moradia compartilhada: só a divisão das despesas entre moradores.
      function quartoOk(q) {
        return q is map
            && q.keys().hasOnly(['vaga', 'rateio', 'contasInclusas', 'mobiliado', 'vagas', 'para', 'disponivelEm', 'regras'])
            && q.get('vaga', 'quarto').matches('^(individual|compartilhado|republica)$')
            && (q.get('rateio', null) == null || (q.rateio is number && q.rateio >= 0 && q.rateio <= 5000))
            && q.get('contasInclusas', false) is bool && q.get('mobiliado', false) is bool
            && (q.get('vagas', null) == null || (q.vagas is int && q.vagas >= 1 && q.vagas <= 10))
            && [q.get('para', 'todos'), q.get('disponivelEm', ''), q.get('regras', '')].join('\n')
                 .matches('^(todos|mulheres|homens|lgbt)\n([0-9]{4}-[0-9]{2}-[0-9]{2})?\n[^\n]{0,300}$');
      }
      // Achados e perdidos: perdi / encontrei, onde e quando.
      function achadoOk(a) {
        return a is map && a.keys().hasOnly(['tipo', 'data', 'local'])
            && [a.get('tipo', ''), a.get('data', ''), a.get('local', '')].join('\n')
                 .matches('^(perdido|encontrado)\n([0-9]{4}-[0-9]{2}-[0-9]{2})?\n[^\n]{0,80}$');
      }
      function comunidadeOk() {
        let d = request.resource.data;
        let texto = d.get('titulo', '') + ' ' + d.get('descricao', '');
        return d.categoria in ['doacao', 'troca', 'pedido', 'quarto', 'achados']
            && d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 80
            && textoAte('descricao', 1000)
            && textoAte('tipoItem', 20)
            && textoAte('cidade', 60)
            && localOk()
            && textoAte('bairro', 60)
            && geoOk(d.get('geo', null))
            && listaAte('fotos', 4)
            && listaAte('busca', 100)
            && d.get('estado', 'usado') in ['novo', 'seminovo', 'usado', 'reparo']
            && d.get('entrega', 'combinar') in ['combinar', 'retirar', 'entrego']
            && d.status in ['disponivel', 'reservado', 'concluido']
            && d.aceiteRegras == true
            && (d.categoria == 'quarto' ? quartoOk(d.get('quarto', null)) : !('quarto' in d))
            && (d.categoria == 'achados' ? achadoOk(d.get('achado', null)) : !('achado' in d))
            // Sem venda: nada de "vendo/venda/vende..." e, fora do quarto, nada de "R$".
            && !texto.matches('(?i)(?s).*\\b(vendo|venda|vende|vender|vendem|vendas)\\b.*')
            && (d.categoria == 'quarto' || !texto.matches('(?s).*[Rr][$].*'))
            && dataOuNulo('ocultoAte');
      }
      allow read: if logado();
      allow create: if logado() && emailOk()
                    && request.resource.data.donoId == request.auth.uid
                    && request.resource.data.keys().hasOnly(camposComunidade())
                    && !('ocultoPelaEquipe' in request.resource.data)
                    && !banidoDoPrograma(request.auth.uid, 'comunidade')
                    && !sancionado(request.auth.uid)
                    && request.resource.data.criadoEm == request.time
                    && comunidadeOk();
      allow update: if logado() && emailOk()
                    && resource.data.donoId == request.auth.uid
                    && request.resource.data.donoId == resource.data.donoId
                    && request.resource.data.criadoEm == resource.data.criadoEm
                    && gravou().hasOnly(camposComunidade())
                    && travaModeracao()
                    && !banidoDoPrograma(request.auth.uid, 'comunidade')
                    && comunidadeOk();
      allow delete: if logado() && (resource.data.donoId == request.auth.uid || podeModerar());
      // A equipe esconde (anúncio com venda, golpe, conta suspensa).
      allow update: if podeModerar() && moderacaoOk();
    }

    // Banimento de um programa (um tipo de perfil de negócio ou a Comunidade). Só a moderação cria/apaga;
    // a pessoa lê o próprio (para ver o motivo e até quando).
    match /programa_banidos/{id} {
      allow get: if logado() && (id.split('_')[0] == request.auth.uid || admin());
      allow list: if admin();
      allow create, update: if podeModerar()
                    && request.resource.data.keys().hasOnly(['uid', 'tipo', 'motivo', 'ate', 'por', 'em'])
                    && request.resource.data.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis', 'saude', 'comunidade']
                    && id == request.resource.data.uid + '_' + request.resource.data.tipo
                    && request.resource.data.motivo is string && request.resource.data.motivo.size() >= 3 && request.resource.data.motivo.size() <= 300
                    && (request.resource.data.get('ate', null) == null || request.resource.data.ate is timestamp)
                    && request.resource.data.por == request.auth.uid
                    && request.resource.data.em == request.time;
      allow delete: if podeModerar();
    }

    // =====================================================
    // CONVERSAS
    // Documento: conversas/{uidMenor}_{uidMaior}
    // =====================================================
    // =====================================================
    // NOTAS DO NEGÓCIO SOBRE O CLIENTE: notas_clientes/{donoId}_{clienteId}
    // Etiquetas e anotação particular. Só quem escreveu lê; o cliente não vê.
    // =====================================================
    match /notas_clientes/{id} {
      allow get: if logado() && id.split('_')[0] == request.auth.uid;
      allow list: if logado() && resource.data.donoId == request.auth.uid;
      allow create, update: if logado()
                    && request.resource.data.keys().hasOnly(['donoId', 'clienteId', 'etiquetas', 'nota', 'atualizadoEm'])
                    && request.resource.data.donoId == request.auth.uid
                    && request.resource.data.clienteId is string
                    && id == request.auth.uid + '_' + request.resource.data.clienteId
                    && request.resource.data.etiquetas is list && request.resource.data.etiquetas.size() <= 8
                    && valorTextoAte(request.resource.data.get('nota', ''), 1000)
                    && request.resource.data.atualizadoEm == request.time;
      allow delete: if logado() && resource.data.donoId == request.auth.uid;
    }

    // Ligações de voz e vídeo (chamadas.js): só entre as duas pessoas de uma conversa que já existe (do site ou do chat
    // da equipe) e sem bloqueio.
    // A chamada guarda a "campainha" (oferta/resposta do WebRTC) e o resultado; áudio e vídeo nunca passam por aqui.
    match /chamadas/{id} {
      function daChamada() { return logado() && (request.auth.uid == resource.data.de || request.auth.uid == resource.data.para); }
      function sdpOk(x) { return x is map && x.keys().hasOnly(['type', 'sdp']) && x.type is string && x.sdp is string && x.sdp.size() <= 30000; }
      allow get, list: if daChamada();
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['de', 'para', 'conv', 'tipo', 'status', 'oferta', 'criadoEm'])
                    && request.resource.data.de == request.auth.uid
                    && request.resource.data.para is string && request.resource.data.para != request.auth.uid
                    && request.resource.data.conv == (request.auth.uid < request.resource.data.para
                         ? request.auth.uid + '_' + request.resource.data.para : request.resource.data.para + '_' + request.auth.uid)
                    // conversa do site ou conversa individual do chat da equipe (equipe_dm)
                    && (exists(/databases/$(database)/documents/conversas/$(request.resource.data.conv))
                        || exists(/databases/$(database)/documents/equipe_dm/$(request.resource.data.conv)))
                    && !bloqueioEntre(request.auth.uid, request.resource.data.para)
                    && request.resource.data.tipo in ['audio', 'video']
                    && request.resource.data.status == 'chamando'
                    && sdpOk(request.resource.data.oferta)
                    && request.resource.data.criadoEm == request.time;
      // Quem recebe atende (com a resposta) enquanto toca.
      allow update: if daChamada() && request.auth.uid == resource.data.para
                    && resource.data.status == 'chamando'
                    && mudou().hasOnly(['status', 'resposta', 'aceitaEm'])
                    && request.resource.data.status == 'aceita'
                    && sdpOk(request.resource.data.resposta)
                    && request.resource.data.aceitaEm == request.time;
      // Qualquer um dos dois termina: recusar, cancelar, perder (não atendeu) ou encerrar.
      allow update: if daChamada()
                    && resource.data.status in ['chamando', 'aceita']
                    && mudou().hasOnly(['status', 'fimEm', 'encerradaPor'])
                    && request.resource.data.status in ['recusada', 'cancelada', 'perdida', 'encerrada']
                    && request.resource.data.encerradaPor == request.auth.uid
                    && request.resource.data.fimEm == request.time;
      allow delete: if false;
      match /candidatos/{c} {
        function chamada() { return get(/databases/$(database)/documents/chamadas/$(id)).data; }
        allow read: if logado() && request.auth.uid in [chamada().de, chamada().para];
        allow create: if logado() && request.auth.uid in [chamada().de, chamada().para]
                      && chamada().status in ['chamando', 'aceita']
                      && request.resource.data.keys().hasOnly(['de', 'c', 'em'])
                      && request.resource.data.de == request.auth.uid
                      && request.resource.data.c is map && request.resource.data.c.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex'])
                      && request.resource.data.c.candidate is string && request.resource.data.c.candidate.size() <= 1000
                      && request.resource.data.em == request.time;
        allow update, delete: if false;
      }
    }

    match /conversas/{conversaId} {

      // Cada pessoa só mexe na própria marca de leitura / "digitando".
      function soMinhaChave(campo) {
        return !mudou().hasAny([campo])
            || (request.resource.data[campo] is map
                && request.resource.data[campo].diff(resource.data.get(campo, {})).affectedKeys().hasOnly([request.auth.uid]));
      }

      function contextoOk() {
        let c = request.resource.data.get('contexto', null);
        return c == null
            || (c is map && c.keys().hasOnly(['tipo', 'titulo'])
                && c.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis', 'saude', 'comunidade']
                && valorTextoAte(c.get('titulo', ''), 120));
      }

      // Conversa ainda não criada: só quem faz parte dela (o id tem os dois uids) pode consultar.
      allow get: if logado()
                 && ((resource == null && request.auth.uid in conversaId.split('_'))
                     || (resource != null && request.auth.uid in resource.data.participantes));

      allow list: if logado()
                  && request.auth.uid in resource.data.participantes;
      // A moderação vê quem conversa com quem (para a ficha e denúncias), mas não lista mensagens.
      allow read: if podeModerar();

      allow create: if logado()
                    && request.resource.data.participantes is list
                    && request.resource.data.participantes.size() == 2
                    && request.auth.uid in request.resource.data.participantes
                    && request.resource.data.participantes[0] < request.resource.data.participantes[1]
                    && conversaId == request.resource.data.participantes[0]
                                     + '_' + request.resource.data.participantes[1]
                    && !bloqueioEntre(request.resource.data.participantes[0],
                                      request.resource.data.participantes[1])
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['participantes', 'ultimaMensagem', 'atualizadoEm', 'contexto', 'criadoEm'])
                    && contextoOk()
                    && textoAte('ultimaMensagem', 200);

      // Com bloqueio entre os dois, ninguém mexe na conversa (evita "recado"
      // pelo resumo da última mensagem).
      allow update: if logado()
                    && request.auth.uid in resource.data.participantes
                    && request.resource.data.participantes == resource.data.participantes
                    && !bloqueioEntre(resource.data.participantes[0], resource.data.participantes[1])
                    && mudou().hasOnly(['ultimaMensagem', 'ultimaMensagemRemetenteId', 'atualizadoEm', 'lidoEm', 'vistoEm', 'digitando', 'contexto', 'arquivadaPara', 'ocultaPara', 'falaram', 'fixadaPara', 'silenciadaPara', 'mensagemFixada'])
                    // o resumo da última mensagem só pode ser escrito por quem mandou
                    && (!mudou().hasAny(['ultimaMensagem', 'ultimaMensagemRemetenteId'])
                        || request.resource.data.get('ultimaMensagemRemetenteId', '') == request.auth.uid)
                    && soMinhaChave('lidoEm')
                    && soMinhaChave('vistoEm')
                    && soMinhaChave('digitando')
                    // arquivar / apagar "só para mim": cada um mexe só na própria marca
                    && soMinhaChave('arquivadaPara')
                    && soMinhaChave('ocultaPara')
                    // fixar no topo / silenciar avisos: cada um só a própria marca
                    && soMinhaChave('fixadaPara')
                    && soMinhaChave('silenciadaPara')
                    // falaram: cada um marca só que ELE escreveu (usado para liberar avaliação e reclamação)
                    && soMinhaChave('falaram')
                    && (!mudou().hasAny(['falaram']) || request.resource.data.falaram[request.auth.uid] == true)
                    && (!mudou().hasAny(['contexto']) || contextoOk())
                    // mensagem fixada no topo da conversa (qualquer um dos dois fixa ou tira)
                    && (!mudou().hasAny(['mensagemFixada'])
                        || request.resource.data.mensagemFixada == null
                        || (request.resource.data.mensagemFixada is map
                            && request.resource.data.mensagemFixada.keys().hasOnly(['id', 'texto', 'por', 'em'])
                            && request.resource.data.mensagemFixada.id is string
                            && request.resource.data.mensagemFixada.por == request.auth.uid
                            && valorTextoAte(request.resource.data.mensagemFixada.get('texto', ''), 200)))
                    && textoAte('ultimaMensagem', 200);

      allow delete: if logado()
                    && request.auth.uid in resource.data.participantes;


      // ===================================================
      // MENSAGENS DA CONVERSA
      // ===================================================
      match /mensagens/{mensagemId} {

        function participante() {
          return request.auth.uid in
                 get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
        }

        function semBloqueio() {
          let p = get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
          return !bloqueioEntre(p[0], p[1]);
        }

        // A outra pessoa da conversa não pode estar com a conta desativada.
        function outroAtivo() {
          let p = get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
          return !desativada(p[0] == request.auth.uid ? p[1] : p[0]);
        }

        // Resposta (citação): precisa apontar para uma mensagem real desta conversa,
        // com o autor verdadeiro. Impede citar algo que a outra pessoa nunca disse.
        function respostaOk(r) {
          let caminho = /databases/$(database)/documents/conversas/$(conversaId)/mensagens/$(r.id);
          return r is map
              && r.keys().hasOnly(['id', 'texto', 'remetenteId'])
              && r.id is string
              && valorTextoAte(r.get('texto', ''), 200)
              && exists(caminho)
              && get(caminho).data.remetenteId == r.remetenteId;
        }

        function mensagemOk() {
          let d = request.resource.data;
          return d.keys().hasOnly(['remetenteId', 'texto', 'criadoEm', 'resposta', 'tipoArquivo', 'arquivoUrl', 'nomeArquivo', 'cartao', 'avaliacao'])
              && (!('tipoArquivo' in d) || d.tipoArquivo in ['imagem', 'video', 'audio', 'cartao', 'avaliacao'])
              // pedido de avaliação: aponta para um atendimento criado por quem envia
              && (!('avaliacao' in d)
                  || (d.avaliacao is map && d.get('tipoArquivo', '') == 'avaliacao'
                      && d.avaliacao.keys().hasOnly(['pedidoId', 'titulo', 'tipo', 'negocioNome'])
                      && get(/databases/$(database)/documents/pedidos/$(d.avaliacao.pedidoId)).data.vendedorId == request.auth.uid
                      && valorTextoAte(d.avaliacao.get('titulo', ''), 120)
                      && valorTextoAte(d.avaliacao.get('negocioNome', ''), 80)))
              // anexo: só do próprio site (dentro da mensagem ou Firebase Storage)
              && (!('arquivoUrl' in d)
                  || (d.arquivoUrl is string
                      && d.arquivoUrl.matches('^(data:(image|video|audio)/[^,]{1,80},|https://firebasestorage[.]googleapis[.]com/).*')))
              && (!('nomeArquivo' in d) || valorTextoAte(d.nomeArquivo, 120))
              && (!('cartao' in d) || (d.cartao is map && d.get('tipoArquivo', '') == 'cartao'))
              && (!('resposta' in d) || respostaOk(d.resposta));
        }

        // Versão anterior guardada ao editar: o texto e a hora que ele tinha (envio ou última edição).
        function versaoOk(v) {
          return v is map && v.keys().hasOnly(['texto', 'em'])
              && v.texto == resource.data.get('texto', '')
              && v.em == resource.data.get('editadaEm', resource.data.criadoEm);
        }

        allow read: if logado() && participante();
        // A moderação abre só a mensagem denunciada (uma por vez, sem listar a conversa).
        allow get: if podeModerar();

        allow create: if logado()
                      && emailOk()
                      && participante()
                      && semBloqueio()
                      && outroAtivo()
                      && ritmoOk('msg')
                      && request.resource.data.remetenteId == request.auth.uid
                      && request.resource.data.criadoEm == request.time
                      && textoAte('texto', 4000)
                      && mensagemOk();

        // Editar (só quem enviou): o texto novo e, na lista "edicoes", a versão anterior (quem
        // conversa pode ver o original). Cartões de pedido/avaliação e mensagens apagadas não se editam.
        // Editar e apagar só até 10 minutos depois de enviar.
        function noPrazoDeMexer() { return request.time < resource.data.criadoEm + duration.value(10, 'm'); }

        allow update: if logado()
                      && request.auth.uid == resource.data.remetenteId
                      && noPrazoDeMexer()
                      && !('apagada' in resource.data)
                      && resource.data.get('tipoArquivo', '') in ['', 'imagem', 'video', 'audio']
                      && mudou().hasOnly(['texto', 'editadaEm', 'edicoes'])
                      && request.resource.data.texto is string && request.resource.data.texto.size() <= 4000
                      && (request.resource.data.texto.size() > 0 || 'arquivoUrl' in resource.data)
                      && request.resource.data.editadaEm == request.time
                      && request.resource.data.edicoes is list
                      && request.resource.data.edicoes.size() == resource.data.get('edicoes', []).size() + 1
                      && request.resource.data.edicoes.size() <= 20
                      // as versões antigas ficam como estavam; a nova é o texto de antes, com a hora dele
                      && request.resource.data.edicoes == resource.data.get('edicoes', []).concat([request.resource.data.edicoes[resource.data.get('edicoes', []).size()]])
                      && versaoOk(request.resource.data.edicoes[resource.data.get('edicoes', []).size()]);

        // Apagar para todos (só quem enviou): no lugar fica "apagou esta mensagem"; o conteúdo vai,
        // na mesma gravação, para apagadas/{id}, que os dois ainda podem abrir por 24 horas.
        allow update: if logado()
                      && request.auth.uid == resource.data.remetenteId
                      && noPrazoDeMexer()
                      && !('apagada' in resource.data)
                      && request.resource.data.keys().hasOnly(['remetenteId', 'criadoEm', 'apagada'])
                      && request.resource.data.remetenteId == resource.data.remetenteId
                      && request.resource.data.criadoEm == resource.data.criadoEm
                      && request.resource.data.apagada is map
                      && request.resource.data.apagada.keys().hasOnly(['por', 'em'])
                      && request.resource.data.apagada.por == request.auth.uid
                      && request.resource.data.apagada.em == request.time
                      && existsAfter(/databases/$(database)/documents/conversas/$(conversaId)/apagadas/$(mensagemId));

        allow delete: if logado()
                      && request.auth.uid == resource.data.remetenteId
                      && noPrazoDeMexer();
      }

      // ===================================================
      // CONTEÚDO DE MENSAGEM APAGADA PARA TODOS: conversas/{c}/apagadas/{idDaMensagem}
      // Os dois da conversa abrem por 24 horas ("Ver mensagem apagada", e dá para denunciar);
      // depois as regras não deixam mais ler e qualquer um dos dois apaga de vez.
      // A moderação abre enquanto existir (denúncias).
      // ===================================================
      match /apagadas/{mensagemId} {
        function daConversa() {
          return request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
        }
        function original() {
          return get(/databases/$(database)/documents/conversas/$(conversaId)/mensagens/$(mensagemId)).data;
        }
        function noPrazo() { return request.time < resource.data.apagadaEm + duration.value(24, 'h'); }
        allow get: if logado() && daConversa() && noPrazo();
        allow get: if podeModerar();
        allow create: if logado()
                      && request.resource.data.keys().hasOnly(['remetenteId', 'conteudo', 'apagadaEm'])
                      && request.resource.data.remetenteId == request.auth.uid
                      && original().remetenteId == request.auth.uid
                      && getAfter(/databases/$(database)/documents/conversas/$(conversaId)/mensagens/$(mensagemId)).data.apagada.por == request.auth.uid
                      && request.resource.data.apagadaEm == request.time
                      && request.resource.data.conteudo is map
                      && request.resource.data.conteudo.keys().hasOnly(['texto', 'tipoArquivo', 'arquivoUrl', 'nomeArquivo', 'cartao', 'avaliacao', 'resposta', 'edicoes'])
                      // o conteúdo guardado é o da mensagem de verdade (não dá para inventar outro)
                      && request.resource.data.conteudo.get('texto', '') == original().get('texto', '')
                      && request.resource.data.conteudo.get('tipoArquivo', '') == original().get('tipoArquivo', '')
                      && request.resource.data.conteudo.get('arquivoUrl', '') == original().get('arquivoUrl', '');
        // Quem recebeu e denunciou (dentro das 24 horas) marca "denunciada": aí só a moderação apaga.
        allow update: if logado() && daConversa() && noPrazo()
                      && request.auth.uid != resource.data.remetenteId
                      && mudou().hasOnly(['denunciada'])
                      && request.resource.data.denunciada == true;
        // Denunciada (pela marca ou porque existe a denúncia, mesmo feita antes de apagar): fica para a moderação.
        function temDenuncia() {
          let p = get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
          let quemRecebeu = p[0] == resource.data.remetenteId ? p[1] : p[0];
          return exists(/databases/$(database)/documents/denuncias/$('mensagem_' + mensagemId + '_' + quemRecebeu));
        }
        allow delete: if logado() && daConversa() && !noPrazo() && resource.data.get('denunciada', false) != true && !temDenuncia();
        allow delete: if podeModerar();
      }
    }


    // =====================================================
    // PEDIDOS / ATENDIMENTOS
    // O negócio registra o atendimento para pedir avaliação ao cliente.
    // Só vale entre pessoas que já conversam no chat.
    // =====================================================
    match /pedidos/{id} {

      allow read: if logado()
                  && (resource.data.vendedorId == request.auth.uid
                      || resource.data.clienteId == request.auth.uid);
      allow read: if admin();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['vendedorId', 'clienteId', 'negocioId', 'tipo', 'titulo', 'conversaId', 'criadoEm'])
                    && request.resource.data.vendedorId == request.auth.uid
                    && request.resource.data.clienteId is string
                    && request.resource.data.clienteId != request.auth.uid
                    && request.resource.data.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis', 'saude']
                    && request.resource.data.negocioId == request.auth.uid + '_' + request.resource.data.tipo
                    && exists(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId))
                    && request.auth.uid in get(/databases/$(database)/documents/conversas/$(request.resource.data.conversaId)).data.participantes
                    && request.resource.data.clienteId in get(/databases/$(database)/documents/conversas/$(request.resource.data.conversaId)).data.participantes
                    && valorTextoAte(request.resource.data.get('titulo', ''), 120)
                    && request.resource.data.criadoEm == request.time
                    && !bloqueioEntre(request.auth.uid, request.resource.data.clienteId);

      allow update, delete: if false;
    }


    // =====================================================
    // AVALIAÇÕES
    //   n_{negocio}_{cliente}: cliente avalia o negócio — UMA por cliente em cada negócio
    //   c_{negocio}_{cliente}: negócio avalia o cliente — UMA por cliente em cada negócio
    //   d_{post}_{uid}       : alguém avalia uma publicação (1 vez por publicação)
    //   p_{pedido}_c / _v    : modelo antigo (1 por pedido). Continuam valendo, mas não
    //                          podem mais ser criados: pedir avaliação várias vezes para a
    //                          mesma pessoa não gera notas extras.
    // Para avaliar um negócio: e-mail confirmado, conta com 3 dias, os dois já escreveram
    // na conversa, não é o dono e sem bloqueio. Quem tem vínculo aceito no Social (amigos,
    // família...) também avalia: continua valendo uma avaliação por pessoa em cada negócio.
    // n_ e c_ podem ser EDITADAS pelo autor (troca a nota no resumo, sem contar de novo).
    // =====================================================
    match /avaliacoes/{id} {

      function base() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tipo', 'autorId', 'autorNome', 'autorFoto', 'alvoId', 'negocioId', 'pedidoId', 'postId', 'nota', 'comentario', 'chaves', 'criadoEm'])
            && d.autorId == request.auth.uid
            && d.nota is int && d.nota >= 1 && d.nota <= 5
            && valorTextoAte(d.get('comentario', ''), 500)
            && valorTextoAte(d.get('autorNome', ''), 80)
            && fotoOk(d.get('autorFoto', ''))
            && d.criadoEm == request.time;
      }

      function resumoAtualizado(chave) {
        return getAfter(/databases/$(database)/documents/notas/$(chave)).data.ultima == id;
      }

      // "Atendimento confirmado": pedido real entre os dois, do mesmo negócio.
      function pedidoOk(d, cliente, negocioId) {
        return !('pedidoId' in d)
            || (get(/databases/$(database)/documents/pedidos/$(d.pedidoId)).data.clienteId == cliente
                && get(/databases/$(database)/documents/pedidos/$(d.pedidoId)).data.negocioId == negocioId);
      }

      function doCliente() {
        let d = request.resource.data;
        let dono = donoDoNegocio(d.negocioId);
        let eu = request.auth.uid;
        return id == 'n_' + d.negocioId + '_' + eu
            && d.alvoId == dono
            && dono != eu
            && d.chaves == ['neg_' + d.negocioId]
            && contaAntiga(eu)
            && falou(eu, dono, eu)
            && falou(eu, dono, dono)
            && !bloqueioEntre(eu, dono)
            && pedidoOk(d, eu, d.negocioId)
            && resumoAtualizado('neg_' + d.negocioId);
      }

      function doVendedor() {
        let d = request.resource.data;
        let eu = request.auth.uid;
        return id == 'c_' + d.negocioId + '_' + d.alvoId
            && donoDoNegocio(d.negocioId) == eu
            && d.alvoId != eu
            && d.chaves == ['cli_' + d.alvoId]
            && falou(eu, d.alvoId, eu)
            && falou(eu, d.alvoId, d.alvoId)
            && !bloqueioEntre(eu, d.alvoId)
            && pedidoOk(d, d.alvoId, d.negocioId)
            && resumoAtualizado('cli_' + d.alvoId);
      }

      function daPublicacao() {
        let d = request.resource.data;
        let post = get(/databases/$(database)/documents/diario/$(d.postId)).data;
        return id == 'd_' + d.postId + '_' + request.auth.uid
            && post.autorId != request.auth.uid
            && d.alvoId == post.autorId
            && d.chaves == ['post_' + d.postId, 'pub_' + post.autorId]
            && resumoAtualizado('post_' + d.postId)
            && resumoAtualizado('pub_' + post.autorId);
      }

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && base()
                    && ((request.resource.data.tipo == 'negocio' && doCliente())
                        || (request.resource.data.tipo == 'cliente' && doVendedor())
                        || (request.resource.data.tipo == 'publicacao' && daPublicacao()));

      // Edição de n_ / c_ pelo próprio autor: só nota, comentário e (uma vez) o pedido confirmado.
      allow update: if logado()
                    && emailOk()
                    && resource.data.autorId == request.auth.uid
                    && (id.matches('^n_.*') || id.matches('^c_.*'))
                    && mudou().hasOnly(['nota', 'comentario', 'atualizadoEm', 'pedidoId'])
                    && request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
                    && valorTextoAte(request.resource.data.get('comentario', ''), 500)
                    && request.resource.data.atualizadoEm == request.time
                    && (!mudou().hasAny(['pedidoId'])
                        || (!('pedidoId' in resource.data)
                            && pedidoOk(request.resource.data, id.matches('^n_.*') ? request.auth.uid : resource.data.alvoId, resource.data.negocioId)))
                    && !bloqueioEntre(request.auth.uid, resource.data.alvoId)
                    // nota mudou: o resumo precisa trocar a nota antiga pela nova NESTA mesma gravação
                    && (request.resource.data.nota == resource.data.nota
                        || (getAfter(/databases/$(database)/documents/notas/$(resource.data.chaves[0])).data.ultima == id
                            && getAfter(/databases/$(database)/documents/notas/$(resource.data.chaves[0])).data.soma
                               == get(/databases/$(database)/documents/notas/$(resource.data.chaves[0])).data.soma
                                  - resource.data.nota + request.resource.data.nota));

      allow delete: if false;
    }


    // =====================================================
    // RESUMO DAS NOTAS (média e quantas de cada estrela)
    //   neg_{negocioId} · cli_{uid} · pub_{uid} · post_{postId}
    // Só aceita somar exatamente a avaliação nova gravada junto.
    // =====================================================
    match /notas/{chave} {

      function caminhoNova() {
        return /databases/$(database)/documents/avaliacoes/$(request.resource.data.ultima);
      }

      function avaliacaoNova() {
        return request.resource.data.ultima is string
            && !exists(caminhoNova())
            && existsAfter(caminhoNova())
            && getAfter(caminhoNova()).data.autorId == request.auth.uid
            && chave in getAfter(caminhoNova()).data.chaves;
      }

      function estrela() {
        return 'n' + string(getAfter(caminhoNova()).data.nota);
      }

      allow read: if logado();

      allow create: if logado()
                    && avaliacaoNova()
                    && request.resource.data.keys().hasOnly(['total', 'soma', 'n1', 'n2', 'n3', 'n4', 'n5', 'ultima', 'atualizadoEm'])
                    && request.resource.data.keys().hasAll(['total', 'soma', 'n1', 'n2', 'n3', 'n4', 'n5', 'ultima'])
                    && request.resource.data.total == 1
                    && request.resource.data.soma == getAfter(caminhoNova()).data.nota
                    && request.resource.data[estrela()] == 1
                    && request.resource.data.n1 + request.resource.data.n2 + request.resource.data.n3
                       + request.resource.data.n4 + request.resource.data.n5 == 1;

      allow update: if logado()
                    && avaliacaoNova()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'soma', 'ultima', 'atualizadoEm', estrela()])
                    && request.resource.data.total == resource.data.total + 1
                    && request.resource.data.soma == resource.data.soma + getAfter(caminhoNova()).data.nota
                    && request.resource.data[estrela()] == resource.data.get(estrela(), 0) + 1;

      // Edição de uma avaliação n_/c_: troca a nota antiga pela nova (o total não muda).
      function edicao() {
        let antes = get(caminhoNova()).data;
        let depois = getAfter(caminhoNova()).data;
        return request.resource.data.ultima is string
            && exists(caminhoNova())
            && depois.autorId == request.auth.uid
            && chave in depois.chaves
            && antes.nota != depois.nota
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soma', 'ultima', 'atualizadoEm', 'n' + string(antes.nota), 'n' + string(depois.nota)])
            && request.resource.data.total == resource.data.total
            && request.resource.data.soma == resource.data.soma - antes.nota + depois.nota
            && resource.data.get('n' + string(antes.nota), 0) >= 1
            && request.resource.data['n' + string(antes.nota)] == resource.data.get('n' + string(antes.nota), 0) - 1
            && request.resource.data['n' + string(depois.nota)] == resource.data.get('n' + string(depois.nota), 0) + 1;
      }

      allow update: if logado() && edicao();

      allow delete: if false;
    }


    // =====================================================
    // RECLAMAÇÕES: resposta pública do negócio
    // Reclamação = avaliação de negócio com nota 1 ou 2 (avaliacoes/{id}).
    // reclamacoes/{id da avaliação}: o negócio avaliado responde uma vez
    // (pode editar o texto) e o cliente que reclamou marca como resolvida.
    // =====================================================
    match /reclamacoes/{avalId} {

      allow read: if logado();

      function aval() {
        return get(/databases/$(database)/documents/avaliacoes/$(avalId)).data;
      }

      function respostaOk(d) {
        return d.texto is string && d.texto.size() >= 2 && d.texto.size() <= 1000;
      }

      allow create: if logado()
                    && emailOk()
                    && exists(/databases/$(database)/documents/avaliacoes/$(avalId))
                    && aval().tipo == 'negocio'
                    && aval().nota <= 2
                    && aval().alvoId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['texto', 'autorId', 'criadoEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && respostaOk(request.resource.data)
                    && request.resource.data.criadoEm == request.time;

      allow update: if logado()
                    && emailOk()
                    && request.resource.data.autorId == resource.data.autorId
                    && (
                      // o negócio corrige a resposta
                      (resource.data.autorId == request.auth.uid
                        && mudou().hasOnly(['texto', 'editadoEm'])
                        && respostaOk(request.resource.data)
                        && request.resource.data.editadoEm == request.time)
                      ||
                      // o cliente que reclamou marca como resolvida (ou não)
                      (aval().autorId == request.auth.uid
                        && mudou().hasOnly(['resolvido', 'resolvidoEm'])
                        && request.resource.data.resolvido is bool
                        && request.resource.data.resolvidoEm == request.time)
                    );

      allow delete: if false;
    }


    // =====================================================
    // RECLAMAÇÕES ABERTAS PELO CLIENTE (separadas da nota)
    // queixas/{negocioId}_{cliente}: uma por cliente em cada negócio.
    //   - abrir: e-mail confirmado, conta com 3 dias, já mandou mensagem ao negócio
    //     (o negócio não precisa ter respondido) e dentro da cota (cotas/{uid}).
    //   - o dono do negócio responde (pode corrigir a resposta);
    //   - só o cliente marca como resolvida; resolvida, pode reabrir (conta na cota).
    //   - ninguém apaga.
    // cotas/{uid}: no máximo 3 reclamações a cada 30 dias (janela que começa na primeira).
    // =====================================================
    match /queixas/{id} {

      function motivoOk(m) {
        return m in ['atraso', 'qualidade', 'cobranca', 'ausencia', 'atendimento', 'golpe', 'outro'];
      }

      function relatoOk(d) {
        return motivoOk(d.motivo)
            && d.texto is string && d.texto.size() >= 20 && d.texto.size() <= 1000
            && fotoOk(d.get('foto', ''));
      }

      // A cota foi atualizada nesta mesma gravação.
      function contou() {
        return getAfter(/databases/$(database)/documents/cotas/$(request.auth.uid)).data.ultimaEm == request.time;
      }

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['negocioId', 'alvoId', 'autorId', 'autorNome', 'negocioNome', 'tipo', 'motivo', 'texto', 'foto',
                                                              'status', 'abertaEm', 'criadoEm', 'aberturas', 'resposta', 'respondidaEm', 'resolvidaEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && id == request.resource.data.negocioId + '_' + request.auth.uid
                    && request.resource.data.alvoId == donoDoNegocio(request.resource.data.negocioId)
                    && request.resource.data.alvoId != request.auth.uid
                    && request.resource.data.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis', 'saude']
                    && relatoOk(request.resource.data)
                    && valorTextoAte(request.resource.data.get('autorNome', ''), 80)
                    && valorTextoAte(request.resource.data.get('negocioNome', ''), 80)
                    && request.resource.data.status == 'aberta'
                    && request.resource.data.aberturas == 1
                    && request.resource.data.get('resposta', null) == null
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.abertaEm == request.time
                    && contaAntiga(request.auth.uid)
                    && falou(request.auth.uid, request.resource.data.alvoId, request.auth.uid)
                    && contou();

      allow update: if logado()
                    && emailOk()
                    && request.resource.data.autorId == resource.data.autorId
                    && request.resource.data.alvoId == resource.data.alvoId
                    && request.resource.data.negocioId == resource.data.negocioId
                    && (
                      // o negócio responde ou corrige a resposta (enquanto está aberta)
                      (resource.data.alvoId == request.auth.uid
                        && resource.data.status == 'aberta'
                        && mudou().hasOnly(['resposta', 'respondidaEm'])
                        && request.resource.data.resposta is string
                        && request.resource.data.resposta.size() >= 2 && request.resource.data.resposta.size() <= 1000
                        && request.resource.data.respondidaEm == request.time)
                      ||
                      // o cliente marca como resolvida
                      (resource.data.autorId == request.auth.uid
                        && resource.data.status == 'aberta'
                        && mudou().hasOnly(['status', 'resolvidaEm'])
                        && request.resource.data.status == 'resolvida'
                        && request.resource.data.resolvidaEm == request.time)
                      ||
                      // o cliente reabre (com relato novo), contando na cota
                      (resource.data.autorId == request.auth.uid
                        && resource.data.status == 'resolvida'
                        && mudou().hasOnly(['motivo', 'texto', 'foto', 'status', 'abertaEm', 'aberturas', 'resposta', 'respondidaEm', 'resolvidaEm'])
                        && relatoOk(request.resource.data)
                        && request.resource.data.status == 'aberta'
                        && request.resource.data.abertaEm == request.time
                        && request.resource.data.aberturas == resource.data.get('aberturas', 1) + 1
                        && request.resource.data.get('resposta', null) == null
                        && contou())
                    );

      allow delete: if false;
    }

    match /cotas/{uid} {

      allow read: if logado() && request.auth.uid == uid;
      allow read: if admin();

      // Janela nova (primeira vez ou a anterior já passou de 30 dias): começa agora com 1.
      // Dentro da janela: soma 1, até 3.
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['inicio', 'n', 'ultimaEm'])
                    && request.resource.data.inicio == request.time
                    && request.resource.data.n == 1
                    && request.resource.data.ultimaEm == request.time;

      allow update: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['inicio', 'n', 'ultimaEm'])
                    && request.resource.data.ultimaEm == request.time
                    && ((resource.data.inicio < request.time - duration.value(30, 'd')
                         && request.resource.data.inicio == request.time
                         && request.resource.data.n == 1)
                        ||
                        (resource.data.inicio >= request.time - duration.value(30, 'd')
                         && request.resource.data.inicio == resource.data.inicio
                         && request.resource.data.n == resource.data.n + 1
                         && request.resource.data.n <= 3));

      allow delete: if false;
    }


    // =====================================================
    // DENÚNCIAS: denuncias/{tipo}_{item}_{quemDenunciou}
    // Uma por pessoa em cada item. Só quem denunciou consegue ler a própria
    // denúncia (para saber que já enviou). A equipe analisa pelo painel.
    // O item precisa ser mesmo de quem foi denunciado.
    // =====================================================
    match /denuncias/{id} {

      function itemDoAlvo(d) {
        return (d.tipo == 'perfil' && d.itemId == d.alvoId)
            || (d.tipo == 'publicacao' && get(/databases/$(database)/documents/diario/$(d.itemId)).data.autorId == d.alvoId)
            || (d.tipo == 'comentario' && get(/databases/$(database)/documents/comentarios/$(d.itemId)).data.autorId == d.alvoId)
            || (d.tipo == 'negocio' && get(/databases/$(database)/documents/negocios/$(d.itemId)).data.donoId == d.alvoId)
            || (d.tipo == 'comunidade' && get(/databases/$(database)/documents/comunidade/$(d.itemId)).data.donoId == d.alvoId)
            || (d.tipo == 'mensagem'
                && d.conversaId is string
                && request.auth.uid in get(/databases/$(database)/documents/conversas/$(d.conversaId)).data.participantes
                && get(/databases/$(database)/documents/conversas/$(d.conversaId)/mensagens/$(d.itemId)).data.remetenteId == d.alvoId);
      }

      allow get: if logado() && resource.data.autorId == request.auth.uid;
      allow read: if admin();
      // A equipe registra a análise e quem assumiu o caso (para ninguém fazer o mesmo trabalho).
      allow update: if podeModerar()
                    && mudou().hasOnly(['status', 'acao', 'nota', 'analisadaEm', 'analisadaPor', 'responsavel', 'responsavelNome', 'assumidoEm'])
                    && request.resource.data.status in ['nova', 'em_analise', 'resolvida', 'descartada']
                    && (!mudou().hasAny(['status', 'acao', 'nota', 'analisadaEm', 'analisadaPor']) || request.resource.data.analisadaPor == request.auth.uid)
                    && responsavelOk()
                    && valorTextoAte(request.resource.data.get('nota', ''), 1000);

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['tipo', 'alvoId', 'itemId', 'conversaId', 'autorId', 'motivo', 'detalhe', 'trecho', 'contexto', 'status', 'criadoEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.alvoId is string
                    && request.resource.data.alvoId != request.auth.uid
                    && request.resource.data.itemId is string
                    && request.resource.data.tipo in ['perfil', 'publicacao', 'comentario', 'mensagem', 'negocio', 'comunidade']
                    && id == request.resource.data.tipo + '_' + request.resource.data.itemId + '_' + request.auth.uid
                    && request.resource.data.motivo in ['golpe', 'falso', 'assedio', 'odio', 'improprio', 'spam', 'menor', 'venda', 'outro']
                    && valorTextoAte(request.resource.data.get('detalhe', ''), 500)
                    && valorTextoAte(request.resource.data.get('trecho', ''), 300)
                    // mensagem: ids de algumas mensagens antes e depois (a equipe abre uma por uma)
                    && (!('contexto' in request.resource.data)
                        || (request.resource.data.tipo == 'mensagem'
                            && request.resource.data.contexto is list
                            && request.resource.data.contexto.size() <= 12))
                    && request.resource.data.status == 'nova'
                    && request.resource.data.criadoEm == request.time
                    && itemDoAlvo(request.resource.data);

      allow delete: if false;
    }


    // =====================================================
    // ADMINISTRAÇÃO
    // admins/{uid}      : quem é da equipe (criado à mão no console do Firebase)
    // sancoes/{uid}     : suspensão (até uma data) ou banimento
    // avisos/{id}       : aviso da equipe para uma pessoa
    // comunicados/{id}  : faixa para todos (ex.: manutenção, novidade)
    // suporte/{id}      : chamados de suporte (+ mensagens)
    // parcerias/{id}    : interessados em ser sócio, investidor ou parceiro
    // admin_log/{id}    : registro de tudo o que a equipe faz
    // estatisticas/{dia}, relatorios/{id}: gravados pelo relatório automático (Admin SDK)
    // =====================================================
    match /admins/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }

    match /sancoes/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      allow read: if admin();
      allow create, update: if podeModerar()
                    && request.resource.data.keys().hasOnly(['tipo', 'motivo', 'ate', 'por', 'em', 'historico'])
                    && request.resource.data.tipo in ['suspensao', 'banimento']
                    && valorTextoAte(request.resource.data.get('motivo', ''), 500)
                    && (request.resource.data.tipo == 'banimento' || request.resource.data.ate is timestamp)
                    && request.resource.data.por == request.auth.uid
                    && request.resource.data.em == request.time
                    && listaAte('historico', 50);
      allow delete: if podeModerar();
    }

    match /avisos/{id} {
      allow read: if logado() && resource.data.uid == request.auth.uid;
      allow read: if admin();
      allow create: if admin()
                    && request.resource.data.keys().hasOnly(['uid', 'titulo', 'texto', 'tipo', 'por', 'em', 'lidoEm'])
                    && request.resource.data.uid is string
                    && valorTextoAte(request.resource.data.get('titulo', ''), 120)
                    && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
                    && request.resource.data.tipo in ['info', 'alerta', 'grave']
                    && request.resource.data.por == request.auth.uid
                    && request.resource.data.em == request.time
                    && request.resource.data.lidoEm == null;
      // quem recebeu marca como lido
      allow update: if logado()
                    && resource.data.uid == request.auth.uid
                    && mudou().hasOnly(['lidoEm'])
                    && request.resource.data.lidoEm == request.time;
      allow delete: if false;
    }

    match /comunicados/{id} {
      allow read: if logado();
      allow create, update: if podeModerar()
                    && request.resource.data.keys().hasOnly(['titulo', 'texto', 'tipo', 'ativo', 'link', 'por', 'em', 'ate'])
                    && valorTextoAte(request.resource.data.get('titulo', ''), 120)
                    && valorTextoAte(request.resource.data.get('texto', ''), 600)
                    && request.resource.data.tipo in ['info', 'novidade', 'alerta']
                    && request.resource.data.ativo is bool
                    && request.resource.data.por == request.auth.uid;
      allow delete: if podeModerar();
    }

    match /suporte/{id} {
      function camposChamado() {
        return ['uid', 'nome', 'email', 'assunto', 'categoria', 'status', 'criadoEm', 'atualizadoEm', 'ultimaDe', 'atendidoPor', 'responsavel', 'responsavelNome', 'assumidoEm',
                'prioridade', 'escalonadoPara', 'primeiraRespostaEm'];
      }
      // Suporte nacional (suporte-fila.js): golpe = urgente; pagamento, contestação ou plano Pro/Premium = alta; o resto = normal.
      // Quem abre não escolhe ser urgente: a prioridade tem que bater com o assunto (ou com o plano da conta).
      function prioridadeOk(d) {
        let p = d.get('prioridade', 'normal');
        return p == 'normal'
            || (p == 'urgente' && d.categoria == 'golpe')
            || (p == 'alta' && (d.categoria in ['pagamento', 'contestacao']
                || (exists(/databases/$(database)/documents/planos/$(request.auth.uid))
                    && get(/databases/$(database)/documents/planos/$(request.auth.uid)).data.plano in ['pro', 'premium']
                    && get(/databases/$(database)/documents/planos/$(request.auth.uid)).data.ate > request.time)));
      }
      // A equipe: prioridade, transferir de setor (categoria), escalar (moderação ou donos) e a hora da 1ª resposta.
      function filaEquipeOk(d) {
        return d.get('prioridade', 'normal') in ['urgente', 'alta', 'normal']
            && d.categoria in ['conta', 'pagamento', 'golpe', 'denuncia', 'contestacao', 'negocio', 'sugestao', 'outro']
            && d.get('escalonadoPara', '') in ['', 'moderacao', 'donos']
            && (!mudou().hasAny(['primeiraRespostaEm']) || d.primeiraRespostaEm == request.time);
      }
      allow read: if logado() && resource.data.uid == request.auth.uid;
      allow read: if admin();
      // Abrir chamado: não exige e-mail confirmado nem conta livre (quem foi suspenso pode contestar).
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(camposChamado())
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.assunto is string && request.resource.data.assunto.size() >= 3 && request.resource.data.assunto.size() <= 120
                    && request.resource.data.categoria in ['conta', 'pagamento', 'golpe', 'denuncia', 'contestacao', 'negocio', 'sugestao', 'outro']
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && valorTextoAte(request.resource.data.get('email', ''), 120)
                    && request.resource.data.status == 'aberto'
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.atualizadoEm == request.time
                    && request.resource.data.ultimaDe == 'usuario'
                    && prioridadeOk(request.resource.data)
                    && !request.resource.data.keys().hasAny(['atendidoPor', 'responsavel', 'responsavelNome', 'assumidoEm', 'escalonadoPara', 'primeiraRespostaEm']);
      // A equipe abre uma conversa de suporte com qualquer pessoa ("Suporte Help Floripa"):
      // o chamado já nasce respondido, com a primeira mensagem da equipe gravada junto.
      allow create: if admin()
                    && request.resource.data.keys().hasOnly(camposChamado().concat(['abertoPor']))
                    && request.resource.data.uid is string
                    && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.uid))
                    && request.resource.data.abertoPor == request.auth.uid
                    && request.resource.data.assunto is string && request.resource.data.assunto.size() >= 3 && request.resource.data.assunto.size() <= 120
                    && request.resource.data.categoria in ['conta', 'pagamento', 'golpe', 'denuncia', 'contestacao', 'negocio', 'sugestao', 'outro']
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && valorTextoAte(request.resource.data.get('email', ''), 120)
                    && request.resource.data.status == 'respondido'
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.atualizadoEm == request.time
                    && request.resource.data.ultimaDe == 'equipe'
                    // quem abre pode já ficar como responsável pelo chamado
                    && (!('responsavel' in request.resource.data)
                        || (request.resource.data.responsavel == request.auth.uid
                            && request.resource.data.get('assumidoEm', null) == request.time
                            && valorTextoAte(request.resource.data.get('responsavelNome', ''), 80)))
                    && existsAfter(/databases/$(database)/documents/suporte/$(id)/mensagens/inicio);
      allow update: if logado()
                    && ((resource.data.uid == request.auth.uid
                         && mudou().hasOnly(['status', 'atualizadoEm', 'ultimaDe'])
                         && request.resource.data.status in ['aberto', 'fechado']
                         && request.resource.data.ultimaDe == 'usuario')
                        || (admin()
                         && mudou().hasOnly(['status', 'atualizadoEm', 'ultimaDe', 'atendidoPor', 'responsavel', 'responsavelNome', 'assumidoEm', 'primeiraRespostaEm'])
                         && request.resource.data.status in ['aberto', 'respondido', 'fechado']
                         && responsavelOk() && filaEquipeOk(request.resource.data)))
                    && request.resource.data.atualizadoEm == request.time;
      // A equipe assume ou passa o chamado, troca a prioridade, transfere de setor ou escala (sem mexer na data da conversa).
      allow update: if admin()
                    && mudou().hasOnly(['responsavel', 'responsavelNome', 'assumidoEm', 'prioridade', 'categoria', 'escalonadoPara'])
                    && responsavelOk() && filaEquipeOk(request.resource.data);
      allow delete: if false;

      match /mensagens/{msgId} {
        function chamado() { return get(/databases/$(database)/documents/suporte/$(id)).data; }
        // getAfter: o chamado e a primeira mensagem são gravados juntos (tudo ou nada).
        function chamadoDepois() { return getAfter(/databases/$(database)/documents/suporte/$(id)).data; }
        // Anexo: foto (JPEG) ou PDF dentro da mensagem, ou um arquivo do Storage do Firebase (foto, vídeo ou PDF).
        function anexoOk(x) {
          return x is map
              && x.keys().hasOnly(['tipo', 'url', 'nome'])
              && x.tipo in ['imagem', 'video', 'arquivo']
              && valorTextoAte(x.get('nome', ''), 120)
              && x.url is string && x.url.size() <= 750000
              && x.url.matches('^(data:(image/jpeg|application/pdf);base64,|https://firebasestorage[.]googleapis[.]com/).*');
        }
        allow read: if logado() && (chamado().uid == request.auth.uid || admin());
        allow create: if logado()
                      && (chamadoDepois().uid == request.auth.uid || admin())
                      && request.resource.data.keys().hasOnly(['autorId', 'equipe', 'texto', 'em', 'anexo'])
                      && request.resource.data.autorId == request.auth.uid
                      // "equipe" (resposta oficial) só quem é da equipe; no próprio chamado, todos escrevem como usuário
                      && (request.resource.data.equipe == false || (request.resource.data.equipe == true && admin()))
                      && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
                      // texto vazio só com anexo
                      && (request.resource.data.texto.size() >= 1 || 'anexo' in request.resource.data)
                      && (!('anexo' in request.resource.data) || anexoOk(request.resource.data.anexo))
                      && request.resource.data.em == request.time;
        allow update, delete: if false;
      }
      // Notas internas do chamado: só a equipe lê e escreve (a pessoa nunca vê). Não se editam nem apagam.
      match /notas/{notaId} {
        allow read: if admin();
        allow create: if admin()
                      && request.resource.data.keys().hasOnly(['autorId', 'nome', 'texto', 'em'])
                      && request.resource.data.autorId == request.auth.uid
                      && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 1000
                      && valorTextoAte(request.resource.data.get('nome', ''), 80)
                      && request.resource.data.em == request.time;
        allow update, delete: if false;
      }
    }

    // Pedido do selo de verificado: a pessoa e a moderação leem. A foto do documento é apagada na decisão.
    // Respostas prontas do suporte, compartilhadas pela equipe (suporte nacional): só a equipe lê e mexe.
    match /suporte_respostas/{id} {
      allow read: if admin();
      allow create, update: if admin()
                    && request.resource.data.keys().hasOnly(['titulo', 'texto', 'categoria', 'autorId', 'autorNome', 'em'])
                    && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 2 && request.resource.data.titulo.size() <= 60
                    && request.resource.data.texto is string && request.resource.data.texto.size() >= 2 && request.resource.data.texto.size() <= 2000
                    && request.resource.data.get('categoria', '') in ['', 'conta', 'pagamento', 'golpe', 'denuncia', 'contestacao', 'negocio', 'sugestao', 'outro']
                    && request.resource.data.autorId == request.auth.uid
                    && valorTextoAte(request.resource.data.get('autorNome', ''), 80)
                    && request.resource.data.em == request.time;
      allow delete: if admin();
    }
    match /verificacoes/{uid} {
      function pedidoOk(d) {
        return d.keys().hasOnly(['uid', 'categoria', 'nomeLegal', 'conhecidoComo', 'documentoTipo', 'documento', 'selfie', 'links', 'motivo', 'status', 'criadoEm', 'atualizadoEm'])
            && d.uid == uid
            && d.categoria is string && d.categoria.matches('^(pessoa|profissional|negocio|publica|organizacao)$')
            && d.nomeLegal is string && d.nomeLegal.size() >= 5 && d.nomeLegal.size() <= 120
            && valorTextoAte(d.get('conhecidoComo', ''), 80)
            && d.documentoTipo is string && d.documentoTipo.matches('^(rg|cnh|passaporte|rne|cnpj)$')
            && d.documento is string && d.documento.size() <= 700000 && d.documento.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            // Selfie segurando o documento: prova que quem pede é a pessoa do documento.
            && d.selfie is string && d.selfie.size() <= 450000 && d.selfie.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            && (!('links' in d) || (d.links is list && d.links.size() <= 3))
            && valorTextoAte(d.get('motivo', ''), 500)
            && d.status == 'pendente'
            && d.criadoEm == request.time && d.atualizadoEm == request.time;
      }
      allow read: if (logado() && request.auth.uid == uid) || podeModerar();
      // Pedir (ou pedir de novo depois de não aprovado ou cancelado).
      allow create: if logado() && request.auth.uid == uid && pedidoOk(request.resource.data);
      allow update: if logado() && request.auth.uid == uid
                    && resource.data.status in ['recusada', 'cancelada']
                    && pedidoOk(request.resource.data);
      // Cancelar o próprio pedido (a foto do documento sai junto).
      allow update: if logado() && request.auth.uid == uid
                    && resource.data.status in ['pendente', 'em_analise']
                    && request.resource.data.status == 'cancelada'
                    && mudou().hasOnly(['status', 'atualizadoEm', 'documento', 'selfie'])
                    && !('documento' in request.resource.data) && !('selfie' in request.resource.data)
                    && request.resource.data.atualizadoEm == request.time;
      // A moderação analisa e decide um pedido em aberto; ao aprovar ou recusar, a foto do documento é apagada.
      allow update: if podeModerar()
                    && resource.data.status in ['pendente', 'em_analise']
                    && mudou().hasOnly(['status', 'motivoRecusa', 'analisadaPor', 'analisadaEm', 'documento', 'selfie', 'atualizadoEm'])
                    && request.resource.data.status in ['em_analise', 'aprovada', 'recusada']
                    && request.resource.data.analisadaPor == request.auth.uid
                    && (request.resource.data.status == 'em_analise' || (!('documento' in request.resource.data) && !('selfie' in request.resource.data)))
                    && valorTextoAte(request.resource.data.get('motivoRecusa', ''), 500);
      allow delete: if (logado() && request.auth.uid == uid) || podeModerar();
    }

    // Reporte de atendimento do suporte (só a moderação e os donos leem; o suporte não).
    //   atendimento_{chamado}_{uid}: quem abriu o chamado reporta como foi atendido (demora, grosseria...).
    //   usuario_{chamado}_{uid}: alguém da equipe reporta a pessoa do chamado (ofensas, ameaça, golpe...).
    match /reportes/{id} {
      function chamadoDe(c) { return get(/databases/$(database)/documents/suporte/$(c)).data; }
      allow get: if logado() && resource.data.autorId == request.auth.uid;
      allow read: if podeModerar();
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['tipo', 'chamadoId', 'assunto', 'autorId', 'alvoId', 'alvoNome', 'motivo', 'detalhe', 'status', 'criadoEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.chamadoId is string
                    && id == request.resource.data.tipo + '_' + request.resource.data.chamadoId + '_' + request.auth.uid
                    && request.resource.data.motivo.matches('^(demora|grosseria|nao_resolveu|errado|dados|ofensa|ameaca|golpe|spam|outro)$')
                    && valorTextoAte(request.resource.data.get('detalhe', ''), 1000)
                    && valorTextoAte(request.resource.data.get('assunto', ''), 120)
                    && valorTextoAte(request.resource.data.get('alvoNome', ''), 80)
                    && request.resource.data.status == 'novo'
                    && request.resource.data.criadoEm == request.time
                    && ((request.resource.data.tipo == 'atendimento'
                         && chamadoDe(request.resource.data.chamadoId).uid == request.auth.uid
                         && (!('alvoId' in request.resource.data) || request.resource.data.alvoId is string))
                        || (request.resource.data.tipo == 'usuario'
                         && admin()
                         && request.resource.data.alvoId == chamadoDe(request.resource.data.chamadoId).uid));
      allow update: if podeModerar()
                    && mudou().hasOnly(['status', 'nota', 'analisadaEm', 'analisadaPor', 'responsavel', 'responsavelNome', 'assumidoEm'])
                    && request.resource.data.status in ['novo', 'em_analise', 'resolvido', 'descartado']
                    && (!mudou().hasAny(['status', 'nota', 'analisadaEm', 'analisadaPor']) || request.resource.data.analisadaPor == request.auth.uid)
                    && responsavelOk()
                    && valorTextoAte(request.resource.data.get('nota', ''), 1000);
      allow delete: if false;
    }

    // Nota do atendimento (1 a 5) dada por quem abriu o chamado, uma vez; a equipe lê.
    match /suporte_notas/{chamadoId} {
      allow read: if admin() || (logado() && resource.data.uid == request.auth.uid);
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['uid', 'nota', 'comentario', 'atendidoPor', 'criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && get(/databases/$(database)/documents/suporte/$(chamadoId)).data.uid == request.auth.uid
                    && request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
                    && valorTextoAte(request.resource.data.get('comentario', ''), 500)
                    && (!('atendidoPor' in request.resource.data) || request.resource.data.atendidoPor is string)
                    && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }

    // Planos dos negócios (Grátis + Plus, Pro e Premium, Pix manual). A pessoa cria o pedido (pendente) e pode
    // cancelar; só os donos do site conferem o pagamento, marcam pago/recusado e ativam planos/{uid}.
    match /planos_pedidos/{id} {
      allow read: if (logado() && resource.data.uid == request.auth.uid) || donoDoSite();
      // Pagamento de uma negociação aprovada (negociacaoId = uid): plano, meses e valor iguais aos que o dono do site
      // combinou, e só enquanto ela está esperando o pagamento.
      function negociacaoPagavel(d) {
        let n = get(/databases/$(database)/documents/planos_negociacoes/$(request.auth.uid)).data;
        return d.negociacaoId == request.auth.uid
            && n.status == 'aguardando_pagamento'
            && d.plano == n.planoConcedido
            && d.meses == n.meses
            && d.valor == n.valorAcordado;
      }
      allow create: if logado() && emailOk()
                    && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'plano', 'meses', 'valor', 'txid', 'status', 'criadoEm', 'negociacaoId'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.plano in ['plus', 'pro', 'premium']
                    && request.resource.data.valor is number && request.resource.data.valor > 0
                    && ('negociacaoId' in request.resource.data
                        ? negociacaoPagavel(request.resource.data)
                        : (request.resource.data.meses in [1, 3, 6, 12] && request.resource.data.valor <= 1000))
                    && request.resource.data.txid is string && request.resource.data.txid.matches('^[A-Z0-9]{4,25}$')
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && valorTextoAte(request.resource.data.get('email', ''), 120)
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.criadoEm == request.time;
      allow update: if logado() && resource.data.uid == request.auth.uid
                    && resource.data.status == 'pendente'
                    && mudou().hasOnly(['status'])
                    && request.resource.data.status == 'cancelado';
      allow update: if donoDoSite()
                    && resource.data.status == 'pendente'
                    && mudou().hasOnly(['status', 'decididoPor', 'decididoEm', 'motivo'])
                    && request.resource.data.status in ['pago', 'recusado']
                    && request.resource.data.decididoPor == request.auth.uid
                    && request.resource.data.decididoEm == request.time
                    && valorTextoAte(request.resource.data.get('motivo', ''), 300);
      allow delete: if false;
    }
    // Plano ativo da conta: público (selo e destaque); só os donos do site mudam.
    // Primeiro acesso: a própria pessoa começa 30 dias grátis no plano que escolher (só se a conta nunca teve plano).
    match /planos/{uid} {
      function tiposPerfisOk(l) {
        return l is list && l.size() >= 1 && l.size() <= 5
            && l.join(',').matches('^(servicos|delivery|lojinha|imoveis|saude)(,(servicos|delivery|lojinha|imoveis|saude)){0,4}$');
      }
      allow read: if logado();
      // Os 30 dias grátis agora vêm junto com a primeira assinatura paga (o dono do site soma ao confirmar o Pix):
      // ninguém grava o próprio plano.
      allow create, update: if donoDoSite()
                    && request.resource.data.keys().hasOnly(['plano', 'ate', 'ativadoEm', 'ativadoPor', 'pedidoId', 'negociacaoId', 'meses', 'teste', 'dias', 'tipos', 'semSelo'])
                    && request.resource.data.plano in ['plus', 'pro', 'premium', 'gratis']
                    // Plano combinado pode liberar só alguns perfis (tipos) e esconder o selo (semSelo).
                    && (!('tipos' in request.resource.data) || tiposPerfisOk(request.resource.data.tipos))
                    && request.resource.data.get('semSelo', false) is bool
                    && (!('dias' in request.resource.data) || (request.resource.data.dias is int && request.resource.data.dias >= 1 && request.resource.data.dias <= 800))
                    && request.resource.data.ate is timestamp
                    && request.resource.data.ativadoPor == request.auth.uid
                    && request.resource.data.ativadoEm == request.time;
      allow delete: if donoDoSite();
    }
    // Condição especial (baixa renda) ou parceria pelos planos: um pedido por pessoa (id = uid). A pessoa envia,
    // cancela enquanto está aberto e pede de novo depois de decidido; só os donos do site leem e negociam.
    // Condição especial: a pessoa diz qual documento prova a baixa renda (ou que manda depois), declara que é verdade e
    // pode anexar a foto/PDF; o anexo sai do documento quando os donos decidem (ou quando ela cancela).
    match /planos_negociacoes/{uid} {
      function comprovanteOk(x) {
        return x is map
            && x.keys().hasOnly(['tipo', 'url', 'nome'])
            && x.tipo in ['imagem', 'arquivo']
            && valorTextoAte(x.get('nome', ''), 120)
            && x.url is string && x.url.size() <= 750000
            && x.url.matches('^(data:(image/jpeg|application/pdf);base64,|https://firebasestorage[.]googleapis[.]com/).*');
      }
      function respNegOk(d) {
        return (d.get('responsavel', null) == null || d.responsavel is string)
            && valorTextoAte(d.get('responsavelNome', ''), 80)
            && (!('assumidoEm' in d) || d.assumidoEm == request.time || d.assumidoEm == resource.data.get('assumidoEm', null));
      }
      function pedidoNegOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'nome', 'email', 'tipo', 'plano', 'valorProposto', 'contato', 'mensagem', 'status', 'criadoEm', 'comprovanteTipo', 'comprovante', 'declaracao', 'perfisPedidos', 'mesesPedidos'])
          && (!('perfisPedidos' in d) || (d.perfisPedidos is int && d.perfisPedidos >= 1 && d.perfisPedidos <= 5))
          && (!('mesesPedidos' in d) || (d.mesesPedidos is int && d.mesesPedidos >= 1 && d.mesesPedidos <= 12))
          // Baixa renda: declaração + qual documento + o documento anexado (não dá mais para "mandar depois").
          && (d.tipo != 'apoio' || (d.get('declaracao', false) == true
              && d.get('comprovanteTipo', '') is string
              && d.get('comprovanteTipo', '').matches('^(cadunico|bolsa|bpc|cnis|renda|desemprego|tarifa|mei|isento)$')
              && 'comprovante' in d))
          && (!('comprovante' in d) || (d.tipo == 'apoio' && comprovanteOk(d.comprovante)))
          && d.uid == request.auth.uid && uid == request.auth.uid
          && d.tipo in ['apoio', 'parceria']
          && d.plano in ['plus', 'pro', 'premium']
          && d.valorProposto is number && d.valorProposto >= 0 && d.valorProposto <= 1000
          && d.mensagem is string && d.mensagem.size() >= 20 && d.mensagem.size() <= 1500
          && valorTextoAte(d.get('contato', ''), 40)
          && valorTextoAte(d.get('nome', ''), 80)
          && valorTextoAte(d.get('email', ''), 120)
          && d.status == 'novo'
          && d.criadoEm == request.time;
      }
      allow read: if (logado() && uid == request.auth.uid) || donoDoSite();
      allow create: if logado() && emailOk() && pedidoNegOk();
      // Pedir de novo: só depois que o anterior foi decidido ou cancelado (substitui o documento inteiro).
      allow update: if logado() && emailOk() && uid == request.auth.uid
                    && resource.data.status in ['aprovado', 'recusado', 'cancelado']
                    && pedidoNegOk();
      allow update: if logado() && uid == request.auth.uid
                    && resource.data.status in ['novo', 'em_conversa', 'aguardando_pagamento']
                    && mudou().hasOnly(['status', 'comprovante'])
                    && !('comprovante' in request.resource.data)
                    && request.resource.data.status == 'cancelado';
      // Responsável pelo pedido (só os donos do site): assumir, passar ou liberar.
      allow update: if donoDoSite()
                    && mudou().hasOnly(['responsavel', 'responsavelNome', 'assumidoEm'])
                    && respNegOk(request.resource.data);
      allow update: if donoDoSite()
                    && resource.data.status in ['novo', 'em_conversa']
                    && mudou().hasOnly(['status', 'resposta', 'decididoPor', 'decididoEm', 'planoConcedido', 'meses', 'valorAcordado', 'comprovante', 'dias', 'tipos', 'semSelo', 'responsavel', 'responsavelNome'])
                    && respNegOk(request.resource.data)
                    && (!('tipos' in request.resource.data) || (request.resource.data.tipos is list && request.resource.data.tipos.size() <= 5 && request.resource.data.tipos.join(',').matches('^(servicos|delivery|lojinha|imoveis|saude)(,(servicos|delivery|lojinha|imoveis|saude)){0,4}$')))
                    && request.resource.data.get('semSelo', false) is bool
                    && (!('dias' in request.resource.data) || (request.resource.data.dias is int && request.resource.data.dias >= 1 && request.resource.data.dias <= 800))
                    && request.resource.data.status in ['em_conversa', 'aprovado', 'aguardando_pagamento', 'recusado']
                    && (request.resource.data.status == 'em_conversa' ? !mudou().hasAny(['comprovante']) : !('comprovante' in request.resource.data))
                    && request.resource.data.decididoPor == request.auth.uid
                    && request.resource.data.decididoEm == request.time
                    && valorTextoAte(request.resource.data.get('resposta', ''), 600)
                    // Aprovado com valor: fica esperando o pagamento (o plano só liga quando o Pix/cartão é confirmado).
                    && (!(request.resource.data.status in ['aprovado', 'aguardando_pagamento'])
                        || (request.resource.data.planoConcedido in ['plus', 'pro', 'premium']
                            && request.resource.data.meses is int && request.resource.data.meses >= 1 && request.resource.data.meses <= 24
                            && request.resource.data.valorAcordado is number && request.resource.data.valorAcordado >= 0 && request.resource.data.valorAcordado <= 5000
                            && (request.resource.data.status == 'aprovado' || request.resource.data.valorAcordado > 0)));
      // Esperando o pagamento: o dono do site confirma (pago, com o pedido) ou cancela a cobrança.
      allow update: if donoDoSite()
                    && resource.data.status == 'aguardando_pagamento'
                    && mudou().hasOnly(['status', 'pedidoId', 'pagoEm', 'resposta', 'decididoPor', 'decididoEm'])
                    && request.resource.data.status in ['aprovado', 'recusado']
                    && (!('pedidoId' in request.resource.data) || request.resource.data.pedidoId is string)
                    && request.resource.data.decididoPor == request.auth.uid
                    && request.resource.data.decididoEm == request.time
                    && valorTextoAte(request.resource.data.get('resposta', ''), 600);
      allow delete: if false;
    }

    match /parcerias/{id} {
      // Formulário de Sócios e parcerias: só quem tem conta (e-mail confirmado), até 3 por dia; só a equipe lê.
      allow create: if logado()
                    && emailOk()
                    && request.resource.data.uid == request.auth.uid
                    && ritmoOk('parc')
                    && request.resource.data.keys().hasOnly(['nome', 'empresa', 'email', 'telefone', 'tipo', 'mensagem', 'site', 'cidade', 'uid', 'status', 'criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
                    && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') && request.resource.data.email.size() <= 120
                    && valorTextoAte(request.resource.data.get('empresa', ''), 100)
                    && valorTextoAte(request.resource.data.get('telefone', ''), 30)
                    && valorTextoAte(request.resource.data.get('site', ''), 200)
                    && valorTextoAte(request.resource.data.get('cidade', ''), 80)
                    && request.resource.data.tipo in ['socio', 'investidor', 'parceiro', 'anunciante', 'imprensa', 'outro']
                    && request.resource.data.mensagem is string && request.resource.data.mensagem.size() >= 10 && request.resource.data.mensagem.size() <= 2000
                    && request.resource.data.status == 'novo'
                    && request.resource.data.criadoEm == request.time;
      allow read: if admin();
      allow update: if podeComercial()
                    && mudou().hasOnly(['status', 'notas', 'atualizadoEm', 'responsavel', 'responsavelNome', 'assumidoEm'])
                    && request.resource.data.status in ['novo', 'em_conversa', 'proposta', 'fechado', 'recusado']
                    && (!mudou().hasAny(['responsavelNome', 'assumidoEm']) || responsavelOk())
                    && valorTextoAte(request.resource.data.get('notas', ''), 3000);
      allow delete: if podeComercial();
    }

    // Presença da equipe no painel (quem está online) e chat interno da equipe.
    match /equipe_presenca/{uid} {
      allow read: if admin();
      allow create, update: if admin()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['nome', 'em', 'secao', 'item', 'itemNome', 'status'])
                    && request.resource.data.get('status', 'disponivel') in ['disponivel', 'pausa', 'fora']
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && valorTextoAte(request.resource.data.get('secao', ''), 40)
                    && valorTextoAte(request.resource.data.get('item', null), 160)
                    && valorTextoAte(request.resource.data.get('itemNome', null), 120)
                    && request.resource.data.em == request.time;
      allow delete: if admin() && request.auth.uid == uid;
    }

    // Mensagem do chat da equipe (todos ou individual): texto e/ou um anexo
    // (foto, áudio ou arquivo). O conteúdo do anexo fica em equipe_anexos/{id},
    // gravado junto, da mesma pessoa e da mesma conversa.
    function msgEquipeOk(conversa) {
      let d = request.resource.data;
      return d.keys().hasOnly(['autorId', 'nome', 'texto', 'em', 'mencoes', 'tipoArquivo', 'anexo', 'nomeArquivo', 'tamanho', 'miniatura', 'duracao', 'resposta', 'reacoes'])
          && d.autorId == request.auth.uid
          && valorTextoAte(d.get('nome', ''), 80)
          && d.texto is string && d.texto.size() <= 2000
          && (d.texto.size() >= 1 || 'anexo' in d)
          && d.em == request.time
          && (!('mencoes' in d) || (d.mencoes is list && d.mencoes.size() <= 10))
          && (!('resposta' in d)
              || (d.resposta is map
                  && d.resposta.keys().hasOnly(['id', 'autorId', 'nome', 'texto'])
                  && d.resposta.get('id', '') is string
                  && d.resposta.get('autorId', '') is string
                  && valorTextoAte(d.resposta.get('nome', ''), 80)
                  && d.resposta.get('texto', '') is string && d.resposta.get('texto', '').size() <= 200))
          && (!('reacoes' in d) || (d.reacoes is map && d.reacoes.size() == 0))
          && (!('anexo' in d)
              || (d.anexo is string
                  && d.tipoArquivo in ['imagem', 'audio', 'arquivo']
                  && getAfter(/databases/$(database)/documents/equipe_anexos/$(d.anexo)).data.autorId == request.auth.uid
                  && getAfter(/databases/$(database)/documents/equipe_anexos/$(d.anexo)).data.conversa == conversa))
          && (!('tipoArquivo' in d) || 'anexo' in d)
          && valorTextoAte(d.get('nomeArquivo', ''), 120)
          && (!('tamanho' in d) || (d.tamanho is int && d.tamanho >= 0))
          && (!('duracao' in d) || (d.duracao is int && d.duracao >= 0 && d.duracao <= 600))
          && (!('miniatura' in d) || (d.miniatura is string && d.miniatura.size() <= 30000 && d.miniatura.matches('^data:image/jpeg;base64,.*')));
    }
    // Reação a uma mensagem: cada pessoa guarda só a sua (reacoes[uid] = emoji).
    // A edição só pode mexer no campo reacoes, e só na própria chave de quem edita.
    function reacaoValida() {
      let d = request.resource.data;
      let a = resource.data;
      let eu = request.auth.uid;
      return d.diff(a).affectedKeys().hasOnly(['reacoes'])
          && d.get('reacoes', {}) is map
          && d.get('reacoes', {}).diff(a.get('reacoes', {})).affectedKeys().hasOnly([eu])
          && (!(eu in d.get('reacoes', {})) || d.reacoes[eu] in ['👍', '❤️', '😂', '😮', '😢', '🙏']);
    }
    // Editar mensagem do chat da equipe (só quem escreveu): texto novo + versão anterior em "edicoes".
    function edicaoEquipeOk() {
      let d = request.resource.data;
      let a = resource.data;
      return a.autorId == request.auth.uid
          && request.time < a.em + duration.value(10, 'm')
          && !('apagada' in a)
          && d.diff(a).affectedKeys().hasOnly(['texto', 'editadaEm', 'edicoes'])
          && d.texto is string && d.texto.size() <= 2000
          && (d.texto.size() > 0 || 'anexo' in a)
          && d.editadaEm == request.time
          && d.edicoes is list
          && d.edicoes.size() == a.get('edicoes', []).size() + 1
          && d.edicoes.size() <= 20
          && d.edicoes == a.get('edicoes', []).concat([d.edicoes[a.get('edicoes', []).size()]])
          && d.edicoes[a.get('edicoes', []).size()] is map
          && d.edicoes[a.get('edicoes', []).size()].keys().hasOnly(['texto', 'em'])
          && d.edicoes[a.get('edicoes', []).size()].texto == a.get('texto', '')
          && d.edicoes[a.get('edicoes', []).size()].em == a.get('editadaEm', a.em);
    }
    // Apagar para todos no chat da equipe: fica "apagou esta mensagem"; o conteúdo vai para
    // equipe_apagadas/{id} (abre por 24 horas), gravado junto.
    function apagarEquipeOk(id) {
      let d = request.resource.data;
      let a = resource.data;
      return a.autorId == request.auth.uid
          && request.time < a.em + duration.value(10, 'm')
          && !('apagada' in a)
          && d.keys().hasOnly(['autorId', 'nome', 'em', 'apagada'])
          && d.autorId == a.autorId && d.em == a.em && d.get('nome', '') == a.get('nome', '')
          && d.apagada is map && d.apagada.keys().hasOnly(['por', 'em'])
          && d.apagada.por == request.auth.uid && d.apagada.em == request.time
          && existsAfter(/databases/$(database)/documents/equipe_apagadas/$(id));
    }
    match /equipe_chat/{id} {
      allow read: if admin();
      allow create: if admin() && msgEquipeOk('equipe');
      allow update: if admin() && reacaoValida();
      allow update: if admin() && (edicaoEquipeOk() || apagarEquipeOk(id));
      allow delete: if false;
    }
    // Canais da equipe por setor (equipe-canais.js): equipe_canais/{canal} guarda só o resumo da última
    // mensagem; as mensagens ficam em equipe_canais/{canal}/mensagens. Toda a equipe lê; em "avisos" só
    // os donos escrevem.
    function canalEquipeOk(canal) {
      return canal.matches('^(avisos|seguranca|moderacao|pagamentos|negocios|conta|comercial)$')
          && (canal != 'avisos' || papel() == 'dono');
    }
    match /equipe_canais/{canal} {
      allow read: if admin();
      allow create, update: if admin() && canalEquipeOk(canal)
                    && request.resource.data.keys().hasOnly(['ultimaEm', 'ultimaTexto', 'ultimoAutor', 'ultimoNome', 'mencoes'])
                    && request.resource.data.ultimoAutor == request.auth.uid
                    && request.resource.data.ultimaEm == request.time
                    && valorTextoAte(request.resource.data.get('ultimaTexto', ''), 140)
                    && valorTextoAte(request.resource.data.get('ultimoNome', ''), 80)
                    && (!('mencoes' in request.resource.data) || (request.resource.data.mencoes is list && request.resource.data.mencoes.size() <= 10));
      allow delete: if false;
      match /mensagens/{id} {
        allow read: if admin();
        allow create: if admin() && canalEquipeOk(canal) && msgEquipeOk('canal-' + canal);
        allow update: if admin() && reacaoValida();
        allow update: if admin() && (edicaoEquipeOk() || apagarEquipeOk(id));
        allow delete: if false;
      }
    }
    // Conversa individual entre duas pessoas da equipe: equipe_dm/{uidA_uidB} (ids em ordem).
    // O documento guarda só o resumo (última mensagem e quando cada um leu).
    match /equipe_dm/{par} {
      function membro() {
        return admin() && par.split('_').size() == 2 && request.auth.uid in par.split('_')
            && exists(/databases/$(database)/documents/admins/$(par.split('_')[0]))
            && exists(/databases/$(database)/documents/admins/$(par.split('_')[1]));
      }
      allow read: if admin() && request.auth.uid in resource.data.participantes;
      allow create, update: if membro()
                    && request.resource.data.keys().hasOnly(['participantes', 'ultimaEm', 'ultimaTexto', 'ultimoAutor', 'lidoEm'])
                    && request.resource.data.participantes == par.split('_')
                    && valorTextoAte(request.resource.data.get('ultimaTexto', ''), 140)
                    && (!('ultimoAutor' in request.resource.data) || request.resource.data.ultimoAutor in par.split('_'))
                    && request.resource.data.get('lidoEm', {}) is map;
      allow delete: if false;
      match /mensagens/{id} {
        allow read: if admin() && request.auth.uid in par.split('_');
        allow create: if admin() && par.split('_').size() == 2 && request.auth.uid in par.split('_') && msgEquipeOk(par);
        allow update: if admin() && request.auth.uid in par.split('_') && reacaoValida();
        allow update: if admin() && request.auth.uid in par.split('_') && (edicaoEquipeOk() || apagarEquipeOk(id));
        allow delete: if false;
      }
    }
    // Conteúdo de mensagem do chat da equipe apagada para todos (abre por 24 horas, só quem participa;
    // depois disso qualquer um da conversa apaga de vez).
    match /equipe_apagadas/{id} {
      function daConversaEq(c) { return c == 'equipe' || c.matches('^canal-[a-z]+$') || request.auth.uid in c.split('_'); }
      function msgEq(c) {
        return c == 'equipe' ? /databases/$(database)/documents/equipe_chat/$(id)
             : c.matches('^canal-[a-z]+$') ? /databases/$(database)/documents/equipe_canais/$(c.split('-')[1])/mensagens/$(id)
             : /databases/$(database)/documents/equipe_dm/$(c)/mensagens/$(id);
      }
      allow get: if admin() && daConversaEq(resource.data.conversa) && request.time < resource.data.apagadaEm + duration.value(24, 'h');
      allow create: if admin()
                    && request.resource.data.keys().hasOnly(['autorId', 'conversa', 'conteudo', 'apagadaEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.conversa is string
                    && daConversaEq(request.resource.data.conversa)
                    && get(msgEq(request.resource.data.conversa)).data.autorId == request.auth.uid
                    && getAfter(msgEq(request.resource.data.conversa)).data.apagada.por == request.auth.uid
                    && request.resource.data.apagadaEm == request.time
                    && request.resource.data.conteudo is map
                    && request.resource.data.conteudo.keys().hasOnly(['texto', 'tipoArquivo', 'anexo', 'nomeArquivo', 'tamanho', 'miniatura', 'duracao', 'resposta', 'mencoes', 'edicoes'])
                    && request.resource.data.conteudo.get('texto', '') == get(msgEq(request.resource.data.conversa)).data.get('texto', '')
                    && request.resource.data.conteudo.get('anexo', '') == get(msgEq(request.resource.data.conversa)).data.get('anexo', '');
      allow update: if false;
      allow delete: if admin() && daConversaEq(resource.data.conversa) && request.time >= resource.data.apagadaEm + duration.value(24, 'h');
    }

    // Conteúdo dos anexos do chat da equipe (data: URL de até ~900 mil caracteres).
    // Só quem participa da conversa lê; ninguém edita.
    match /equipe_anexos/{id} {
      allow read: if admin()
                  && (resource.data.conversa == 'equipe' || resource.data.conversa.matches('^canal-[a-z]+$')
                      || request.auth.uid in resource.data.conversa.split('_'));
      allow create: if admin()
                    && request.resource.data.keys().hasOnly(['autorId', 'conversa', 'dados', 'em'])
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.em == request.time
                    && request.resource.data.conversa is string
                    && (request.resource.data.conversa == 'equipe'
                        || request.resource.data.conversa.matches('^canal-(avisos|seguranca|moderacao|pagamentos|negocios|conta|comercial)$')
                        || (request.resource.data.conversa.split('_').size() == 2 && request.auth.uid in request.resource.data.conversa.split('_')))
                    && request.resource.data.dados is string
                    && request.resource.data.dados.size() <= 950000
                    && request.resource.data.dados.matches('^data:[a-z]+/[-+.a-z0-9]{1,80}(;[^,]{0,80})?,.*');
      allow update, delete: if false;
    }

    // Foto do grupo "Equipe" no chat da equipe: equipe_info/grupo. Qualquer pessoa da equipe troca.
    match /equipe_info/{id} {
      allow read: if admin();
      allow create, update: if admin()
                    && id == 'grupo'
                    && request.resource.data.keys().hasOnly(['foto', 'por', 'em'])
                    && (request.resource.data.foto == null
                        || (request.resource.data.foto is string && request.resource.data.foto.size() <= 250000 && fotoOk(request.resource.data.foto)))
                    && request.resource.data.por == request.auth.uid
                    && request.resource.data.em == request.time;
      allow delete: if false;
    }

    // Quadro de tarefas da equipe: quem faz o quê.
    match /equipe_tarefas/{id} {
      function tarefaOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['titulo', 'descricao', 'status', 'prioridade', 'responsavel', 'responsavelNome', 'prazo', 'ligacao', 'ligacaoNome', 'criadoPor', 'criadoPorNome', 'criadoEm', 'atualizadoEm', 'concluidaEm'])
            && d.titulo is string && d.titulo.size() >= 2 && d.titulo.size() <= 140
            && valorTextoAte(d.get('descricao', null), 2000)
            && d.status in ['a_fazer', 'fazendo', 'feito']
            && d.prioridade in ['baixa', 'normal', 'alta', 'urgente']
            && (d.get('responsavel', null) == null || (d.responsavel is string && exists(/databases/$(database)/documents/admins/$(d.responsavel))))
            && valorTextoAte(d.get('responsavelNome', null), 80)
            && (d.get('prazo', null) == null || d.prazo is timestamp)
            && valorTextoAte(d.get('ligacao', null), 160)
            && valorTextoAte(d.get('ligacaoNome', null), 120)
            && valorTextoAte(d.get('criadoPorNome', null), 80)
            && d.atualizadoEm == request.time;
      }
      allow read: if admin();
      allow create: if admin() && tarefaOk()
                    && request.resource.data.criadoPor == request.auth.uid
                    && request.resource.data.criadoEm == request.time;
      allow update: if admin() && tarefaOk()
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if admin() && (resource.data.criadoPor == request.auth.uid || papel() == 'dono');
    }

    // Notas internas da equipe sobre um usuário (só a equipe vê; ninguém edita).
    match /notas_internas/{id} {
      allow read: if admin();
      allow create: if admin()
                    && request.resource.data.keys().hasOnly(['alvo', 'texto', 'autorId', 'autorNome', 'em'])
                    && request.resource.data.alvo is string && request.resource.data.alvo.size() <= 128
                    && request.resource.data.autorId == request.auth.uid
                    && valorTextoAte(request.resource.data.get('autorNome', null), 80)
                    && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 2000
                    && request.resource.data.em == request.time;
      allow update: if false;
      allow delete: if admin() && (resource.data.autorId == request.auth.uid || papel() == 'dono');
    }

    match /admin_log/{id} {
      // Só os donos do site leem o registro; o resto da equipe só vê as cobranças das reclamações.
      allow read: if donoDoSite() || (admin() && resource.data.acao == 'cobrar_reclamacao');
      allow create: if admin()
                    && request.resource.data.por == request.auth.uid
                    && request.resource.data.em == request.time
                    && request.resource.data.acao is string && request.resource.data.acao.size() <= 60
                    && valorTextoAte(request.resource.data.get('detalhe', ''), 1000);
      allow update, delete: if false;
    }

    match /estatisticas/{id} {
      allow read: if admin();
      allow write: if false;
    }

    match /relatorios/{id} {
      allow read: if admin();
      allow write: if false;
    }


    // =====================================================
    // LIMITE DIÁRIO (anti-spam): ritmo/{uid}
    // Janela de 24 h a partir da primeira ação. Por janela: até 500 mensagens,
    // 20 publicações e 200 comentários. Cada ação soma exatamente 1 no seu tipo.
    // =====================================================
    match /ritmo/{uid} {
      function limite(t) {
        return t == 'msg' ? 500 : (t == 'pub' ? 20 : (t == 'parc' ? 3 : 200));
      }
      function janelaNova() {
        return resource == null || resource.data.inicio < request.time - duration.value(1, 'd');
      }
      function contaOk(k, t) {
        let v = request.resource.data.get(k, 0);
        return v is int
            && v == (k == t ? (janelaNova() ? 1 : resource.data.get(k, 0) + 1)
                            : (janelaNova() ? 0 : resource.data.get(k, 0)));
      }
      allow get: if logado() && request.auth.uid == uid;
      allow read: if admin();
      allow create, update: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['inicio', 'msg', 'pub', 'com', 'parc', 'ultimaEm', 'ultimoTipo'])
                    && request.resource.data.ultimoTipo in ['msg', 'pub', 'com', 'parc']
                    && request.resource.data.ultimaEm == request.time
                    && request.resource.data.inicio == (janelaNova() ? request.time : resource.data.inicio)
                    && contaOk('msg', request.resource.data.ultimoTipo)
                    && contaOk('pub', request.resource.data.ultimoTipo)
                    && contaOk('com', request.resource.data.ultimoTipo)
                    && contaOk('parc', request.resource.data.ultimoTipo)
                    && request.resource.data.get(request.resource.data.ultimoTipo, 0) <= limite(request.resource.data.ultimoTipo);
      allow delete: if false;
    }


    // =====================================================
    // PEDIDOS DE EXCLUSÃO DE CONTA: exclusoes/{uid}
    // A pessoa pede a exclusão; durante 30 dias pode recuperar a conta (apaga este
    // documento). Depois disso a limpeza automática (Admin SDK, fora das regras)
    // apaga a conta e os dados e anonimiza avaliações e reclamações.
    // =====================================================
    match /exclusoes/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      allow read: if admin();
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['pedidaEm', 'motivo'])
                    && request.resource.data.pedidaEm == request.time
                    && valorTextoAte(request.resource.data.get('motivo', ''), 300);
      allow update: if false;
      allow delete: if logado() && request.auth.uid == uid;
    }


    // =====================================================
    // ESTRELAS NAS PUBLICAÇÕES: curtidas/{postId}_{uid}
    // Nota de 1 a 5, uma por pessoa em cada publicação. A pessoa pode
    // trocar a nota ou tirar. Ninguém dá estrelas na própria publicação.
    // =====================================================
    match /curtidas/{id} {

      allow read: if logado();

      function notaOk(d) {
        return d.nota is int && d.nota >= 1 && d.nota <= 5;
      }
      // Cada nota muda junto o resumo da publicação (diario_notas/{postId}); as regras do resumo conferem a conta.
      function resumoJunto(postId) {
        let r = /databases/$(database)/documents/diario_notas/$(postId);
        return existsAfter(r)
            && getAfter(r).data.get('soma', 0) != (exists(r) ? get(r).data.get('soma', 0) : 0);
      }

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['postId', 'uid', 'postAutorId', 'nota', 'criadoEm', 'origem'])
                    && (!('origem' in request.resource.data) || request.resource.data.origem in ['principais', 'seguindo', 'amigos', 'perfil', 'link', 'tag', 'salvos'])
                    && request.resource.data.uid == request.auth.uid
                    && id == request.resource.data.postId + '_' + request.auth.uid
                    && exists(/databases/$(database)/documents/diario/$(request.resource.data.postId))
                    && get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data.autorId == request.resource.data.postAutorId
                    // pode dar estrelas na própria publicação ("se curtir")
                    && notaOk(request.resource.data)
                    && !bloqueioEntre(request.auth.uid, request.resource.data.postAutorId)
                    && request.resource.data.criadoEm == request.time
                    && resumoJunto(request.resource.data.postId);

      allow update: if logado()
                    && emailOk()
                    && resource.data.uid == request.auth.uid
                    && mudou().hasOnly(['nota', 'atualizadoEm'])
                    && notaOk(request.resource.data)
                    && request.resource.data.atualizadoEm == request.time
                    && resumoJunto(resource.data.postId);

      // Tirar a nota: tira junto do resumo. Publicação que já não existe: apaga sem resumo (limpeza de conta).
      allow delete: if logado() && resource.data.uid == request.auth.uid
                    && (resumoJunto(resource.data.postId)
                        || !exists(/databases/$(database)/documents/diario/$(resource.data.postId)));
    }

    // ===================================================
    // SALVAMENTOS: salvamentos/{postId}_{uid} — só para o autor contar quantos salvaram (não vê quem).
    // A lista de salvos de cada um continua em usuarios/{uid}.salvos (privada).
    // ===================================================
    match /salvamentos/{id} {
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['postId', 'uid', 'postAutorId', 'criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && id == request.resource.data.postId + '_' + request.auth.uid
                    && get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data.autorId == request.resource.data.postAutorId
                    && request.resource.data.criadoEm == request.time;
      allow read: if logado() && (resource.data.uid == request.auth.uid || resource.data.postAutorId == request.auth.uid);
      allow delete: if logado() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Republicar (como o repost do Instagram): republicacoes/{postId}_{uid}. A publicação original aparece para quem
    // segue quem republicou, com "Fulano republicou". Não dá para republicar a própria nem com bloqueio entre os dois.
    match /republicacoes/{id} {
      allow read: if logado();
      allow create: if logado() && emailOk()
                    && request.resource.data.keys().hasOnly(['postId', 'uid', 'postAutorId', 'nome', 'criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.postId is string && request.resource.data.postId.size() <= 64
                    && id == request.resource.data.postId + '_' + request.auth.uid
                    && request.resource.data.postAutorId != request.auth.uid
                    && (!('nome' in request.resource.data) || (request.resource.data.nome is string && request.resource.data.nome.size() <= 80))
                    && get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data.autorId == request.resource.data.postAutorId
                    && !bloqueioEntre(request.auth.uid, request.resource.data.postAutorId)
                    && request.resource.data.criadoEm == request.time;
      allow delete: if logado() && (resource.data.uid == request.auth.uid || podeModerar());
      allow update: if false;
    }

    // ===================================================
    // STORIES (24 horas): stories/{id} — foto (no documento ou no Storage) ou vídeo (Storage).
    // Somem para todos depois de 24 h (o site filtra; o autor apaga os vencidos). vistos/{uid}: quem viu.
    // ===================================================
    match /stories/{id} {
      // Depois das 24 h o flash fica no ARQUIVO do autor (só ele vê, como no Instagram). Os outros leem o que está no ar
      // (26 h, com folga para relógio atrasado) e o que o autor pôs num destaque (destacado: true).
      allow read: if logado() && (resource.data.autorId == request.auth.uid
                    || resource.data.criadoEm > request.time - duration.value(26, 'h')
                    || resource.data.get('destacado', false) == true
                    || podeModerar());
      allow create: if logado() && emailOk()
                    && request.resource.data.keys().hasOnly(['autorId', 'nome', 'tipo', 'midia', 'texto', 'duracao', 'enquete', 'caixa', 'link', 'repostDe', 'postDe', 'negocios', 'perfil', 'mencoes', 'respostas', 'publico', 'lista', 'ocultoPara', 'criadoEm'])
                    // caixa de perguntas, link para negócio, repost e perfis de negócio (só confere o que veio)
                    && (!request.resource.data.keys().hasAny(['caixa', 'link', 'repostDe', 'postDe', 'negocios', 'perfil']) || extrasFlashOk(request.resource.data))
                    // enquete, pessoas mencionadas e as escolhas do autor (quem responde, quem vê)
                    // no flash a enquete acaba junto com ele (até 24 h, com 10 min de folga)
                    && (!('enquete' in request.resource.data) || enqueteOk(request.resource.data.enquete, request.time, 1450))
                    && (!('mencoes' in request.resource.data) || uidsOk(request.resource.data.mencoes, 10))
                    && (!('respostas' in request.resource.data) || request.resource.data.respostas in ['todos', 'seguindo', 'ninguem'])
                    && (!('publico' in request.resource.data) || request.resource.data.publico in ['todos', 'amigos'])
                    && (!('lista' in request.resource.data) || uidsOk(request.resource.data.lista, 150))
                    && (!('ocultoPara' in request.resource.data) || uidsOk(request.resource.data.ocultoPara, 100))
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.tipo in ['imagem', 'video']
                    && request.resource.data.midia is string
                    && request.resource.data.midia.size() <= 950000
                    && request.resource.data.midia.matches('^(data:image/(jpeg|png|webp);base64,|https://firebasestorage[.]googleapis[.]com/).*')
                    && (request.resource.data.tipo == 'imagem' || request.resource.data.midia.matches('^https://firebasestorage[.]googleapis[.]com/.*'))
                    && valorTextoAte(request.resource.data.get('texto', ''), 150)
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && (!('duracao' in request.resource.data) || (request.resource.data.duracao is number && request.resource.data.duracao <= 60))
                    && !sancionado(request.auth.uid);
      allow delete: if logado() && (resource.data.autorId == request.auth.uid || podeModerar());
      // O autor só marca/desmarca "destacado" (o flash está num destaque do perfil); o resto não muda depois de publicado.
      allow update: if logado() && resource.data.autorId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['destacado'])
                    && request.resource.data.destacado is bool;
      match /vistos/{uid} {
        allow create: if logado() && uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['criadoEm'])
                      && request.resource.data.criadoEm == request.time;
        allow read: if logado() && (uid == request.auth.uid
                      || get(/databases/$(database)/documents/stories/$(id)).data.autorId == request.auth.uid);
        allow update, delete: if false;
      }
      // reacoes/{uid}: a estrela (curtir o flash) e o último emoji de quem viu, para o autor ver na lista de
      // visualizações (como o coração e as reações do Instagram). Só a própria pessoa grava; só ela e o autor leem.
      match /reacoes/{uid} {
        allow create, update: if logado() && uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['curtiu', 'emoji', 'em'])
                      && request.resource.data.em == request.time
                      && (!('curtiu' in request.resource.data) || request.resource.data.curtiu is bool)
                      && (!('emoji' in request.resource.data) || request.resource.data.emoji in ['🔥', '😍', '😂', '😮', '👏', '💯', '⭐'])
                      && get(/databases/$(database)/documents/stories/$(id)).data.autorId != request.auth.uid;
        allow read: if logado() && (uid == request.auth.uid
                      || get(/databases/$(database)/documents/stories/$(id)).data.autorId == request.auth.uid);
        allow delete: if logado() && uid == request.auth.uid;
      }
    }

    // ===================================================
    // DESTAQUES do Flash: destaques/{id} {uid, nome, ids, capa, capaMini, criadoEm, atualizadoEm} — ficam no perfil,
    // como os destaques do Instagram. Quem está logado lê (os flashes em si já são lidos assim); só o dono cria,
    // muda e apaga (a moderação também apaga). capaMini = miniatura JPEG da capa (para o perfil não baixar os flashes).
    // ===================================================
    match /destaques/{id} {
      function destaqueOk(d) {
        return d.keys().hasOnly(['uid', 'nome', 'ids', 'capa', 'capaMini', 'criadoEm', 'atualizadoEm'])
          && d.nome is string && d.nome.size() >= 1 && d.nome.size() <= 30
          && d.ids is list && d.ids.size() >= 1 && d.ids.size() <= 100
          && d.atualizadoEm == request.time
          && (!('capa' in d) || (d.capa is string && d.capa.size() <= 64 && d.capa in d.ids))
          && (!('capaMini' in d) || (d.capaMini is string && d.capaMini.size() <= 30000 && d.capaMini.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
      }
      allow read: if logado();
      allow create: if logado() && emailOk() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.criadoEm == request.time && destaqueOk(request.resource.data);
      allow update: if logado() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
                    && request.resource.data.criadoEm == resource.data.criadoEm && destaqueOk(request.resource.data);
      allow delete: if logado() && (resource.data.uid == request.auth.uid || podeModerar());
    }

    // ===================================================
    // RASCUNHOS: rascunhos/{uid}/itens/{id} — só a própria pessoa (texto e fotos ainda não publicados).
    // ===================================================
    // ===================================================
    // VOTOS DAS ENQUETES: enquete_votos/{alvo}_{uid} — alvo = tipo + "_" + itemId (tipo d = publicação, f = flash).
    // fimEm (opcional) = o mesmo fim da enquete; votar só até o fim.
    // Um voto por pessoa, sem trocar. A contagem fica dividida em 10 pedaços (enquete_contas/{alvo}_{fatia},
    // ver abaixo): o voto leva a fatia (0–9) e o pedaço dela sobe +1 na MESMA gravação.
    // ===================================================
    // A contagem da opção do voto sobe exatamente 1 no pedaço escolhido (votos públicos e anônimos).
    function fatiaSobe(d) {
      let pedaco = /databases/$(database)/documents/enquete_contas/$(d.alvo + '_' + string(d.fatia));
      let k = 'n' + string(d.opcao);
      return d.fatia is int && d.fatia >= 0 && d.fatia < 10
          && getAfter(pedaco).data.get(k, 0) == (exists(pedaco) ? get(pedaco).data.get(k, 0) : 0) + 1;
    }
    match /enquete_votos/{id} {
      allow read: if logado();
      function votoOk() {
        let d = request.resource.data;
        let doc = d.tipo == 'd'
          ? /databases/$(database)/documents/diario/$(d.itemId)
          : /databases/$(database)/documents/stories/$(d.itemId);
        let e = get(doc).data.enquete;
        return d.keys().hasOnly(['alvo', 'tipo', 'itemId', 'uid', 'opcao', 'fatia', 'fimEm', 'criadoEm'])
            && d.uid == request.auth.uid
            && d.tipo in ['d', 'f']
            && d.itemId is string && d.itemId.matches('^[A-Za-z0-9]{1,64}$')
            && d.alvo == d.tipo + '_' + d.itemId
            && id == d.alvo + '_' + request.auth.uid
            && d.opcao is int && d.opcao >= 0
            && exists(doc) && d.opcao < e.opcoes.size()
            && e.get('anonima', false) == false
            // depois do fim não dá mais para votar; o voto leva o fim junto (as notificações do resultado usam)
            && (!('fimEm' in e) || request.time < e.fimEm)
            && (!('fimEm' in d) || ('fimEm' in e && d.fimEm == e.fimEm))
            && fatiaSobe(d);
      }
      // Voto único: depois de votar não dá para trocar nem tirar (a limpeza de contas apaga pelo servidor).
      allow create: if logado() && votoOk() && request.resource.data.criadoEm == request.time && !sancionado(request.auth.uid);
      allow update, delete: if false;
    }

    // ===================================================
    // ENQUETE ANÔNIMA: o voto fica em enquete_anon/{alvo}_{uid} (ninguém lista; só a própria pessoa lê o dela)
    // e a contagem nos mesmos pedaços enquete_contas/{alvo}_{fatia}, que sobem +1 na MESMA gravação do voto.
    // Assim nem o autor da enquete sabe quem votou em quê.
    // ===================================================
    match /enquete_anon/{id} {
      function votoAnonOk() {
        let d = request.resource.data;
        let doc = d.tipo == 'd'
          ? /databases/$(database)/documents/diario/$(d.itemId)
          : /databases/$(database)/documents/stories/$(d.itemId);
        let e = get(doc).data.enquete;
        return d.keys().hasOnly(['alvo', 'tipo', 'itemId', 'uid', 'opcao', 'fatia', 'fimEm', 'criadoEm'])
            && d.uid == request.auth.uid && d.criadoEm == request.time
            && d.tipo in ['d', 'f']
            && d.itemId is string && d.itemId.matches('^[A-Za-z0-9]{1,64}$')
            && d.alvo == d.tipo + '_' + d.itemId
            && id == d.alvo + '_' + request.auth.uid
            && d.opcao is int && d.opcao >= 0 && d.opcao < e.opcoes.size()
            && e.get('anonima', false) == true
            && (!('fimEm' in e) || request.time < e.fimEm)
            && (!('fimEm' in d) || ('fimEm' in e && d.fimEm == e.fimEm))
            // a contagem da opção sobe exatamente 1 junto com o voto
            && fatiaSobe(d);
      }
      allow get: if logado() && id.matches('.*_' + request.auth.uid);
      // listar só os próprios votos (o resultado chega nas notificações de quem votou)
      allow list: if logado() && resource.data.uid == request.auth.uid;
      allow create: if logado() && !sancionado(request.auth.uid) && votoAnonOk();
      allow update, delete: if false;
    }
    // CONTAGEM DAS ENQUETES em 10 pedaços: enquete_contas/{alvo}_{fatia} = { n0..n3 } (fatia 0–9). Cada voto sobe
    // 1 pedaço sorteado: um documento só aguentava ~1 voto por segundo; assim a enquete aguenta ~10× mais, e ler o
    // resultado custa no máximo 10 leituras, com quantos votos for. Só sobe junto com o voto de quem grava
    // (público em enquete_votos ou anônimo em enquete_anon), na fatia do voto, +1 na opção dele.
    match /enquete_contas/{cid} {
      allow read: if logado();
      function partes() { return cid.split('_'); }
      function votoEm(colecao) { return /databases/$(database)/documents/$(colecao)/$(partes()[0] + '_' + partes()[1] + '_' + request.auth.uid); }
      function votoDeAgora() {
        return !exists(votoEm('enquete_anon')) && existsAfter(votoEm('enquete_anon')) ? votoEm('enquete_anon') : votoEm('enquete_votos');
      }
      function chaveDoVoto() { return 'n' + string(getAfter(votoDeAgora()).data.opcao); }
      function pedacoDoVoto() {
        return cid.matches('^[df]_[A-Za-z0-9]{1,64}_[0-9]$')
            && !exists(votoDeAgora()) && existsAfter(votoDeAgora())
            && string(getAfter(votoDeAgora()).data.fatia) == partes()[2];
      }
      allow create: if logado() && pedacoDoVoto()
                    && request.resource.data.keys().hasOnly([chaveDoVoto()])
                    && request.resource.data[chaveDoVoto()] == 1;
      allow update: if logado() && pedacoDoVoto()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([chaveDoVoto()])
                    && request.resource.data[chaveDoVoto()] == resource.data.get(chaveDoVoto(), 0) + 1;
      allow delete: if false;
    }

    // ===================================================
    // CAIXA DE PERGUNTAS: caixa_respostas/{id} = { alvo, tipo, itemId, autorId (dono da publicação/flash),
    //   uid, nome, foto (só se NÃO for anônima), texto (até 300), anonima, criadoEm }.
    // Anônima: sem uid/nome/foto; quem respondeu fica em caixa_autoria/{id} (só a moderação lê).
    // O dono lê e apaga as respostas; quem respondeu (não anônima) lê e apaga a sua.
    // ===================================================
    match /caixa_respostas/{id} {
      function caixaDoItem(d) {
        return get(d.tipo == 'd'
          ? /databases/$(database)/documents/diario/$(d.itemId)
          : /databases/$(database)/documents/stories/$(d.itemId)).data;
      }
      function respostaOk() {
        let d = request.resource.data;
        let item = caixaDoItem(d);
        let autoria = /databases/$(database)/documents/caixa_autoria/$(id);
        return d.keys().hasOnly(['alvo', 'tipo', 'itemId', 'autorId', 'uid', 'nome', 'foto', 'texto', 'anonima', 'criadoEm'])
            && d.tipo in ['d', 'f']
            && d.itemId is string && d.itemId.matches('^[A-Za-z0-9]{1,64}$')
            && d.alvo == d.tipo + '_' + d.itemId
            && d.texto is string && d.texto.size() >= 1 && d.texto.size() <= 300
            && d.criadoEm == request.time
            && 'caixa' in item && d.autorId == item.autorId
            && d.anonima == item.caixa.anonima
            && (d.anonima
                ? (!d.keys().hasAny(['uid', 'nome', 'foto']) && existsAfter(autoria) && getAfter(autoria).data.uid == request.auth.uid)
                : (d.uid == request.auth.uid && textoAte('nome', 80) && textoAte('foto', 2000)));
      }
      allow create: if logado() && emailOk() && !sancionado(request.auth.uid) && respostaOk();
      allow read, delete: if logado() && (resource.data.autorId == request.auth.uid
                                       || resource.data.get('uid', '') == request.auth.uid
                                       || podeModerar());
      allow update: if false;
    }
    match /caixa_autoria/{id} {
      allow read, delete: if podeModerar();
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['uid', 'criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.criadoEm == request.time
                    && existsAfter(/databases/$(database)/documents/caixa_respostas/$(id));
      allow update: if false;
    }

    // ===================================================
    // PREFERÊNCIAS PÚBLICAS: pref_publicas/{uid} — o que os outros precisam saber antes de interagir
    // (quem pode marcar/mencionar a pessoa). Só o dono grava; qualquer pessoa logada lê.
    // ===================================================
    match /pref_publicas/{uid} {
      allow read: if logado();
      allow create, update: if logado() && uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['permiteMarcar', 'permiteFlash', 'atualizadoEm'])
                    && (!('permiteMarcar' in request.resource.data) || request.resource.data.permiteMarcar in ['todos', 'seguindo', 'ninguem'])
                    && (!('permiteFlash' in request.resource.data) || request.resource.data.permiteFlash is bool);
      allow delete: if logado() && uid == request.auth.uid;
    }

    match /rascunhos/{uid}/itens/{id} {
      allow read, delete: if logado() && uid == request.auth.uid;
      allow create, update: if logado() && uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['texto', 'fotos', 'atualizadoEm'])
                    && valorTextoAte(request.resource.data.get('texto', ''), 1000)
                    && (!('fotos' in request.resource.data) || (request.resource.data.fotos is list && request.resource.data.fotos.size() <= 4));
    }

    // ===================================================
    // RESUMO DAS ESTRELAS DE UMA PUBLICAÇÃO: diario_notas/{postId} { total, soma, n1..n5 }
    // Uma leitura mostra a média e quantas pessoas deram 5, 4, 3, 2 e 1 estrela, com mil ou um milhão
    // de notas. Só muda junto com a nota de quem grava (curtidas/{postId}_{uid}), na conta exata:
    // a nota de antes sai e a nova entra. A moderação pode recalcular.
    // ===================================================
    match /diario_notas/{postId} {
      allow read: if logado();

      function minhaNota() { return /databases/$(database)/documents/curtidas/$(postId + '_' + request.auth.uid); }
      function contaCerta() {
        let a = exists(minhaNota()) ? get(minhaNota()).data.nota : 0;
        let d = existsAfter(minhaNota()) ? getAfter(minhaNota()).data.nota : 0;
        let r = resource == null ? {} : resource.data;
        let n = request.resource.data;
        return a != d
            && n.keys().hasOnly(['total', 'soma', 'n1', 'n2', 'n3', 'n4', 'n5'])
            && n.get('total', 0) == r.get('total', 0) + (d > 0 ? 1 : 0) - (a > 0 ? 1 : 0)
            && n.get('soma', 0) == r.get('soma', 0) + d - a
            && n.get('n1', 0) == r.get('n1', 0) + (d == 1 ? 1 : 0) - (a == 1 ? 1 : 0)
            && n.get('n2', 0) == r.get('n2', 0) + (d == 2 ? 1 : 0) - (a == 2 ? 1 : 0)
            && n.get('n3', 0) == r.get('n3', 0) + (d == 3 ? 1 : 0) - (a == 3 ? 1 : 0)
            && n.get('n4', 0) == r.get('n4', 0) + (d == 4 ? 1 : 0) - (a == 4 ? 1 : 0)
            && n.get('n5', 0) == r.get('n5', 0) + (d == 5 ? 1 : 0) - (a == 5 ? 1 : 0);
      }
      allow create, update: if logado() && contaCerta();
      // Recalcular (moderação): números inteiros, sem campo estranho.
      allow create, update: if podeModerar()
                    && request.resource.data.keys().hasOnly(['total', 'soma', 'n1', 'n2', 'n3', 'n4', 'n5'])
                    && request.resource.data.total is int && request.resource.data.soma is int
                    && request.resource.data.n1 is int && request.resource.data.n2 is int && request.resource.data.n3 is int
                    && request.resource.data.n4 is int && request.resource.data.n5 is int;
      allow delete: if podeModerar();
    }

    // =====================================================
    // COMENTÁRIOS: comentarios/{id}
    // - Resposta: respostaA = id do comentário respondido (mesma publicação)
    //   e respostaAutorId = autor dele (para o aviso).
    // - Quem comentou edita o texto. O dono da publicação oculta um comentário.
    // - Quem comentou ou o dono da publicação apaga.
    // - Publicação com comentários ocultos não recebe comentários novos.
    // =====================================================
    match /comentarios/{id} {

      allow read: if logado();

      function textoComentarioOk(d) {
        return d.texto is string && d.texto.size() >= 1 && d.texto.size() <= 500;
      }

      // Quem pode comentar (escolha do autor): o autor sempre pode.
      function segue(a, b) { return exists(/databases/$(database)/documents/relacoes/$(a + '_' + b)); }
      function podeComentar(p) {
        let q = p.get('quemComenta', 'todos');
        return p.autorId == request.auth.uid
            || q == 'todos'
            || (q == 'seguidores' && segue(request.auth.uid, p.autorId))
            || (q == 'mutuos' && segue(request.auth.uid, p.autorId) && segue(p.autorId, request.auth.uid));
      }

      function respostaOk(d) {
        return (!('respostaA' in d) && !('respostaAutorId' in d))
            || (d.respostaA is string
                && exists(/databases/$(database)/documents/comentarios/$(d.respostaA))
                && get(/databases/$(database)/documents/comentarios/$(d.respostaA)).data.postId == d.postId
                && d.respostaAutorId == get(/databases/$(database)/documents/comentarios/$(d.respostaA)).data.autorId);
      }

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['postId', 'postAutorId', 'autorId', 'nome', 'foto', 'texto', 'respostaA', 'respostaAutorId', 'criadoEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && textoComentarioOk(request.resource.data)
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && fotoOk(request.resource.data.get('foto', ''))
                    && exists(/databases/$(database)/documents/diario/$(request.resource.data.postId))
                    && get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data.autorId == request.resource.data.postAutorId
                    && get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data.get('comentariosOcultos', false) != true
                    && podeComentar(get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data)
                    && respostaOk(request.resource.data)
                    && !bloqueioEntre(request.auth.uid, request.resource.data.postAutorId)
                    && ritmoOk('com')
                    && request.resource.data.criadoEm == request.time;

      allow update: if logado()
                    && emailOk()
                    && (
                      // quem comentou corrige o texto
                      (resource.data.autorId == request.auth.uid
                        && mudou().hasOnly(['texto', 'editadoEm'])
                        && textoComentarioOk(request.resource.data)
                        && request.resource.data.editadoEm == request.time)
                      ||
                      // o dono da publicação oculta ou mostra o comentário
                      (resource.data.postAutorId == request.auth.uid
                        && mudou().hasOnly(['oculto'])
                        && request.resource.data.oculto is bool)
                    );

      allow delete: if logado()
                    && (resource.data.autorId == request.auth.uid || resource.data.postAutorId == request.auth.uid);
      allow delete: if podeModerar();
    }

    // =====================================================
    // CURTIDAS EM COMENTÁRIOS: curtidas_comentarios/{comentarioId}_{uid}
    // =====================================================
    match /curtidas_comentarios/{id} {

      allow read: if logado();

      // Reação (emoji); sem o campo = curtida antiga (conta como ❤️).
      function reacaoOk(d) { return !('reacao' in d) || d.reacao in ['❤️', '👍', '😂', '😮', '😢', '👏']; }

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['comentarioId', 'uid', 'criadoEm', 'reacao', 'comentarioAutorId'])
                    // quem escreveu o comentário (para avisar da reação)
                    && (!('comentarioAutorId' in request.resource.data)
                        || request.resource.data.comentarioAutorId == get(/databases/$(database)/documents/comentarios/$(request.resource.data.comentarioId)).data.autorId)
                    && request.resource.data.uid == request.auth.uid
                    && id == request.resource.data.comentarioId + '_' + request.auth.uid
                    && exists(/databases/$(database)/documents/comentarios/$(request.resource.data.comentarioId))
                    && reacaoOk(request.resource.data)
                    && request.resource.data.criadoEm == request.time;

      // Trocar a reação (só o emoji).
      allow update: if logado()
                    && resource.data.uid == request.auth.uid
                    && mudou().hasOnly(['reacao'])
                    && reacaoOk(request.resource.data);
      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }


    // =====================================================
    // DIÁRIO / PUBLICAÇÕES
    // =====================================================
    match /diario/{postId} {

      allow read: if logado();

      function publicacaoOk() {
        let d = request.resource.data;
        return textoAte('texto', 1000)
            && textoAte('nome', 80)
            && campoFotoOk('fotoPerfil')
            && (!('mediaTipo' in d) || d.mediaTipo in ['', 'image', 'video'])
            && (!('mediaUrl' in d) || d.mediaUrl == ''
                || (d.mediaUrl is string
                    && d.mediaUrl.matches('^(data:image/(jpeg|png|webp);base64,|https://firebasestorage[.]googleapis[.]com/).*')))
            // Várias fotos (2 a 4): a primeira é a mesma de mediaUrl; cada uma do próprio site.
            && (!('midias' in d)
                || (d.midias is list && d.midias.size() >= 2 && d.midias.size() <= 4
                    && d.get('mediaTipo', '') == 'image' && d.midias[0] == d.get('mediaUrl', '')
                    && fotoPubOk(d.midias[1])
                    && (d.midias.size() < 3 || fotoPubOk(d.midias[2]))
                    && (d.midias.size() < 4 || fotoPubOk(d.midias[3]))));
      }
      // Hashtags (até 10, minúsculas, sem #) e pessoas marcadas (até 10 uids): uma expressão cada (join).
      function tagsOk(d) {
        return !('tags' in d) || (d.tags is list && d.tags.size() <= 10
            && (d.tags.size() == 0 || d.tags.join(' ').matches('^[\\p{Ll}\\p{N}_]{1,30}( [\\p{Ll}\\p{N}_]{1,30}){0,9}$')));
      }
      function marcadosOk(d) {
        return !('marcados' in d) || (d.marcados is list && d.marcados.size() <= 10
            && (d.marcados.size() == 0 || d.marcados.join(' ').matches('^[A-Za-z0-9]{1,64}( [A-Za-z0-9]{1,64}){0,9}$')));
      }
      // Local da publicação ("Trindade, Florianópolis"): nome e o ponto arredondado, dentro do Brasil.
      function localPubOk(d) {
        return !('local' in d) || d.local == null
            || (d.local is map && d.local.keys().hasOnly(['nome', 'lat', 'lng'])
                && d.local.nome is string && d.local.nome.size() >= 2 && d.local.nome.size() <= 80
                && d.local.lat is number && d.local.lat >= -34 && d.local.lat <= 6
                && d.local.lng is number && d.local.lng >= -75 && d.local.lng <= -28);
      }
      // Público da publicação (direcionamento no Diário, Explorar e Reels): idade, gênero, lugar e seguidores.
      function publicoOk(d) {
        let p = d.get('publico', null);
        return p == null
            || (p is map && p.keys().hasOnly(['idadeMin', 'idadeMax', 'genero', 'local', 'ufs', 'cidades', 'perto', 'seguidores'])
                && (!('idadeMin' in p) || (p.idadeMin is int && p.idadeMin >= 16 && p.idadeMin <= 100))
                && (!('idadeMax' in p) || (p.idadeMax is int && p.idadeMax >= 16 && p.idadeMax <= 100))
                && (!('genero' in p) || p.genero in ['f', 'm'])
                && (!('local' in p) || p.local in ['brasil', 'estados', 'cidades', 'perto'])
                && (!('ufs' in p) || (p.ufs is list && p.ufs.size() >= 1 && p.ufs.size() <= 27 && p.ufs.join(' ').matches('^[A-Z]{2}( [A-Z]{2}){0,26}$')))
                && (!('cidades' in p) || (p.cidades is list && p.cidades.size() >= 1 && p.cidades.size() <= 10 && p.cidades.join(' ').matches('^[0-9]{7}( [0-9]{7}){0,9}$')))
                && (!('perto' in p) || (p.perto is map && p.perto.keys().hasOnly(['lat', 'lng', 'km', 'nome'])
                    && p.perto.lat is number && p.perto.lat >= -34 && p.perto.lat <= 6
                    && p.perto.lng is number && p.perto.lng >= -75 && p.perto.lng <= -28
                    && p.perto.km is int && p.perto.km >= 5 && p.perto.km <= 300
                    && (!('nome' in p.perto) || (p.perto.nome is string && p.perto.nome.size() <= 60))))
                && (!('seguidores' in p) || p.seguidores in ['todos', 'seguidores', 'novos']));
      }
      function fotoPubOk(u) {
        return u is string && u.matches('^(data:image/(jpeg|png|webp);base64,|https://firebasestorage[.]googleapis[.]com/).*');
      }
      // Tipo da publicação e o que cada um aceita (sem 'tipo' = publicação antiga, vale como antes):
      //   texto: texto obrigatório; pode ter UMA imagem "casada" (estilo 'casada', texto até 500); sem enquete/caixa/vídeo
      //   foto: 1 a 4 fotos (mediaUrl + midias), legenda opcional; sem enquete/caixa/vídeo
      //   video: um vídeo (mediaTipo 'video'), legenda opcional
      //   enquete / caixa: a enquete ou a caixa de perguntas, com no máximo uma imagem (sem midias e sem vídeo)
      function tipoOk(d) {
        let t = d.get('tipo', '');
        let midia = d.get('mediaUrl', '') != '';
        let video = d.get('mediaTipo', '') == 'video';
        let extra = ('enquete' in d) || ('caixa' in d);
        return (t == '' && !('estilo' in d))
            || (t == 'texto' && d.get('texto', '').size() >= 1 && !extra && !video && !('midias' in d)
                && (midia ? (d.get('estilo', '') == 'casada' && d.texto.size() <= 500) : !('estilo' in d)))
            || (t == 'foto' && midia && !video && !extra && !('estilo' in d))
            || (t == 'video' && midia && video && !extra && !('midias' in d) && !('estilo' in d))
            || (t in ['enquete', 'caixa'] && (t == 'enquete') == ('enquete' in d) && (t == 'caixa') == ('caixa' in d)
                && !video && !('midias' in d) && !('estilo' in d));
      }

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['autorId', 'nome', 'fotoPerfil', 'texto', 'mediaUrl', 'mediaTipo', 'midias', 'tags', 'marcados', 'agendadoPara', 'enquete', 'caixa', 'local',
                                                              'autorUf', 'autorIbge', 'publico', 'tipo', 'estilo', 'quemComenta', 'ocultarNotas', 'criadoEm'])
                    && tipoOk(request.resource.data)
                    && (!('quemComenta' in request.resource.data) || request.resource.data.quemComenta in ['todos', 'seguidores', 'mutuos', 'ninguem'])
                    && (!('ocultarNotas' in request.resource.data) || request.resource.data.ocultarNotas is bool)
                    // Região de quem publica (Diário e Explorar priorizam a cidade e o estado de quem lê): UF e código IBGE.
                    && (!('autorUf' in request.resource.data) || (request.resource.data.autorUf is string && request.resource.data.autorUf.matches('^[A-Z]{2}$')))
                    && (!('autorIbge' in request.resource.data) || (request.resource.data.autorIbge is int && request.resource.data.autorIbge > 1000000 && request.resource.data.autorIbge < 6000000))
                    && localPubOk(request.resource.data) && publicoOk(request.resource.data)
                    && (!('caixa' in request.resource.data) || caixaOk(request.resource.data.caixa))
                    // enquete: até 7 dias a partir de quando aparece (agora ou a data agendada), com 10 min de folga
                    && (!('enquete' in request.resource.data) || enqueteOk(request.resource.data.enquete,
                          'agendadoPara' in request.resource.data ? request.resource.data.agendadoPara : request.time, 10090))
                    && ritmoOk('pub')
                    && publicacaoOk()
                    && tagsOk(request.resource.data) && marcadosOk(request.resource.data)
                    // agendada: aparece para os outros a partir de agendadoPara (até 60 dias)
                    && (!('agendadoPara' in request.resource.data)
                        || (request.resource.data.agendadoPara is timestamp
                            && request.resource.data.agendadoPara > request.time
                            && request.resource.data.agendadoPara < request.time + duration.value(60, 'd')));

      allow update: if logado()
                    && emailOk()
                    && resource.data.autorId == request.auth.uid
                    && request.resource.data.autorId == resource.data.autorId
                    && gravou().hasOnly(['texto', 'nome', 'fotoPerfil', 'comentariosOcultos', 'ocultoAte', 'editadoEm', 'quemComenta', 'comentarioFixo', 'tags', 'marcados', 'agendadoPara', 'local', 'publico', 'ocultarNotas'])
                    && (!('ocultarNotas' in request.resource.data) || request.resource.data.ocultarNotas is bool)
                    // texto com imagem casada continua até 500 letras ao editar
                    && (request.resource.data.get('estilo', '') != 'casada' || request.resource.data.texto.size() <= 500)
                    && localPubOk(request.resource.data) && publicoOk(request.resource.data)
                    && tagsOk(request.resource.data) && marcadosOk(request.resource.data)
                    // agendada: publicar agora (agendadoPara = agora) ou mudar a data (até 60 dias)
                    && (!mudou().hasAny(['agendadoPara'])
                        || (request.resource.data.agendadoPara is timestamp
                            && request.resource.data.agendadoPara >= request.time
                            && request.resource.data.agendadoPara < request.time + duration.value(60, 'd')))
                    // quem pode comentar: todos, seguidores, seguidores que o autor segue de volta, ninguém
                    && (!('quemComenta' in request.resource.data) || request.resource.data.quemComenta in ['todos', 'seguidores', 'mutuos', 'ninguem'])
                    // comentário fixado no topo (id) ou nulo
                    && (!('comentarioFixo' in request.resource.data) || request.resource.data.comentarioFixo == null
                        || (request.resource.data.comentarioFixo is string && request.resource.data.comentarioFixo.size() <= 40))
                    && dataOuNulo('ocultoAte')
                    && travaModeracao()
                    // texto editado: marca a data da edição
                    && (!mudou().hasAny(['texto']) || request.resource.data.get('editadoEm', null) == request.time)
                    && (!mudou().hasAny(['editadoEm']) || request.resource.data.editadoEm == request.time)
                    && (!('comentariosOcultos' in request.resource.data) || request.resource.data.comentariosOcultos is bool)
                    && publicacaoOk();

      allow delete: if logado()
                    && resource.data.autorId == request.auth.uid;

      // Alcance: cada conta que viu a publicação (uma vez). Só o autor lista/conta.
      match /vistas/{uid} {
        allow create: if logado() && uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['criadoEm', 'origem'])
                      && request.resource.data.criadoEm == request.time
                      && (!('origem' in request.resource.data) || request.resource.data.origem in ['principais', 'seguindo', 'amigos', 'perfil', 'link', 'tag', 'salvos']);
        allow read: if logado() && get(/databases/$(database)/documents/diario/$(postId)).data.autorId == request.auth.uid;
        allow update, delete: if false;
      }

      // A equipe esconde ou remove publicações que violam os Termos.
      allow update: if podeModerar()
                    && moderacaoOk();
      allow delete: if podeModerar();
    }
    // =====================================================
    // ESTATÍSTICAS DOS NEGÓCIOS (como o Google Meu Negócio e o painel profissional do Instagram)
    // neg_visitas/{negocio}_{uid}_{dia}: uma por pessoa, por negócio, por dia (horário de Brasília).
    //   Só a própria pessoa lê. Guarda a origem, a hora e o que ela fez (WhatsApp, rota, site...).
    // neg_stats/{negocio}_{dia}: os números do dia, que só o dono do negócio lê.
    //   Cada número só sobe +1 na MESMA gravação em que a visita nasce ou ganha uma ação nova:
    //   ninguém infla as contas, e o dono não vê QUEM visitou (só quantos).
    // =====================================================
    function diaBR() {
      let t = request.time - duration.value(3, 'h');
      return string(t.year()) + (t.month() < 10 ? '0' : '') + string(t.month()) + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    function horaBR() {
      return (request.time.hours() + 21) % 24;
    }
    function caminhoStats(negocioId, dia) {
      return /databases/$(database)/documents/neg_stats/$(negocioId + '_' + dia);
    }
    function caminhoVisita(negocioId, dia) {
      return /databases/$(database)/documents/neg_visitas/$(negocioId + '_' + request.auth.uid + '_' + dia);
    }

    match /neg_visitas/{id} {
      function visitaNova() {
        let d = request.resource.data;
        let st = caminhoStats(d.negocioId, d.dia);
        return d.keys().hasOnly(['negocioId', 'uid', 'dia', 'hora', 'origem', 'acoes', 'itens'])
            && d.uid == request.auth.uid
            && d.negocioId is string && d.negocioId.size() <= 60
            && d.dia == diaBR() && d.hora == horaBR()
            && id == d.negocioId + '_' + request.auth.uid + '_' + d.dia
            && d.origem in ['vitrine', 'busca', 'explorar', 'inicio', 'perfil', 'link', 'flash', 'mensagens', 'outro']
            && d.acoes == [] && d.itens == []
            && get(/databases/$(database)/documents/negocios/$(d.negocioId)).data.donoId != request.auth.uid
            && getAfter(st).data.v == (exists(st) ? get(st).data.v : 0) + 1;
      }
      // Uma ação nova (cada uma conta uma vez por pessoa no dia) ou um item visto (prato, produto, imóvel).
      function novoNaLista(campo, max) {
        let d = request.resource.data;
        let x = d[campo][d[campo].size() - 1];
        let st = caminhoStats(resource.data.negocioId, resource.data.dia);
        let mapa = campo == 'acoes' ? 'a' : 'it';
        return d.diff(resource.data).affectedKeys().hasOnly([campo])
            && d[campo].size() <= max
            && d[campo] == resource.data[campo].concat([x])
            && !(x in resource.data[campo])
            && (campo == 'acoes' ? acaoValida(x) : itemValido(x))
            && getAfter(st).data[mapa].get(x, 0) == get(st).data[mapa].get(x, 0) + 1;
      }
      function acaoValida(x) {
        return x in ['whats', 'mensagem', 'orcamento', 'pedido', 'rota', 'site', 'instagram', 'compartilhar', 'cupom', 'avaliar'];
      }
      function itemValido(x) {
        return x is string && x.matches('^(p_[a-z0-9_]{1,30}|an_[A-Za-z0-9]{1,30})$');
      }
      // A própria pessoa confere a visita do dia (inclusive se ela ainda não existe).
      allow read: if logado() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if logado() && visitaNova();
      allow update: if logado() && resource.data.uid == request.auth.uid
                    && (novoNaLista('acoes', 12) || novoNaLista('itens', 40));
      allow delete: if false;
    }

    match /neg_stats/{id} {
      function statsNovo() {
        let d = request.resource.data;
        let vis = caminhoVisita(d.negocioId, d.dia);
        let va = getAfter(vis).data;
        return d.keys().hasOnly(['negocioId', 'donoId', 'dia', 'v', 'o', 'h', 'a', 'it'])
            && id == d.negocioId + '_' + d.dia
            && d.donoId == get(/databases/$(database)/documents/negocios/$(d.negocioId)).data.donoId
            && !exists(vis) && va.dia == d.dia
            && d.v == 1
            && d.o.keys().hasOnly([va.origem]) && d.o[va.origem] == 1
            && d.h.keys().hasOnly([string(va.hora)]) && d.h[string(va.hora)] == 1
            && d.a == {} && d.it == {};
      }
      function maisUmNoMapa(d, r, mapa, x) {
        return d[mapa].diff(r[mapa]).affectedKeys().hasOnly([x]) && d[mapa][x] == r[mapa].get(x, 0) + 1;
      }
      function statsMais() {
        let d = request.resource.data;
        let r = resource.data;
        let k = d.diff(r).affectedKeys();
        let vis = caminhoVisita(r.negocioId, r.dia);
        return (k.hasOnly(['v', 'o', 'h'])
                && !exists(vis) && getAfter(vis).data.dia == r.dia
                && d.v == r.v + 1
                && maisUmNoMapa(d, r, 'o', getAfter(vis).data.origem)
                && maisUmNoMapa(d, r, 'h', string(getAfter(vis).data.hora)))
            || (k.hasOnly(['a'])
                && getAfter(vis).data.acoes.size() == get(vis).data.acoes.size() + 1
                && maisUmNoMapa(d, r, 'a', getAfter(vis).data.acoes[getAfter(vis).data.acoes.size() - 1]))
            || (k.hasOnly(['it'])
                && getAfter(vis).data.itens.size() == get(vis).data.itens.size() + 1
                && maisUmNoMapa(d, r, 'it', getAfter(vis).data.itens[getAfter(vis).data.itens.size() - 1]));
      }
      allow read: if logado() && (resource.data.donoId == request.auth.uid || podeModerar());
      allow create: if logado() && statsNovo();
      allow update: if logado() && statsMais();
      allow delete: if false;
    }

  }
}
