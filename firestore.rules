rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // E-mail confirmado (login com Google já vem confirmado).
    // Exigido para ações que chegam em outras pessoas: mensagens, seguir,
    // vínculos, negócios, anúncios e publicações. Freia contas falsas e robôs.
    // Conta suspensa ou banida pela equipe (sancoes/{uid}) também não age.
    function emailOk() {
      return request.auth.token.email_verified == true && !sancionado(request.auth.uid);
    }

    // Administrador: documento admins/{uid} criado à mão no console do Firebase.
    function admin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Papel na equipe (campo "papel" no documento admins/{uid}, definido no console).
    // Sem o campo = "dono" (acesso total). Outros: moderacao, suporte, comercial.
    function papel() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('papel', 'dono');
    }
    // Moderação: selo, esconder/remover conteúdo, suspender/banir, denúncias, comunicados.
    function podeModerar() {
      return admin() && papel() in ['dono', 'moderacao'];
    }
    // Comercial: propostas de sócios e parcerias.
    function podeComercial() {
      return admin() && papel() in ['dono', 'comercial'];
    }

    // Suspensão (até uma data) ou banimento (sem data).
    function sancionado(uid) {
      let s = /databases/$(database)/documents/sancoes/$(uid);
      return exists(s)
          && (get(s).data.tipo == 'banimento'
              || (get(s).data.get('ate', null) is timestamp && get(s).data.ate > request.time));
    }

    // Campos que só podem ser alterados pelo painel/admin (Admin SDK ignora as regras).
    function camposProtegidos() {
      return ['verificado', 'avaliacaoMedia', 'totalAvaliacoes'];
    }

    function naoTocaCamposProtegidosNoCreate() {
      return !request.resource.data.keys().hasAny(camposProtegidos());
    }

    // No update também ficam travados plano/valorPlanoMensal/tipoUsuario:
    // são definidos no cadastro e nunca mudam pelo site.
    function naoTocaCamposProtegidosNoUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(camposProtegidos().concat(['plano', 'valorPlanoMensal', 'tipoUsuario']));
    }

    // Campo de texto opcional com tamanho máximo (evita documentos gigantes).
    function textoAte(campo, max) {
      return !(campo in request.resource.data)
          || request.resource.data[campo] == null
          || (request.resource.data[campo] is string
              && request.resource.data[campo].size() <= max);
    }

    // Mesmo limite, para um valor qualquer (ex.: campo dentro de um mapa).
    function valorTextoAte(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // Lista opcional com no máximo N itens.
    function listaAte(campo, max) {
      return !(campo in request.resource.data)
          || request.resource.data[campo] == null
          || (request.resource.data[campo] is list
              && request.resource.data[campo].size() <= max);
    }

    // Foto só pode vir do próprio site: imagem dentro do documento (sem Storage),
    // Firebase Storage do projeto ou foto da conta Google. Bloqueia imagens de
    // sites de terceiros (rastreamento por IP, conteúdo impróprio).
    function fotoOk(v) {
      return v == null || v == ''
          || (v is string && v.matches('^(data:image/(jpeg|png|webp);base64,|https://firebasestorage[.]googleapis[.]com/|https://lh3[.]googleusercontent[.]com/).*'));
    }

    function campoFotoOk(campo) {
      return !(campo in request.resource.data) || fotoOk(request.resource.data[campo]);
    }

    // Só os campos que mudaram (para não travar documentos antigos com campos a mais).
    function mudou() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Campos novos ou alterados (campos antigos removidos não contam).
    function gravou() {
      let d = request.resource.data.diff(resource.data);
      return d.addedKeys().union(d.changedKeys());
    }

    // Bloqueio: bloqueios/{quemBloqueou}_{quemFoiBloqueado}
    function bloqueou(a, b) {
      return exists(/databases/$(database)/documents/bloqueios/$(a + '_' + b));
    }

    function bloqueioEntre(a, b) {
      return bloqueou(a, b) || bloqueou(b, a);
    }

    // ---------- avaliações e reclamações justas ----------
    // Id da conversa / do vínculo entre duas pessoas (ids em ordem).
    function par(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Conta com pelo menos 3 dias (usuarios.criadoEm é gravado no cadastro e não muda).
    function contaAntiga(uid) {
      let u = /databases/$(database)/documents/usuarios/$(uid);
      return exists(u)
          && get(u).data.get('criadoEm', null) is timestamp
          && get(u).data.criadoEm < request.time - duration.value(3, 'd');
    }

    // Quem já escreveu na conversa entre a e b (conversas.falaram, cada um marca só o seu).
    function falou(a, b, quem) {
      let c = /databases/$(database)/documents/conversas/$(par(a, b));
      return exists(c) && get(c).data.get('falaram', {}).get(quem, false) == true;
    }

    // Vínculo aceito no Social (duo, família, amigos...): conhecidos não avaliam.
    function vinculados(a, b) {
      let v = /databases/$(database)/documents/vinculos/$(par(a, b));
      return exists(v) && get(v).data.get('status', '') == 'aceito';
    }

    // Conta desativada (ou com exclusão pedida): perfis_publicos.desativadaAte no futuro.
    function desativada(uid) {
      let p = /databases/$(database)/documents/perfis_publicos/$(uid);
      return exists(p)
          && get(p).data.get('desativadaAte', null) is timestamp
          && get(p).data.desativadaAte > request.time;
    }

    // Campo opcional de data (ex.: ocultoAte): ausente, nulo ou uma data.
    function dataOuNulo(campo) {
      return !(campo in request.resource.data)
          || request.resource.data[campo] == null
          || request.resource.data[campo] is timestamp;
    }

    // Quem da equipe assumiu um item: alguém da equipe (ou ninguém), com nome curto.
    function responsavelOk() {
      let r = request.resource.data.get('responsavel', null);
      return (r == null || (r is string && exists(/databases/$(database)/documents/admins/$(r))))
          && valorTextoAte(request.resource.data.get('responsavelNome', null), 80)
          && (!mudou().hasAny(['responsavel']) || request.resource.data.get('assumidoEm', null) == request.time);
    }

    // Anti-spam: cada mensagem, publicação ou comentário conta no limite diário da pessoa
    // (ritmo/{uid}, gravado junto na mesma operação).
    function ritmoOk(tipo) {
      let r = getAfter(/databases/$(database)/documents/ritmo/$(request.auth.uid)).data;
      return r.ultimaEm == request.time && r.ultimoTipo == tipo;
    }

    function donoDoNegocio(negocioId) {
      return get(/databases/$(database)/documents/negocios/$(negocioId)).data.donoId;
    }


    // =====================================================
    // DADOS PRIVADOS DOS USUÁRIOS
    // Cada usuário só pode acessar os próprios dados.
    // =====================================================
    match /usuarios/{userId} {

      allow read: if logado()
                  && request.auth.uid == userId;
      // Dados pessoais (e-mail, telefone, nascimento): na equipe, só dono e moderação (LGPD: o mínimo necessário).
      allow read: if podeModerar();
      // A equipe aprova ou recusa o selo de verificado.
      allow update: if podeModerar()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificado', 'solicitacaoVerificacao', 'verificacaoRespondidaEm']);

      // criadoEm é a data real do cadastro (conta antiga = pode avaliar/reclamar).
      allow create: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.aceiteTermos == true
                    && (!('criadoEm' in request.resource.data) || request.resource.data.criadoEm == request.time)
                    && naoTocaCamposProtegidosNoCreate();

      // criadoEm não muda depois de gravado (cadastro antigo sem a data só pode gravar a data de agora).
      allow update: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && (!mudou().hasAny(['criadoEm'])
                        || (!('criadoEm' in resource.data) && request.resource.data.criadoEm == request.time))
                    && naoTocaCamposProtegidosNoUpdate();

      allow delete: if logado()
                    && request.auth.uid == userId;
    }


    // =====================================================
    // PERFIL PÚBLICO
    // Usado somente para busca e exibição pública.
    // NÃO deve conter e-mail, telefone ou data de nascimento.
    // =====================================================
    match /perfis_publicos/{userId} {

      // O @ exibido no perfil precisa estar reservado em nicknames/ pelo
      // próprio usuário. getAfter enxerga a reserva feita na mesma transação
      // (cadastro) ou numa escrita anterior (edição do perfil).
      function nickDoDono() {
        let d = request.resource.data;
        return !('nickname' in d)
            || d.nickname == null
            || d.nickname == ''
            || getAfter(/databases/$(database)/documents/nicknames/$(d.nickname)).data.uid == request.auth.uid;
      }

      function tamanhosOk() {
        return textoAte('nome', 80)
            && textoAte('bio', 400)
            && textoAte('cidade', 80)
            && listaAte('busca', 12)
            && dataOuNulo('desativadaAte');
      }

      // Campos que o site grava no perfil público. Qualquer outro é recusado.
      function camposPerfil() {
        return ['uid', 'nome', 'nickname', 'cidade', 'bio', 'fotoPerfil', 'fotoCapa',
                'socialVisibilidade', 'duoCapa', 'ultimoAcesso', 'criadoEm', 'atualizadoEm',
                'busca',   // palavras do nome e do @ (minúsculas, sem acento) para a busca de pessoas
                'desativadaAte'];  // conta desativada até esta data (ou exclusão pedida)
      }

      function opcoesOk() {
        let d = request.resource.data;
        return (!('socialVisibilidade' in d) || d.socialVisibilidade in ['todos', 'seguidores', 'amigos', 'ocultar'])
            && (!('duoCapa' in d) || d.duoCapa in ['clicavel', 'foto', 'ocultar'])
            && (!('nickname' in d) || valorTextoAte(d.nickname, 20));
      }

      // Foto nova precisa vir do próprio site (fotos antigas não travam a edição).
      function fotosOk() {
        return ((resource != null && !mudou().hasAny(['fotoPerfil'])) || campoFotoOk('fotoPerfil'))
            && ((resource != null && !mudou().hasAny(['fotoCapa'])) || campoFotoOk('fotoCapa'));
      }

      // Quem foi bloqueado não abre o perfil de quem bloqueou (a busca em lista continua
      // aberta a quem está logado, mas o perfil em si não carrega).
      allow get: if logado()
                 && (request.auth.uid == userId || !bloqueou(userId, request.auth.uid) || admin());
      allow list: if logado();
      // A equipe marca o selo e esconde contas suspensas/banidas.
      allow update: if podeModerar()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificado', 'desativadaAte'])
                    && dataOuNulo('desativadaAte');

      allow create: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && naoTocaCamposProtegidosNoCreate()
                    && request.resource.data.keys().hasOnly(camposPerfil())
                    && nickDoDono()
                    && tamanhosOk()
                    && opcoesOk()
                    && fotosOk();

      allow update: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && naoTocaCamposProtegidosNoUpdate()
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname'])
                        || nickDoDono())
                    && gravou().hasOnly(camposPerfil())
                    && (!mudou().hasAny(['desativadaAte']) || !sancionado(request.auth.uid))
                    && tamanhosOk()
                    && opcoesOk()
                    && fotosOk();

      allow delete: if logado()
                    && request.auth.uid == userId;
    }


    // =====================================================
    // RESERVA DE NICKNAMES
    // =====================================================
    match /nicknames/{nickname} {

      allow read: if true;

      allow create: if logado()
                    && request.auth.uid == request.resource.data.uid
                    && nickname.matches('^[a-z0-9._]{3,20}$');

      allow update: if false;

      allow delete: if logado()
                    && request.auth.uid == resource.data.uid;
    }


    // =====================================================
    // SEGUIDORES
    // Documento: relacoes/{seguidorId}_{alvoId}
    // =====================================================
    match /relacoes/{id} {

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['tipo', 'seguidorId', 'alvoId', 'criadoEm'])
                    && request.resource.data.tipo == 'seguir'
                    && request.resource.data.seguidorId == request.auth.uid
                    && request.resource.data.alvoId is string
                    && request.resource.data.alvoId != request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.alvoId
                    && !bloqueioEntre(request.auth.uid, request.resource.data.alvoId);

      allow update: if false;

      // Quem segue pode deixar de seguir; quem é seguido pode remover o seguidor.
      allow delete: if logado()
                    && (resource.data.seguidorId == request.auth.uid
                        || resource.data.alvoId == request.auth.uid);
    }


    // =====================================================
    // BLOQUEIOS
    // Documento: bloqueios/{bloqueadorId}_{bloqueadoId}
    // =====================================================
    match /bloqueios/{id} {

      allow get: if logado()
                 && (id.split('_')[0] == request.auth.uid
                     || id.split('_')[1] == request.auth.uid);
      allow read: if admin();

      allow list: if logado()
                  && (resource.data.bloqueadorId == request.auth.uid
                      || resource.data.bloqueadoId == request.auth.uid);

      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['bloqueadorId', 'bloqueadoId', 'criadoEm'])
                    && request.resource.data.bloqueadorId == request.auth.uid
                    && request.resource.data.bloqueadoId is string
                    && request.resource.data.bloqueadoId != request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.bloqueadoId;

      allow update: if false;

      allow delete: if logado()
                    && resource.data.bloqueadorId == request.auth.uid;
    }


    // =====================================================
    // VÍNCULOS SOCIAIS (duo, família, amigos)
    // Documento: vinculos/{uidMenor}_{uidMaior}
    // =====================================================
    match /vinculos/{id} {

      function inversos() {
        return {
          'duo': 'duo', 'namoro': 'namoro', 'casamento': 'casamento',
          'melhor_amigo': 'melhor_amigo', 'amigo': 'amigo', 'irmao': 'irmao',
          'pai_mae': 'filho', 'filho': 'pai_mae', 'primo': 'primo',
          'tio': 'sobrinho', 'sobrinho': 'tio', 'avo': 'neto', 'neto': 'avo',
          'parceiro': 'parceiro'
        };
      }

      // Pedidos pendentes só são visíveis para os dois envolvidos.
      allow read: if logado()
                  && (resource.data.status == 'aceito'
                      || request.auth.uid in resource.data.participantes);
      allow read: if admin();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['participantes', 'de', 'para', 'tipoDe', 'tipoPara', 'status', 'criadoEm'])
                    && request.resource.data.de == request.auth.uid
                    && request.resource.data.para is string
                    && request.resource.data.para != request.auth.uid
                    && request.resource.data.participantes is list
                    && request.resource.data.participantes.size() == 2
                    && request.auth.uid in request.resource.data.participantes
                    && request.resource.data.para in request.resource.data.participantes
                    && request.resource.data.participantes[0] < request.resource.data.participantes[1]
                    && id == request.resource.data.participantes[0] + '_' + request.resource.data.participantes[1]
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.tipoDe in inversos()
                    && request.resource.data.tipoPara == inversos()[request.resource.data.tipoDe]
                    && !bloqueioEntre(request.auth.uid, request.resource.data.para);

      // Só quem recebeu o pedido pode aceitar, e só muda o status.
      allow update: if logado()
                    && resource.data.status == 'pendente'
                    && request.auth.uid == resource.data.para
                    && request.resource.data.status == 'aceito'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceitoEm']);

      // Qualquer um dos dois pode cancelar, recusar ou desfazer.
      allow delete: if logado()
                    && request.auth.uid in resource.data.participantes;
    }


    // =====================================================
    // PERFIS DE NEGÓCIO (serviços, delivery, lojinha, imóveis)
    // Documento: negocios/{donoId}_{tipo}
    // =====================================================
    match /negocios/{id} {

      // Campos que o site grava. Qualquer outro campo é recusado.
      function camposNegocio() {
        return ['donoId', 'tipo', 'nome', 'descricao', 'cidade', 'whatsapp', 'foto', 'fotos', 'itens',
                'categoria', 'categorias', 'categoriaPersonalizada', 'criadoEm', 'atualizadoEm',
                'precoDesde', 'horario', 'atendimento', 'dias', 'regiao', 'experiencia', 'diferenciais', 'pagamentos', 'cnh', 'veiculo',
                'horaAbre', 'horaFecha', 'tempoMin', 'tempoMax', 'taxaEntrega', 'pedidoMinimo', 'opcoesEntrega',
                'entrega', 'tipoAnunciante', 'creci',
                'ocultoAte'];  // escondido enquanto a conta do dono estiver desativada
      }

      function negocioOk() {
        return textoAte('nome', 80)
            && textoAte('descricao', 600)
            && textoAte('cidade', 60)
            && textoAte('whatsapp', 20)
            && textoAte('regiao', 100)
            && textoAte('horario', 60)
            && textoAte('categoriaPersonalizada', 30)
            && listaAte('itens', 12)
            && listaAte('fotos', 5)
            && dataOuNulo('ocultoAte')
            && ((resource != null && !mudou().hasAny(['foto'])) || campoFotoOk('foto'));
      }

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.donoId == request.auth.uid
                    && request.resource.data.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis']
                    && id == request.auth.uid + '_' + request.resource.data.tipo
                    && request.resource.data.keys().hasOnly(camposNegocio())
                    && naoTocaCamposProtegidosNoCreate()
                    && negocioOk();

      allow update: if logado()
                    && emailOk()
                    && resource.data.donoId == request.auth.uid
                    && request.resource.data.donoId == resource.data.donoId
                    && request.resource.data.tipo == resource.data.tipo
                    && gravou().hasOnly(camposNegocio())
                    && naoTocaCamposProtegidosNoUpdate()
                    && negocioOk();

      allow delete: if logado()
                    && resource.data.donoId == request.auth.uid;

      // A equipe esconde (ocultoAte) o conteúdo de contas suspensas/banidas.
      allow update: if podeModerar()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ocultoAte'])
                    && dataOuNulo('ocultoAte');
    }


    // =====================================================
    // ANÚNCIOS (vários imóveis por pessoa)
    // Documento: anuncios/{id}
    // =====================================================
    match /anuncios/{id} {

      function camposAnuncio() {
        return ['donoId', 'tipo', 'ativo', 'titulo', 'finalidade', 'categoria', 'preco', 'condominio', 'iptu',
                'quartos', 'suites', 'banheiros', 'vagas', 'area', 'andar', 'bairro', 'cidade', 'mobiliado',
                'disponivel', 'hospedes', 'caracteristicas', 'condicoes', 'descricao', 'fotos', 'criadoEm', 'atualizadoEm',
                'ocultoAte'];
      }

      function anuncioOk() {
        return textoAte('titulo', 100)
            && textoAte('descricao', 1000)
            && textoAte('bairro', 60)
            && textoAte('cidade', 60)
            && textoAte('andar', 12)
            && textoAte('disponivel', 20)
            && listaAte('fotos', 5)
            && listaAte('caracteristicas', 20)
            && listaAte('condicoes', 12)
            && dataOuNulo('ocultoAte');
      }

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.donoId == request.auth.uid
                    && request.resource.data.tipo in ['imovel']
                    && request.resource.data.keys().hasOnly(camposAnuncio())
                    && naoTocaCamposProtegidosNoCreate()
                    && anuncioOk();

      allow update: if logado()
                    && emailOk()
                    && resource.data.donoId == request.auth.uid
                    && request.resource.data.donoId == resource.data.donoId
                    && request.resource.data.tipo == resource.data.tipo
                    && gravou().hasOnly(camposAnuncio())
                    && naoTocaCamposProtegidosNoUpdate()
                    && anuncioOk();

      allow delete: if logado()
                    && resource.data.donoId == request.auth.uid;

      // A equipe esconde (ocultoAte) o conteúdo de contas suspensas/banidas.
      allow update: if podeModerar()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ocultoAte'])
                    && dataOuNulo('ocultoAte');
    }


    // =====================================================
    // CONVERSAS
    // Documento: conversas/{uidMenor}_{uidMaior}
    // =====================================================
    match /conversas/{conversaId} {

      // Cada pessoa só mexe na própria marca de leitura / "digitando".
      function soMinhaChave(campo) {
        return !mudou().hasAny([campo])
            || (request.resource.data[campo] is map
                && request.resource.data[campo].diff(resource.data.get(campo, {})).affectedKeys().hasOnly([request.auth.uid]));
      }

      function contextoOk() {
        let c = request.resource.data.get('contexto', null);
        return c == null
            || (c is map && c.keys().hasOnly(['tipo', 'titulo'])
                && c.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis']
                && valorTextoAte(c.get('titulo', ''), 120));
      }

      // Conversa ainda não criada: só quem faz parte dela (o id tem os dois uids) pode consultar.
      allow get: if logado()
                 && ((resource == null && request.auth.uid in conversaId.split('_'))
                     || (resource != null && request.auth.uid in resource.data.participantes));

      allow list: if logado()
                  && request.auth.uid in resource.data.participantes;
      // A moderação vê quem conversa com quem (para a ficha e denúncias), mas não lista mensagens.
      allow read: if podeModerar();

      allow create: if logado()
                    && request.resource.data.participantes is list
                    && request.resource.data.participantes.size() == 2
                    && request.auth.uid in request.resource.data.participantes
                    && request.resource.data.participantes[0] < request.resource.data.participantes[1]
                    && conversaId == request.resource.data.participantes[0]
                                     + '_' + request.resource.data.participantes[1]
                    && !bloqueioEntre(request.resource.data.participantes[0],
                                      request.resource.data.participantes[1])
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['participantes', 'ultimaMensagem', 'atualizadoEm', 'contexto', 'criadoEm'])
                    && contextoOk()
                    && textoAte('ultimaMensagem', 200);

      // Com bloqueio entre os dois, ninguém mexe na conversa (evita "recado"
      // pelo resumo da última mensagem).
      allow update: if logado()
                    && request.auth.uid in resource.data.participantes
                    && request.resource.data.participantes == resource.data.participantes
                    && !bloqueioEntre(resource.data.participantes[0], resource.data.participantes[1])
                    && mudou().hasOnly(['ultimaMensagem', 'ultimaMensagemRemetenteId', 'atualizadoEm', 'lidoEm', 'vistoEm', 'digitando', 'contexto', 'arquivadaPara', 'ocultaPara', 'falaram', 'fixadaPara', 'silenciadaPara'])
                    // o resumo da última mensagem só pode ser escrito por quem mandou
                    && (!mudou().hasAny(['ultimaMensagem', 'ultimaMensagemRemetenteId'])
                        || request.resource.data.get('ultimaMensagemRemetenteId', '') == request.auth.uid)
                    && soMinhaChave('lidoEm')
                    && soMinhaChave('vistoEm')
                    && soMinhaChave('digitando')
                    // arquivar / apagar "só para mim": cada um mexe só na própria marca
                    && soMinhaChave('arquivadaPara')
                    && soMinhaChave('ocultaPara')
                    // fixar no topo / silenciar avisos: cada um só a própria marca
                    && soMinhaChave('fixadaPara')
                    && soMinhaChave('silenciadaPara')
                    // falaram: cada um marca só que ELE escreveu (usado para liberar avaliação e reclamação)
                    && soMinhaChave('falaram')
                    && (!mudou().hasAny(['falaram']) || request.resource.data.falaram[request.auth.uid] == true)
                    && (!mudou().hasAny(['contexto']) || contextoOk())
                    && textoAte('ultimaMensagem', 200);

      allow delete: if logado()
                    && request.auth.uid in resource.data.participantes;


      // ===================================================
      // MENSAGENS DA CONVERSA
      // ===================================================
      match /mensagens/{mensagemId} {

        function participante() {
          return request.auth.uid in
                 get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
        }

        function semBloqueio() {
          let p = get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
          return !bloqueioEntre(p[0], p[1]);
        }

        // A outra pessoa da conversa não pode estar com a conta desativada.
        function outroAtivo() {
          let p = get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
          return !desativada(p[0] == request.auth.uid ? p[1] : p[0]);
        }

        // Resposta (citação): precisa apontar para uma mensagem real desta conversa,
        // com o autor verdadeiro. Impede citar algo que a outra pessoa nunca disse.
        function respostaOk(r) {
          let caminho = /databases/$(database)/documents/conversas/$(conversaId)/mensagens/$(r.id);
          return r is map
              && r.keys().hasOnly(['id', 'texto', 'remetenteId'])
              && r.id is string
              && valorTextoAte(r.get('texto', ''), 200)
              && exists(caminho)
              && get(caminho).data.remetenteId == r.remetenteId;
        }

        function mensagemOk() {
          let d = request.resource.data;
          return d.keys().hasOnly(['remetenteId', 'texto', 'criadoEm', 'resposta', 'tipoArquivo', 'arquivoUrl', 'nomeArquivo', 'cartao', 'avaliacao'])
              && (!('tipoArquivo' in d) || d.tipoArquivo in ['imagem', 'video', 'audio', 'cartao', 'avaliacao'])
              // pedido de avaliação: aponta para um atendimento criado por quem envia
              && (!('avaliacao' in d)
                  || (d.avaliacao is map && d.get('tipoArquivo', '') == 'avaliacao'
                      && d.avaliacao.keys().hasOnly(['pedidoId', 'titulo', 'tipo', 'negocioNome'])
                      && get(/databases/$(database)/documents/pedidos/$(d.avaliacao.pedidoId)).data.vendedorId == request.auth.uid
                      && valorTextoAte(d.avaliacao.get('titulo', ''), 120)
                      && valorTextoAte(d.avaliacao.get('negocioNome', ''), 80)))
              // anexo: só do próprio site (dentro da mensagem ou Firebase Storage)
              && (!('arquivoUrl' in d)
                  || (d.arquivoUrl is string
                      && d.arquivoUrl.matches('^(data:(image|video|audio)/[^,]{1,80},|https://firebasestorage[.]googleapis[.]com/).*')))
              && (!('nomeArquivo' in d) || valorTextoAte(d.nomeArquivo, 120))
              && (!('cartao' in d) || (d.cartao is map && d.get('tipoArquivo', '') == 'cartao'))
              && (!('resposta' in d) || respostaOk(d.resposta));
        }

        allow read: if logado() && participante();
        // A moderação abre só a mensagem denunciada (uma por vez, sem listar a conversa).
        allow get: if podeModerar();

        allow create: if logado()
                      && emailOk()
                      && participante()
                      && semBloqueio()
                      && outroAtivo()
                      && ritmoOk('msg')
                      && request.resource.data.remetenteId == request.auth.uid
                      && request.resource.data.criadoEm == request.time
                      && textoAte('texto', 4000)
                      && mensagemOk();

        allow update: if false;

        allow delete: if logado()
                      && request.auth.uid == resource.data.remetenteId;
      }
    }


    // =====================================================
    // PEDIDOS / ATENDIMENTOS
    // O negócio registra o atendimento para pedir avaliação ao cliente.
    // Só vale entre pessoas que já conversam no chat.
    // =====================================================
    match /pedidos/{id} {

      allow read: if logado()
                  && (resource.data.vendedorId == request.auth.uid
                      || resource.data.clienteId == request.auth.uid);
      allow read: if admin();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['vendedorId', 'clienteId', 'negocioId', 'tipo', 'titulo', 'conversaId', 'criadoEm'])
                    && request.resource.data.vendedorId == request.auth.uid
                    && request.resource.data.clienteId is string
                    && request.resource.data.clienteId != request.auth.uid
                    && request.resource.data.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis']
                    && request.resource.data.negocioId == request.auth.uid + '_' + request.resource.data.tipo
                    && exists(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId))
                    && request.auth.uid in get(/databases/$(database)/documents/conversas/$(request.resource.data.conversaId)).data.participantes
                    && request.resource.data.clienteId in get(/databases/$(database)/documents/conversas/$(request.resource.data.conversaId)).data.participantes
                    && valorTextoAte(request.resource.data.get('titulo', ''), 120)
                    && request.resource.data.criadoEm == request.time
                    && !bloqueioEntre(request.auth.uid, request.resource.data.clienteId);

      allow update, delete: if false;
    }


    // =====================================================
    // AVALIAÇÕES
    //   n_{negocio}_{cliente}: cliente avalia o negócio — UMA por cliente em cada negócio
    //   c_{negocio}_{cliente}: negócio avalia o cliente — UMA por cliente em cada negócio
    //   d_{post}_{uid}       : alguém avalia uma publicação (1 vez por publicação)
    //   p_{pedido}_c / _v    : modelo antigo (1 por pedido). Continuam valendo, mas não
    //                          podem mais ser criados: pedir avaliação várias vezes para a
    //                          mesma pessoa não gera notas extras.
    // Para avaliar um negócio: e-mail confirmado, conta com 3 dias, os dois já escreveram
    // na conversa, não é o dono, sem vínculo aceito no Social e sem bloqueio.
    // n_ e c_ podem ser EDITADAS pelo autor (troca a nota no resumo, sem contar de novo).
    // =====================================================
    match /avaliacoes/{id} {

      function base() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tipo', 'autorId', 'autorNome', 'autorFoto', 'alvoId', 'negocioId', 'pedidoId', 'postId', 'nota', 'comentario', 'chaves', 'criadoEm'])
            && d.autorId == request.auth.uid
            && d.nota is int && d.nota >= 1 && d.nota <= 5
            && valorTextoAte(d.get('comentario', ''), 500)
            && valorTextoAte(d.get('autorNome', ''), 80)
            && fotoOk(d.get('autorFoto', ''))
            && d.criadoEm == request.time;
      }

      function resumoAtualizado(chave) {
        return getAfter(/databases/$(database)/documents/notas/$(chave)).data.ultima == id;
      }

      // "Atendimento confirmado": pedido real entre os dois, do mesmo negócio.
      function pedidoOk(d, cliente, negocioId) {
        return !('pedidoId' in d)
            || (get(/databases/$(database)/documents/pedidos/$(d.pedidoId)).data.clienteId == cliente
                && get(/databases/$(database)/documents/pedidos/$(d.pedidoId)).data.negocioId == negocioId);
      }

      function doCliente() {
        let d = request.resource.data;
        let dono = donoDoNegocio(d.negocioId);
        let eu = request.auth.uid;
        return id == 'n_' + d.negocioId + '_' + eu
            && d.alvoId == dono
            && dono != eu
            && d.chaves == ['neg_' + d.negocioId]
            && contaAntiga(eu)
            && falou(eu, dono, eu)
            && falou(eu, dono, dono)
            && !vinculados(eu, dono)
            && !bloqueioEntre(eu, dono)
            && pedidoOk(d, eu, d.negocioId)
            && resumoAtualizado('neg_' + d.negocioId);
      }

      function doVendedor() {
        let d = request.resource.data;
        let eu = request.auth.uid;
        return id == 'c_' + d.negocioId + '_' + d.alvoId
            && donoDoNegocio(d.negocioId) == eu
            && d.alvoId != eu
            && d.chaves == ['cli_' + d.alvoId]
            && falou(eu, d.alvoId, eu)
            && falou(eu, d.alvoId, d.alvoId)
            && !bloqueioEntre(eu, d.alvoId)
            && pedidoOk(d, d.alvoId, d.negocioId)
            && resumoAtualizado('cli_' + d.alvoId);
      }

      function daPublicacao() {
        let d = request.resource.data;
        let post = get(/databases/$(database)/documents/diario/$(d.postId)).data;
        return id == 'd_' + d.postId + '_' + request.auth.uid
            && post.autorId != request.auth.uid
            && d.alvoId == post.autorId
            && d.chaves == ['post_' + d.postId, 'pub_' + post.autorId]
            && resumoAtualizado('post_' + d.postId)
            && resumoAtualizado('pub_' + post.autorId);
      }

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && base()
                    && ((request.resource.data.tipo == 'negocio' && doCliente())
                        || (request.resource.data.tipo == 'cliente' && doVendedor())
                        || (request.resource.data.tipo == 'publicacao' && daPublicacao()));

      // Edição de n_ / c_ pelo próprio autor: só nota, comentário e (uma vez) o pedido confirmado.
      allow update: if logado()
                    && emailOk()
                    && resource.data.autorId == request.auth.uid
                    && (id.matches('^n_.*') || id.matches('^c_.*'))
                    && mudou().hasOnly(['nota', 'comentario', 'atualizadoEm', 'pedidoId'])
                    && request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
                    && valorTextoAte(request.resource.data.get('comentario', ''), 500)
                    && request.resource.data.atualizadoEm == request.time
                    && (!mudou().hasAny(['pedidoId'])
                        || (!('pedidoId' in resource.data)
                            && pedidoOk(request.resource.data, id.matches('^n_.*') ? request.auth.uid : resource.data.alvoId, resource.data.negocioId)))
                    && !bloqueioEntre(request.auth.uid, resource.data.alvoId)
                    // nota mudou: o resumo precisa trocar a nota antiga pela nova NESTA mesma gravação
                    && (request.resource.data.nota == resource.data.nota
                        || (getAfter(/databases/$(database)/documents/notas/$(resource.data.chaves[0])).data.ultima == id
                            && getAfter(/databases/$(database)/documents/notas/$(resource.data.chaves[0])).data.soma
                               == get(/databases/$(database)/documents/notas/$(resource.data.chaves[0])).data.soma
                                  - resource.data.nota + request.resource.data.nota));

      allow delete: if false;
    }


    // =====================================================
    // RESUMO DAS NOTAS (média e quantas de cada estrela)
    //   neg_{negocioId} · cli_{uid} · pub_{uid} · post_{postId}
    // Só aceita somar exatamente a avaliação nova gravada junto.
    // =====================================================
    match /notas/{chave} {

      function caminhoNova() {
        return /databases/$(database)/documents/avaliacoes/$(request.resource.data.ultima);
      }

      function avaliacaoNova() {
        return request.resource.data.ultima is string
            && !exists(caminhoNova())
            && existsAfter(caminhoNova())
            && getAfter(caminhoNova()).data.autorId == request.auth.uid
            && chave in getAfter(caminhoNova()).data.chaves;
      }

      function estrela() {
        return 'n' + string(getAfter(caminhoNova()).data.nota);
      }

      allow read: if logado();

      allow create: if logado()
                    && avaliacaoNova()
                    && request.resource.data.keys().hasOnly(['total', 'soma', 'n1', 'n2', 'n3', 'n4', 'n5', 'ultima', 'atualizadoEm'])
                    && request.resource.data.keys().hasAll(['total', 'soma', 'n1', 'n2', 'n3', 'n4', 'n5', 'ultima'])
                    && request.resource.data.total == 1
                    && request.resource.data.soma == getAfter(caminhoNova()).data.nota
                    && request.resource.data[estrela()] == 1
                    && request.resource.data.n1 + request.resource.data.n2 + request.resource.data.n3
                       + request.resource.data.n4 + request.resource.data.n5 == 1;

      allow update: if logado()
                    && avaliacaoNova()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'soma', 'ultima', 'atualizadoEm', estrela()])
                    && request.resource.data.total == resource.data.total + 1
                    && request.resource.data.soma == resource.data.soma + getAfter(caminhoNova()).data.nota
                    && request.resource.data[estrela()] == resource.data.get(estrela(), 0) + 1;

      // Edição de uma avaliação n_/c_: troca a nota antiga pela nova (o total não muda).
      function edicao() {
        let antes = get(caminhoNova()).data;
        let depois = getAfter(caminhoNova()).data;
        return request.resource.data.ultima is string
            && exists(caminhoNova())
            && depois.autorId == request.auth.uid
            && chave in depois.chaves
            && antes.nota != depois.nota
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soma', 'ultima', 'atualizadoEm', 'n' + string(antes.nota), 'n' + string(depois.nota)])
            && request.resource.data.total == resource.data.total
            && request.resource.data.soma == resource.data.soma - antes.nota + depois.nota
            && resource.data.get('n' + string(antes.nota), 0) >= 1
            && request.resource.data['n' + string(antes.nota)] == resource.data.get('n' + string(antes.nota), 0) - 1
            && request.resource.data['n' + string(depois.nota)] == resource.data.get('n' + string(depois.nota), 0) + 1;
      }

      allow update: if logado() && edicao();

      allow delete: if false;
    }


    // =====================================================
    // RECLAMAÇÕES: resposta pública do negócio
    // Reclamação = avaliação de negócio com nota 1 ou 2 (avaliacoes/{id}).
    // reclamacoes/{id da avaliação}: o negócio avaliado responde uma vez
    // (pode editar o texto) e o cliente que reclamou marca como resolvida.
    // =====================================================
    match /reclamacoes/{avalId} {

      allow read: if logado();

      function aval() {
        return get(/databases/$(database)/documents/avaliacoes/$(avalId)).data;
      }

      function respostaOk(d) {
        return d.texto is string && d.texto.size() >= 2 && d.texto.size() <= 1000;
      }

      allow create: if logado()
                    && emailOk()
                    && exists(/databases/$(database)/documents/avaliacoes/$(avalId))
                    && aval().tipo == 'negocio'
                    && aval().nota <= 2
                    && aval().alvoId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['texto', 'autorId', 'criadoEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && respostaOk(request.resource.data)
                    && request.resource.data.criadoEm == request.time;

      allow update: if logado()
                    && emailOk()
                    && request.resource.data.autorId == resource.data.autorId
                    && (
                      // o negócio corrige a resposta
                      (resource.data.autorId == request.auth.uid
                        && mudou().hasOnly(['texto', 'editadoEm'])
                        && respostaOk(request.resource.data)
                        && request.resource.data.editadoEm == request.time)
                      ||
                      // o cliente que reclamou marca como resolvida (ou não)
                      (aval().autorId == request.auth.uid
                        && mudou().hasOnly(['resolvido', 'resolvidoEm'])
                        && request.resource.data.resolvido is bool
                        && request.resource.data.resolvidoEm == request.time)
                    );

      allow delete: if false;
    }


    // =====================================================
    // RECLAMAÇÕES ABERTAS PELO CLIENTE (separadas da nota)
    // queixas/{negocioId}_{cliente}: uma por cliente em cada negócio.
    //   - abrir: e-mail confirmado, conta com 3 dias, já mandou mensagem ao negócio
    //     (o negócio não precisa ter respondido) e dentro da cota (cotas/{uid}).
    //   - o dono do negócio responde (pode corrigir a resposta);
    //   - só o cliente marca como resolvida; resolvida, pode reabrir (conta na cota).
    //   - ninguém apaga.
    // cotas/{uid}: no máximo 3 reclamações a cada 30 dias (janela que começa na primeira).
    // =====================================================
    match /queixas/{id} {

      function motivoOk(m) {
        return m in ['atraso', 'qualidade', 'cobranca', 'ausencia', 'atendimento', 'golpe', 'outro'];
      }

      function relatoOk(d) {
        return motivoOk(d.motivo)
            && d.texto is string && d.texto.size() >= 20 && d.texto.size() <= 1000
            && fotoOk(d.get('foto', ''));
      }

      // A cota foi atualizada nesta mesma gravação.
      function contou() {
        return getAfter(/databases/$(database)/documents/cotas/$(request.auth.uid)).data.ultimaEm == request.time;
      }

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['negocioId', 'alvoId', 'autorId', 'autorNome', 'negocioNome', 'tipo', 'motivo', 'texto', 'foto',
                                                              'status', 'abertaEm', 'criadoEm', 'aberturas', 'resposta', 'respondidaEm', 'resolvidaEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && id == request.resource.data.negocioId + '_' + request.auth.uid
                    && request.resource.data.alvoId == donoDoNegocio(request.resource.data.negocioId)
                    && request.resource.data.alvoId != request.auth.uid
                    && request.resource.data.tipo in ['servicos', 'delivery', 'lojinha', 'imoveis']
                    && relatoOk(request.resource.data)
                    && valorTextoAte(request.resource.data.get('autorNome', ''), 80)
                    && valorTextoAte(request.resource.data.get('negocioNome', ''), 80)
                    && request.resource.data.status == 'aberta'
                    && request.resource.data.aberturas == 1
                    && request.resource.data.get('resposta', null) == null
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.abertaEm == request.time
                    && contaAntiga(request.auth.uid)
                    && falou(request.auth.uid, request.resource.data.alvoId, request.auth.uid)
                    && contou();

      allow update: if logado()
                    && emailOk()
                    && request.resource.data.autorId == resource.data.autorId
                    && request.resource.data.alvoId == resource.data.alvoId
                    && request.resource.data.negocioId == resource.data.negocioId
                    && (
                      // o negócio responde ou corrige a resposta (enquanto está aberta)
                      (resource.data.alvoId == request.auth.uid
                        && resource.data.status == 'aberta'
                        && mudou().hasOnly(['resposta', 'respondidaEm'])
                        && request.resource.data.resposta is string
                        && request.resource.data.resposta.size() >= 2 && request.resource.data.resposta.size() <= 1000
                        && request.resource.data.respondidaEm == request.time)
                      ||
                      // o cliente marca como resolvida
                      (resource.data.autorId == request.auth.uid
                        && resource.data.status == 'aberta'
                        && mudou().hasOnly(['status', 'resolvidaEm'])
                        && request.resource.data.status == 'resolvida'
                        && request.resource.data.resolvidaEm == request.time)
                      ||
                      // o cliente reabre (com relato novo), contando na cota
                      (resource.data.autorId == request.auth.uid
                        && resource.data.status == 'resolvida'
                        && mudou().hasOnly(['motivo', 'texto', 'foto', 'status', 'abertaEm', 'aberturas', 'resposta', 'respondidaEm', 'resolvidaEm'])
                        && relatoOk(request.resource.data)
                        && request.resource.data.status == 'aberta'
                        && request.resource.data.abertaEm == request.time
                        && request.resource.data.aberturas == resource.data.get('aberturas', 1) + 1
                        && request.resource.data.get('resposta', null) == null
                        && contou())
                    );

      allow delete: if false;
    }

    match /cotas/{uid} {

      allow read: if logado() && request.auth.uid == uid;
      allow read: if admin();

      // Janela nova (primeira vez ou a anterior já passou de 30 dias): começa agora com 1.
      // Dentro da janela: soma 1, até 3.
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['inicio', 'n', 'ultimaEm'])
                    && request.resource.data.inicio == request.time
                    && request.resource.data.n == 1
                    && request.resource.data.ultimaEm == request.time;

      allow update: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['inicio', 'n', 'ultimaEm'])
                    && request.resource.data.ultimaEm == request.time
                    && ((resource.data.inicio < request.time - duration.value(30, 'd')
                         && request.resource.data.inicio == request.time
                         && request.resource.data.n == 1)
                        ||
                        (resource.data.inicio >= request.time - duration.value(30, 'd')
                         && request.resource.data.inicio == resource.data.inicio
                         && request.resource.data.n == resource.data.n + 1
                         && request.resource.data.n <= 3));

      allow delete: if false;
    }


    // =====================================================
    // DENÚNCIAS: denuncias/{tipo}_{item}_{quemDenunciou}
    // Uma por pessoa em cada item. Só quem denunciou consegue ler a própria
    // denúncia (para saber que já enviou). A equipe analisa pelo painel.
    // O item precisa ser mesmo de quem foi denunciado.
    // =====================================================
    match /denuncias/{id} {

      function itemDoAlvo(d) {
        return (d.tipo == 'perfil' && d.itemId == d.alvoId)
            || (d.tipo == 'publicacao' && get(/databases/$(database)/documents/diario/$(d.itemId)).data.autorId == d.alvoId)
            || (d.tipo == 'comentario' && get(/databases/$(database)/documents/comentarios/$(d.itemId)).data.autorId == d.alvoId)
            || (d.tipo == 'negocio' && get(/databases/$(database)/documents/negocios/$(d.itemId)).data.donoId == d.alvoId)
            || (d.tipo == 'mensagem'
                && d.conversaId is string
                && request.auth.uid in get(/databases/$(database)/documents/conversas/$(d.conversaId)).data.participantes
                && get(/databases/$(database)/documents/conversas/$(d.conversaId)/mensagens/$(d.itemId)).data.remetenteId == d.alvoId);
      }

      allow get: if logado() && resource.data.autorId == request.auth.uid;
      allow read: if admin();
      // A equipe registra a análise e quem assumiu o caso (para ninguém fazer o mesmo trabalho).
      allow update: if podeModerar()
                    && mudou().hasOnly(['status', 'acao', 'nota', 'analisadaEm', 'analisadaPor', 'responsavel', 'responsavelNome', 'assumidoEm'])
                    && request.resource.data.status in ['nova', 'em_analise', 'resolvida', 'descartada']
                    && (!mudou().hasAny(['status', 'acao', 'nota', 'analisadaEm', 'analisadaPor']) || request.resource.data.analisadaPor == request.auth.uid)
                    && responsavelOk()
                    && valorTextoAte(request.resource.data.get('nota', ''), 1000);

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['tipo', 'alvoId', 'itemId', 'conversaId', 'autorId', 'motivo', 'detalhe', 'trecho', 'status', 'criadoEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.alvoId is string
                    && request.resource.data.alvoId != request.auth.uid
                    && request.resource.data.itemId is string
                    && request.resource.data.tipo in ['perfil', 'publicacao', 'comentario', 'mensagem', 'negocio']
                    && id == request.resource.data.tipo + '_' + request.resource.data.itemId + '_' + request.auth.uid
                    && request.resource.data.motivo in ['golpe', 'falso', 'assedio', 'odio', 'improprio', 'spam', 'menor', 'outro']
                    && valorTextoAte(request.resource.data.get('detalhe', ''), 500)
                    && valorTextoAte(request.resource.data.get('trecho', ''), 300)
                    && request.resource.data.status == 'nova'
                    && request.resource.data.criadoEm == request.time
                    && itemDoAlvo(request.resource.data);

      allow delete: if false;
    }


    // =====================================================
    // ADMINISTRAÇÃO
    // admins/{uid}      : quem é da equipe (criado à mão no console do Firebase)
    // sancoes/{uid}     : suspensão (até uma data) ou banimento
    // avisos/{id}       : aviso da equipe para uma pessoa
    // comunicados/{id}  : faixa para todos (ex.: manutenção, novidade)
    // suporte/{id}      : chamados de suporte (+ mensagens)
    // parcerias/{id}    : interessados em ser sócio, investidor ou parceiro
    // admin_log/{id}    : registro de tudo o que a equipe faz
    // estatisticas/{dia}, relatorios/{id}: gravados pelo relatório automático (Admin SDK)
    // =====================================================
    match /admins/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }

    match /sancoes/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      allow read: if admin();
      allow create, update: if podeModerar()
                    && request.resource.data.keys().hasOnly(['tipo', 'motivo', 'ate', 'por', 'em', 'historico'])
                    && request.resource.data.tipo in ['suspensao', 'banimento']
                    && valorTextoAte(request.resource.data.get('motivo', ''), 500)
                    && (request.resource.data.tipo == 'banimento' || request.resource.data.ate is timestamp)
                    && request.resource.data.por == request.auth.uid
                    && request.resource.data.em == request.time
                    && listaAte('historico', 50);
      allow delete: if podeModerar();
    }

    match /avisos/{id} {
      allow read: if logado() && resource.data.uid == request.auth.uid;
      allow read: if admin();
      allow create: if admin()
                    && request.resource.data.keys().hasOnly(['uid', 'titulo', 'texto', 'tipo', 'por', 'em', 'lidoEm'])
                    && request.resource.data.uid is string
                    && valorTextoAte(request.resource.data.get('titulo', ''), 120)
                    && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
                    && request.resource.data.tipo in ['info', 'alerta', 'grave']
                    && request.resource.data.por == request.auth.uid
                    && request.resource.data.em == request.time
                    && request.resource.data.lidoEm == null;
      // quem recebeu marca como lido
      allow update: if logado()
                    && resource.data.uid == request.auth.uid
                    && mudou().hasOnly(['lidoEm'])
                    && request.resource.data.lidoEm == request.time;
      allow delete: if false;
    }

    match /comunicados/{id} {
      allow read: if logado();
      allow create, update: if podeModerar()
                    && request.resource.data.keys().hasOnly(['titulo', 'texto', 'tipo', 'ativo', 'link', 'por', 'em', 'ate'])
                    && valorTextoAte(request.resource.data.get('titulo', ''), 120)
                    && valorTextoAte(request.resource.data.get('texto', ''), 600)
                    && request.resource.data.tipo in ['info', 'novidade', 'alerta']
                    && request.resource.data.ativo is bool
                    && request.resource.data.por == request.auth.uid;
      allow delete: if podeModerar();
    }

    match /suporte/{id} {
      function camposChamado() {
        return ['uid', 'nome', 'email', 'assunto', 'categoria', 'status', 'criadoEm', 'atualizadoEm', 'ultimaDe', 'atendidoPor', 'responsavel', 'responsavelNome', 'assumidoEm'];
      }
      allow read: if logado() && resource.data.uid == request.auth.uid;
      allow read: if admin();
      // Abrir chamado: não exige e-mail confirmado nem conta livre (quem foi suspenso pode contestar).
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(camposChamado())
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.assunto is string && request.resource.data.assunto.size() >= 3 && request.resource.data.assunto.size() <= 120
                    && request.resource.data.categoria in ['conta', 'pagamento', 'golpe', 'denuncia', 'contestacao', 'negocio', 'sugestao', 'outro']
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && valorTextoAte(request.resource.data.get('email', ''), 120)
                    && request.resource.data.status == 'aberto'
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.atualizadoEm == request.time
                    && request.resource.data.ultimaDe == 'usuario'
                    && !request.resource.data.keys().hasAny(['atendidoPor', 'responsavel', 'responsavelNome', 'assumidoEm']);
      allow update: if logado()
                    && ((resource.data.uid == request.auth.uid
                         && mudou().hasOnly(['status', 'atualizadoEm', 'ultimaDe'])
                         && request.resource.data.status in ['aberto', 'fechado']
                         && request.resource.data.ultimaDe == 'usuario')
                        || (admin()
                         && mudou().hasOnly(['status', 'atualizadoEm', 'ultimaDe', 'atendidoPor', 'responsavel', 'responsavelNome', 'assumidoEm'])
                         && request.resource.data.status in ['aberto', 'respondido', 'fechado']
                         && responsavelOk()))
                    && request.resource.data.atualizadoEm == request.time;
      // A equipe só assume ou passa o chamado (sem mexer na data da conversa).
      allow update: if admin()
                    && mudou().hasOnly(['responsavel', 'responsavelNome', 'assumidoEm'])
                    && responsavelOk();
      allow delete: if false;

      match /mensagens/{msgId} {
        function chamado() { return get(/databases/$(database)/documents/suporte/$(id)).data; }
        // getAfter: o chamado e a primeira mensagem são gravados juntos (tudo ou nada).
        function chamadoDepois() { return getAfter(/databases/$(database)/documents/suporte/$(id)).data; }
        allow read: if logado() && (chamado().uid == request.auth.uid || admin());
        allow create: if logado()
                      && (chamadoDepois().uid == request.auth.uid || admin())
                      && request.resource.data.keys().hasOnly(['autorId', 'equipe', 'texto', 'em'])
                      && request.resource.data.autorId == request.auth.uid
                      // "equipe" (resposta oficial) só quem é da equipe; no próprio chamado, todos escrevem como usuário
                      && (request.resource.data.equipe == false || (request.resource.data.equipe == true && admin()))
                      && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 2000
                      && request.resource.data.em == request.time;
        allow update, delete: if false;
      }
    }

    match /parcerias/{id} {
      // Formulário público (Sócios e parcerias): qualquer pessoa envia, só a equipe lê.
      allow create: if request.resource.data.keys().hasOnly(['nome', 'empresa', 'email', 'telefone', 'tipo', 'mensagem', 'site', 'cidade', 'uid', 'status', 'criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
                    && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') && request.resource.data.email.size() <= 120
                    && valorTextoAte(request.resource.data.get('empresa', ''), 100)
                    && valorTextoAte(request.resource.data.get('telefone', ''), 30)
                    && valorTextoAte(request.resource.data.get('site', ''), 200)
                    && valorTextoAte(request.resource.data.get('cidade', ''), 80)
                    && request.resource.data.tipo in ['socio', 'investidor', 'parceiro', 'anunciante', 'imprensa', 'outro']
                    && request.resource.data.mensagem is string && request.resource.data.mensagem.size() >= 10 && request.resource.data.mensagem.size() <= 2000
                    && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid))
                    && request.resource.data.status == 'novo'
                    && request.resource.data.criadoEm == request.time;
      allow read: if admin();
      allow update: if podeComercial()
                    && mudou().hasOnly(['status', 'notas', 'atualizadoEm', 'responsavel', 'responsavelNome', 'assumidoEm'])
                    && request.resource.data.status in ['novo', 'em_conversa', 'proposta', 'fechado', 'recusado']
                    && (!mudou().hasAny(['responsavelNome', 'assumidoEm']) || responsavelOk())
                    && valorTextoAte(request.resource.data.get('notas', ''), 3000);
      allow delete: if podeComercial();
    }

    // Presença da equipe no painel (quem está online) e chat interno da equipe.
    match /equipe_presenca/{uid} {
      allow read: if admin();
      allow create, update: if admin()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['nome', 'em', 'secao', 'item', 'itemNome'])
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && valorTextoAte(request.resource.data.get('secao', ''), 40)
                    && valorTextoAte(request.resource.data.get('item', null), 160)
                    && valorTextoAte(request.resource.data.get('itemNome', null), 120)
                    && request.resource.data.em == request.time;
      allow delete: if admin() && request.auth.uid == uid;
    }

    match /equipe_chat/{id} {
      allow read: if admin();
      allow create: if admin()
                    && request.resource.data.keys().hasOnly(['autorId', 'nome', 'texto', 'em'])
                    && request.resource.data.autorId == request.auth.uid
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 2000
                    && request.resource.data.em == request.time;
      allow update, delete: if false;
    }

    // Quadro de tarefas da equipe: quem faz o quê.
    match /equipe_tarefas/{id} {
      function tarefaOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['titulo', 'descricao', 'status', 'prioridade', 'responsavel', 'responsavelNome', 'prazo', 'ligacao', 'ligacaoNome', 'criadoPor', 'criadoPorNome', 'criadoEm', 'atualizadoEm', 'concluidaEm'])
            && d.titulo is string && d.titulo.size() >= 2 && d.titulo.size() <= 140
            && valorTextoAte(d.get('descricao', null), 2000)
            && d.status in ['a_fazer', 'fazendo', 'feito']
            && d.prioridade in ['baixa', 'normal', 'alta', 'urgente']
            && (d.get('responsavel', null) == null || (d.responsavel is string && exists(/databases/$(database)/documents/admins/$(d.responsavel))))
            && valorTextoAte(d.get('responsavelNome', null), 80)
            && (d.get('prazo', null) == null || d.prazo is timestamp)
            && valorTextoAte(d.get('ligacao', null), 160)
            && valorTextoAte(d.get('ligacaoNome', null), 120)
            && valorTextoAte(d.get('criadoPorNome', null), 80)
            && d.atualizadoEm == request.time;
      }
      allow read: if admin();
      allow create: if admin() && tarefaOk()
                    && request.resource.data.criadoPor == request.auth.uid
                    && request.resource.data.criadoEm == request.time;
      allow update: if admin() && tarefaOk()
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if admin() && (resource.data.criadoPor == request.auth.uid || papel() == 'dono');
    }

    // Notas internas da equipe sobre um usuário (só a equipe vê; ninguém edita).
    match /notas_internas/{id} {
      allow read: if admin();
      allow create: if admin()
                    && request.resource.data.keys().hasOnly(['alvo', 'texto', 'autorId', 'autorNome', 'em'])
                    && request.resource.data.alvo is string && request.resource.data.alvo.size() <= 128
                    && request.resource.data.autorId == request.auth.uid
                    && valorTextoAte(request.resource.data.get('autorNome', null), 80)
                    && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 2000
                    && request.resource.data.em == request.time;
      allow update: if false;
      allow delete: if admin() && (resource.data.autorId == request.auth.uid || papel() == 'dono');
    }

    match /admin_log/{id} {
      allow read: if admin();
      allow create: if admin()
                    && request.resource.data.por == request.auth.uid
                    && request.resource.data.em == request.time
                    && request.resource.data.acao is string && request.resource.data.acao.size() <= 60
                    && valorTextoAte(request.resource.data.get('detalhe', ''), 1000);
      allow update, delete: if false;
    }

    match /estatisticas/{id} {
      allow read: if admin();
      allow write: if false;
    }

    match /relatorios/{id} {
      allow read: if admin();
      allow write: if false;
    }


    // =====================================================
    // LIMITE DIÁRIO (anti-spam): ritmo/{uid}
    // Janela de 24 h a partir da primeira ação. Por janela: até 500 mensagens,
    // 20 publicações e 200 comentários. Cada ação soma exatamente 1 no seu tipo.
    // =====================================================
    match /ritmo/{uid} {
      function limite(t) {
        return t == 'msg' ? 500 : (t == 'pub' ? 20 : 200);
      }
      function janelaNova() {
        return resource == null || resource.data.inicio < request.time - duration.value(1, 'd');
      }
      function contaOk(k, t) {
        let v = request.resource.data.get(k, 0);
        return v is int
            && v == (k == t ? (janelaNova() ? 1 : resource.data.get(k, 0) + 1)
                            : (janelaNova() ? 0 : resource.data.get(k, 0)));
      }
      allow get: if logado() && request.auth.uid == uid;
      allow read: if admin();
      allow create, update: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['inicio', 'msg', 'pub', 'com', 'ultimaEm', 'ultimoTipo'])
                    && request.resource.data.ultimoTipo in ['msg', 'pub', 'com']
                    && request.resource.data.ultimaEm == request.time
                    && request.resource.data.inicio == (janelaNova() ? request.time : resource.data.inicio)
                    && contaOk('msg', request.resource.data.ultimoTipo)
                    && contaOk('pub', request.resource.data.ultimoTipo)
                    && contaOk('com', request.resource.data.ultimoTipo)
                    && request.resource.data.get(request.resource.data.ultimoTipo, 0) <= limite(request.resource.data.ultimoTipo);
      allow delete: if false;
    }


    // =====================================================
    // PEDIDOS DE EXCLUSÃO DE CONTA: exclusoes/{uid}
    // A pessoa pede a exclusão; durante 30 dias pode recuperar a conta (apaga este
    // documento). Depois disso a limpeza automática (Admin SDK, fora das regras)
    // apaga a conta e os dados e anonimiza avaliações e reclamações.
    // =====================================================
    match /exclusoes/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      allow read: if admin();
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['pedidaEm', 'motivo'])
                    && request.resource.data.pedidaEm == request.time
                    && valorTextoAte(request.resource.data.get('motivo', ''), 300);
      allow update: if false;
      allow delete: if logado() && request.auth.uid == uid;
    }


    // =====================================================
    // ESTRELAS NAS PUBLICAÇÕES: curtidas/{postId}_{uid}
    // Nota de 1 a 5, uma por pessoa em cada publicação. A pessoa pode
    // trocar a nota ou tirar. Ninguém dá estrelas na própria publicação.
    // =====================================================
    match /curtidas/{id} {

      allow read: if logado();

      function notaOk(d) {
        return d.nota is int && d.nota >= 1 && d.nota <= 5;
      }

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['postId', 'uid', 'postAutorId', 'nota', 'criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && id == request.resource.data.postId + '_' + request.auth.uid
                    && exists(/databases/$(database)/documents/diario/$(request.resource.data.postId))
                    && get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data.autorId == request.resource.data.postAutorId
                    && request.resource.data.postAutorId != request.auth.uid
                    && notaOk(request.resource.data)
                    && !bloqueioEntre(request.auth.uid, request.resource.data.postAutorId)
                    && request.resource.data.criadoEm == request.time;

      allow update: if logado()
                    && emailOk()
                    && resource.data.uid == request.auth.uid
                    && mudou().hasOnly(['nota', 'atualizadoEm'])
                    && notaOk(request.resource.data)
                    && request.resource.data.atualizadoEm == request.time;

      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }

    // =====================================================
    // COMENTÁRIOS: comentarios/{id}
    // - Resposta: respostaA = id do comentário respondido (mesma publicação)
    //   e respostaAutorId = autor dele (para o aviso).
    // - Quem comentou edita o texto. O dono da publicação oculta um comentário.
    // - Quem comentou ou o dono da publicação apaga.
    // - Publicação com comentários ocultos não recebe comentários novos.
    // =====================================================
    match /comentarios/{id} {

      allow read: if logado();

      function textoComentarioOk(d) {
        return d.texto is string && d.texto.size() >= 1 && d.texto.size() <= 500;
      }

      function respostaOk(d) {
        return (!('respostaA' in d) && !('respostaAutorId' in d))
            || (d.respostaA is string
                && exists(/databases/$(database)/documents/comentarios/$(d.respostaA))
                && get(/databases/$(database)/documents/comentarios/$(d.respostaA)).data.postId == d.postId
                && d.respostaAutorId == get(/databases/$(database)/documents/comentarios/$(d.respostaA)).data.autorId);
      }

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['postId', 'postAutorId', 'autorId', 'nome', 'foto', 'texto', 'respostaA', 'respostaAutorId', 'criadoEm'])
                    && request.resource.data.autorId == request.auth.uid
                    && textoComentarioOk(request.resource.data)
                    && valorTextoAte(request.resource.data.get('nome', ''), 80)
                    && fotoOk(request.resource.data.get('foto', ''))
                    && exists(/databases/$(database)/documents/diario/$(request.resource.data.postId))
                    && get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data.autorId == request.resource.data.postAutorId
                    && get(/databases/$(database)/documents/diario/$(request.resource.data.postId)).data.get('comentariosOcultos', false) != true
                    && respostaOk(request.resource.data)
                    && !bloqueioEntre(request.auth.uid, request.resource.data.postAutorId)
                    && ritmoOk('com')
                    && request.resource.data.criadoEm == request.time;

      allow update: if logado()
                    && emailOk()
                    && (
                      // quem comentou corrige o texto
                      (resource.data.autorId == request.auth.uid
                        && mudou().hasOnly(['texto', 'editadoEm'])
                        && textoComentarioOk(request.resource.data)
                        && request.resource.data.editadoEm == request.time)
                      ||
                      // o dono da publicação oculta ou mostra o comentário
                      (resource.data.postAutorId == request.auth.uid
                        && mudou().hasOnly(['oculto'])
                        && request.resource.data.oculto is bool)
                    );

      allow delete: if logado()
                    && (resource.data.autorId == request.auth.uid || resource.data.postAutorId == request.auth.uid);
      allow delete: if podeModerar();
    }

    // =====================================================
    // CURTIDAS EM COMENTÁRIOS: curtidas_comentarios/{comentarioId}_{uid}
    // =====================================================
    match /curtidas_comentarios/{id} {

      allow read: if logado();

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.keys().hasOnly(['comentarioId', 'uid', 'criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && id == request.resource.data.comentarioId + '_' + request.auth.uid
                    && exists(/databases/$(database)/documents/comentarios/$(request.resource.data.comentarioId))
                    && request.resource.data.criadoEm == request.time;

      allow update: if false;
      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }


    // =====================================================
    // DIÁRIO / PUBLICAÇÕES
    // =====================================================
    match /diario/{postId} {

      allow read: if logado();

      function publicacaoOk() {
        let d = request.resource.data;
        return textoAte('texto', 1000)
            && textoAte('nome', 80)
            && campoFotoOk('fotoPerfil')
            && (!('mediaTipo' in d) || d.mediaTipo in ['', 'image', 'video'])
            && (!('mediaUrl' in d) || d.mediaUrl == ''
                || (d.mediaUrl is string
                    && d.mediaUrl.matches('^(data:image/(jpeg|png|webp);base64,|https://firebasestorage[.]googleapis[.]com/).*')));
      }

      allow create: if logado()
                    && emailOk()
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['autorId', 'nome', 'fotoPerfil', 'texto', 'mediaUrl', 'mediaTipo', 'criadoEm'])
                    && ritmoOk('pub')
                    && publicacaoOk();

      allow update: if logado()
                    && emailOk()
                    && resource.data.autorId == request.auth.uid
                    && request.resource.data.autorId == resource.data.autorId
                    && gravou().hasOnly(['texto', 'nome', 'fotoPerfil', 'comentariosOcultos', 'ocultoAte', 'editadoEm'])
                    && dataOuNulo('ocultoAte')
                    // texto editado: marca a data da edição
                    && (!mudou().hasAny(['texto']) || request.resource.data.get('editadoEm', null) == request.time)
                    && (!mudou().hasAny(['editadoEm']) || request.resource.data.editadoEm == request.time)
                    && (!('comentariosOcultos' in request.resource.data) || request.resource.data.comentariosOcultos is bool)
                    && publicacaoOk();

      allow delete: if logado()
                    && resource.data.autorId == request.auth.uid;

      // A equipe esconde ou remove publicações que violam os Termos.
      allow update: if podeModerar()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ocultoAte'])
                    && dataOuNulo('ocultoAte');
      allow delete: if podeModerar();
    }
  }
}
