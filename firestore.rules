rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Campos que só podem ser alterados pelo painel/admin (Admin SDK ignora as regras).
    function camposProtegidos() {
      return ['verificado', 'avaliacaoMedia', 'totalAvaliacoes'];
    }

    function naoTocaCamposProtegidosNoCreate() {
      return !request.resource.data.keys().hasAny(camposProtegidos());
    }

    function naoTocaCamposProtegidosNoUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(camposProtegidos());
    }


    // =====================================================
    // DADOS PRIVADOS DOS USUÁRIOS
    // Cada usuário só pode acessar os próprios dados.
    // =====================================================
    match /usuarios/{userId} {

      allow read: if logado()
                  && request.auth.uid == userId;

      allow create: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.aceiteTermos == true
                    && naoTocaCamposProtegidosNoCreate();

      allow update: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && naoTocaCamposProtegidosNoUpdate();

      allow delete: if logado()
                    && request.auth.uid == userId;
    }


    // =====================================================
    // PERFIL PÚBLICO
    // Usado somente para busca e exibição pública.
    // NÃO deve conter e-mail, telefone ou data de nascimento.
    // =====================================================
    match /perfis_publicos/{userId} {

      allow read: if logado();

      allow create: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && naoTocaCamposProtegidosNoCreate();

      allow update: if logado()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && naoTocaCamposProtegidosNoUpdate();

      allow delete: if logado()
                    && request.auth.uid == userId;
    }


    // =====================================================
    // RESERVA DE NICKNAMES
    // Necessário para impedir dois usuários de usarem
    // o mesmo nome de usuário.
    // =====================================================
    match /nicknames/{nickname} {

      allow read: if true;

      allow create: if logado()
                    && request.auth.uid == request.resource.data.uid
                    && nickname.matches('^[a-z0-9._]{3,20}$');

      allow update: if false;

      allow delete: if logado()
                    && request.auth.uid == resource.data.uid;
    }


    // =====================================================
    // SEGUIDORES
    // Documento: relacoes/{seguidorId}_{alvoId}
    // =====================================================
    match /relacoes/{id} {

      allow read: if logado();

      allow create: if logado()
                    && request.resource.data.tipo == 'seguir'
                    && request.resource.data.seguidorId == request.auth.uid
                    && request.resource.data.alvoId is string
                    && request.resource.data.alvoId != request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.alvoId;

      allow update: if false;

      allow delete: if logado()
                    && resource.data.seguidorId == request.auth.uid;
    }


    // =====================================================
    // CONVERSAS
    // Somente participantes podem acessar a conversa.
    // Documento: conversas/{uidMenor}_{uidMaior}
    // =====================================================
    match /conversas/{conversaId} {

      // resource == null permite o getDoc() de uma conversa que ainda
      // não existe (usado antes de criá-la), sem vazar conversas alheias.
      allow get: if logado()
                 && (resource == null
                     || request.auth.uid in resource.data.participantes);

      // Consulta "where participantes array-contains meuUid".
      allow list: if logado()
                  && request.auth.uid in resource.data.participantes;

      allow create: if logado()
                    && request.resource.data.participantes is list
                    && request.resource.data.participantes.size() == 2
                    && request.auth.uid in request.resource.data.participantes
                    && conversaId == request.resource.data.participantes[0]
                                     + '_' + request.resource.data.participantes[1];

      // Participantes não podem ser trocados depois de criada.
      allow update: if logado()
                    && request.auth.uid in resource.data.participantes
                    && request.resource.data.participantes == resource.data.participantes;

      allow delete: if logado()
                    && request.auth.uid in resource.data.participantes;


      // ===================================================
      // MENSAGENS DA CONVERSA
      // ===================================================
      match /mensagens/{mensagemId} {

        function participante() {
          return request.auth.uid in
                 get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
        }

        allow read: if logado() && participante();

        allow create: if logado()
                      && participante()
                      && request.resource.data.remetenteId == request.auth.uid;

        allow update: if false;

        allow delete: if logado()
                      && request.auth.uid == resource.data.remetenteId;
      }
    }


    // =====================================================
    // DIÁRIO / PUBLICAÇÕES
    // =====================================================
    match /diario/{postId} {

      allow read: if logado();

      allow create: if logado()
                    && request.resource.data.autorId == request.auth.uid;

      allow update: if logado()
                    && resource.data.autorId == request.auth.uid
                    && request.resource.data.autorId == resource.data.autorId;

      allow delete: if logado()
                    && resource.data.autorId == request.auth.uid;
    }
  }
}
