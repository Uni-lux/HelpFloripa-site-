// Regras guardadas para a próxima atualização (25/11/2026): tiradas do firestore.rules porque o Firebase
// recusa regras com mais de 256.000 bytes compilados. Para voltar: colar cada bloco no mesmo lugar do firestore.rules
// (ocorrências logo antes de '// RG do pet: o dono cadastra') e rodar os testes.

// (Entregas e corridas voltaram em 25/11/2026, com as mudanças feitas pelo servidor: functions/corridas.js.)

// ===== ROUBOS, VEÍCULOS E DESAPARECIDOS =====
    // Ocorrências (roubo, furto, golpe, suspeita). Anônima = sem autorId; quem fez fica em ocorrencias_autoria/{id}
    // (só a pessoa e a moderação leem) e é por ele que a pessoa marca "recuperado".
    function autorOcorrencia(oc) {
      let a = /databases/$(database)/documents/ocorrencias_autoria/$(oc);
      return exists(a) && get(a).data.uid == request.auth.uid;
    }
    match /ocorrencias/{id} {
      function d() { return request.resource.data; }
      allow get, list: if logado() && (resource.data.status == 'ativo' || resource.data.autorId == request.auth.uid || podeModerar() || autorOcorrencia(id));
      allow create: if logado() && emailOk()
                    && d().keys().hasOnly(['autorId', 'autorNome', 'anonimo', 'tipo', 'objeto', 'identificador', 'descricao', 'foto', 'quando', 'lat', 'lng', 'geo4', 'bairro', 'cidade', 'uf', 'status', 'criadoEm', 'atualizadoEm', 'veiculo'])
                    && (!('veiculo' in d()) || veiculoOcOk(d().veiculo))
                    && d().anonimo is bool
                    && (d().anonimo
                        ? (d().autorId == '' && !('autorNome' in d())
                           && getAfter(/databases/$(database)/documents/ocorrencias_autoria/$(id)).data.uid == request.auth.uid)
                        : (d().autorId == request.auth.uid && valorTextoAte(d().get('autorNome', ''), 80)))
                    && d().tipo in ['roubo', 'furto', 'golpe', 'suspeita']
                    && d().objeto in ['celular', 'bike', 'carro', 'moto', 'notebook', 'documento', 'pet', 'outro']
                    && d().identificador is string && d().identificador.matches('^[A-Z0-9]{0,40}$')
                    && d().descricao is string && d().descricao.size() >= 10 && d().descricao.size() <= 500
                    && (!('foto' in d()) || (fotoOk(d().foto) && d().foto.size() <= 300000))
                    && d().quando is timestamp && d().quando <= request.time
                    && pontoAproxOk(d())
                    && valorTextoAte(d().get('bairro', ''), 60) && valorTextoAte(d().get('cidade', ''), 60) && valorTextoAte(d().get('uf', ''), 2)
                    && d().status == 'ativo' && d().criadoEm == request.time && d().atualizadoEm == request.time;
      allow update: if logado() && mudou().hasOnly(['status', 'atualizadoEm']) && d().atualizadoEm == request.time
                    && ((d().status in ['recuperado', 'removido'] && (resource.data.autorId == request.auth.uid || autorOcorrencia(id)))
                        || (podeModerar() && d().status in ['ativo', 'removido']));
      allow delete: if false;
      // Pistas ("eu vi"): só quem fez a ocorrência e a moderação leem. Anônima = sem uid/nome (a autoria fica em
      // pistas_autoria, só para a moderação).
      match /pistas/{p} {
        allow read: if logado() && (get(/databases/$(database)/documents/ocorrencias/$(id)).data.autorId == request.auth.uid || autorOcorrencia(id) || podeModerar());
        allow create: if logado() && emailOk()
                      && get(/databases/$(database)/documents/ocorrencias/$(id)).data.status == 'ativo'
                      && request.resource.data.keys().hasOnly(['texto', 'anonimo', 'uid', 'nome', 'criadoEm'])
                      && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 400
                      && request.resource.data.anonimo is bool
                      && (request.resource.data.anonimo
                          ? (!('uid' in request.resource.data) && !('nome' in request.resource.data)
                             && getAfter(/databases/$(database)/documents/pistas_autoria/$(id + '_' + p)).data.uid == request.auth.uid)
                          : (request.resource.data.uid == request.auth.uid && valorTextoAte(request.resource.data.get('nome', ''), 80)))
                      && request.resource.data.criadoEm == request.time;
        allow update, delete: if false;
      }
    }
    // Carro/moto da ocorrência (18/11/2026): marca, modelo, ano e cor para achar anúncios parecidos (a placa vai no
    // identificador, como antes).
    function veiculoOcOk(v) {
      return v is map && v.keys().hasOnly(['marca', 'modelo', 'ano', 'cor'])
          && valorTextoAte(v.get('marca', ''), 30) && valorTextoAte(v.get('modelo', ''), 40) && valorTextoAte(v.get('cor', ''), 20)
          && v.get('ano', '') is string && v.get('ano', '').matches('^([0-9]{4})?$');
    }

    // VEÍCULOS (18/11/2026): o carro/moto da pessoa, com a placa. Só o dono e a moderação leem.
    // SHA-256 de "hf-veiculo:" + placa no padrão Mercosul (a antiga ABC1234 vira ABC1C34), igual ao veiculos-base.js.
    function hashDaPlaca(p) {
      let q = p[4:5].matches('[0-9]') ? p[0:4] + 'ABCDEFGHIJ'[int(p[4:5]):int(p[4:5]) + 1] + p[5:7] : p;
      return hashing.sha256('hf-veiculo:' + q).toHexString().lower();
    }
    match /veiculos/{id} {
      function d() { return request.resource.data; }
      allow get, list: if logado() && (resource.data.donoId == request.auth.uid || podeModerar());
      allow create, update: if logado() && emailOk() && d().donoId == request.auth.uid
                    && (resource == null || resource.data.donoId == request.auth.uid)
                    && d().keys().hasOnly(['donoId', 'tipo', 'placa', 'placaHash', 'marca', 'modelo', 'ano', 'cor', 'apelido', 'chassiFim', 'status', 'ocorrenciaId', 'roubadoEm', 'criadoEm', 'atualizadoEm'])
                    && d().tipo in ['carro', 'moto']
                    && d().placa is string && d().placa.matches('^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$')
                    && d().placaHash is string && d().placaHash.matches('^[a-f0-9]{64}$')
                    && d().placaHash == hashDaPlaca(d().placa)
                    && valorTextoAte(d().get('marca', ''), 30) && valorTextoAte(d().get('modelo', ''), 40) && valorTextoAte(d().get('cor', ''), 20)
                    && valorTextoAte(d().get('apelido', ''), 30)
                    && d().get('ano', '') is string && d().get('ano', '').matches('^([0-9]{4})?$')
                    && d().get('chassiFim', '') is string && d().get('chassiFim', '').matches('^[A-Z0-9]{0,6}$')
                    && d().status in ['ok', 'roubado', 'recuperado']
                    && valorTextoAte(d().get('ocorrenciaId', ''), 40)
                    && d().atualizadoEm == request.time
                    && (resource == null ? d().criadoEm == request.time : d().criadoEm == resource.data.criadoEm);
      allow delete: if logado() && resource.data.donoId == request.auth.uid;
    }
    // Índice dos carros/motos à venda (Shopping e Automotivo): só o HASH da placa, nunca a placa. Quem tem a placa acha o
    // anúncio (dono do carro roubado, a equipe, quem vai comprar). Só o dono do negócio cria; a moderação apaga.
    match /veiculos_venda/{id} {
      function d() { return request.resource.data; }
      allow get, list: if logado();
      allow create, update: if logado() && emailOk() && d().donoId == request.auth.uid
                    && (resource == null || resource.data.donoId == request.auth.uid)
                    && d().negocioId is string && d().negocioId.matches('^' + request.auth.uid + '_(lojinha|automotivo)$')
                    && id == d().negocioId + '_' + d().placaHash[0:16]
                    && d().keys().hasOnly(['negocioId', 'donoId', 'tipoNegocio', 'item', 'tipo', 'placaHash', 'marca', 'modelo', 'ano', 'cor', 'cidade', 'uf', 'criadoEm', 'atualizadoEm'])
                    && d().tipoNegocio in ['lojinha', 'automotivo'] && d().tipo in ['carro', 'moto']
                    && d().placaHash is string && d().placaHash.matches('^[a-f0-9]{64}$')
                    && valorTextoAte(d().get('item', ''), 60) && valorTextoAte(d().get('marca', ''), 30) && valorTextoAte(d().get('modelo', ''), 40)
                    && valorTextoAte(d().get('cor', ''), 20) && valorTextoAte(d().get('cidade', ''), 60) && valorTextoAte(d().get('uf', ''), 2)
                    && d().get('ano', '') is string && d().get('ano', '').matches('^([0-9]{4})?$')
                    && d().atualizadoEm == request.time
                    && (resource == null ? d().criadoEm == request.time : d().criadoEm == resource.data.criadoEm);
      allow delete: if logado() && (resource.data.donoId == request.auth.uid || podeModerar());
    }

    match /ocorrencias_autoria/{id} {
      allow get: if logado() && (resource.data.uid == request.auth.uid || podeModerar());
      allow list: if podeModerar();
      allow create: if logado() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/ocorrencias/$(id))
                    && getAfter(/databases/$(database)/documents/ocorrencias/$(id)).data.anonimo == true;
      allow update, delete: if false;
    }
    match /pistas_autoria/{id} {
      allow read: if podeModerar();
      allow create: if logado() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
                    && id.split('_').size() == 2
                    && !exists(/databases/$(database)/documents/ocorrencias/$(id.split('_')[0])/pistas/$(id.split('_')[1]))
                    && getAfter(/databases/$(database)/documents/ocorrencias/$(id.split('_')[0])/pistas/$(id.split('_')[1])).data.anonimo == true;
      allow update, delete: if false;
    }

    // DESAPARECIDOS (18/11/2026): aviso de pessoa desaparecida com o número do boletim de ocorrência. Nasce "analise" e só
    // a equipe publica ("ativo") depois de conferir — evita usar o site para achar quem fugiu de uma situação de violência.
    // Quem registrou e a moderação leem sempre; os outros só o publicado. Pistas como nas ocorrências (anônima = autoria
    // só para a moderação).
    match /desaparecidos/{id} {
      function d() { return request.resource.data; }
      allow get, list: if logado() && (resource.data.status == 'ativo' || resource.data.autorId == request.auth.uid || podeModerar());
      allow create: if logado() && emailOk() && d().autorId == request.auth.uid
                    && d().keys().hasOnly(['autorId', 'autorNome', 'nome', 'idade', 'condicao', 'parentesco', 'descricao', 'sinais', 'visto', 'quando', 'bo', 'foto', 'lat', 'lng', 'geo4', 'cidade', 'uf', 'status', 'criadoEm', 'atualizadoEm'])
                    && d().nome is string && d().nome.size() >= 3 && d().nome.size() <= 80 && valorTextoAte(d().get('autorNome', ''), 80)
                    && (!('idade' in d()) || (d().idade is int && d().idade >= 0 && d().idade <= 120))
                    && d().condicao in ['crianca', 'idoso', 'demencia', 'deficiencia', 'adulto', 'outro']
                    && d().parentesco in ['pais', 'filho', 'conjuge', 'irmao', 'parente', 'responsavel', 'amigo']
                    && d().descricao is string && d().descricao.size() >= 10 && d().descricao.size() <= 500
                    && valorTextoAte(d().get('sinais', ''), 300) && valorTextoAte(d().get('visto', ''), 120)
                    && d().quando is timestamp && d().quando <= request.time
                    && d().bo is string && d().bo.matches('^[A-Za-z0-9./-]{4,40}$')
                    && (!('foto' in d()) || (fotoOk(d().foto) && d().foto.size() <= 300000))
                    && pontoAproxOk(d()) && valorTextoAte(d().get('cidade', ''), 60) && valorTextoAte(d().get('uf', ''), 2)
                    && d().status == 'analise' && d().criadoEm == request.time && d().atualizadoEm == request.time;
      allow update: if logado() && mudou().hasOnly(['status', 'atualizadoEm']) && d().atualizadoEm == request.time
                    && ((resource.data.autorId == request.auth.uid && d().status in ['encontrado', 'removido'])
                        || (podeModerar() && d().status in ['removido', 'encontrado']));
      // Publicar (moderação): o número do boletim sai do aviso público (fica no registro de ações da equipe).
      allow update: if podeModerar() && resource.data.status == 'analise' && d().status == 'ativo'
                    && mudou().hasOnly(['status', 'atualizadoEm', 'bo']) && !('bo' in d()) && d().atualizadoEm == request.time;
      allow delete: if false;
      match /pistas/{p} {
        allow read: if logado() && (get(/databases/$(database)/documents/desaparecidos/$(id)).data.autorId == request.auth.uid || podeModerar());
        allow create: if logado() && emailOk()
                      && get(/databases/$(database)/documents/desaparecidos/$(id)).data.status == 'ativo'
                      && request.resource.data.keys().hasOnly(['texto', 'anonimo', 'uid', 'nome', 'lat', 'lng', 'criadoEm'])
                      && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 400
                      && request.resource.data.get('lat', 0) is number && request.resource.data.get('lng', 0) is number
                      && request.resource.data.anonimo is bool
                      && (request.resource.data.anonimo
                          ? (!('uid' in request.resource.data) && !('nome' in request.resource.data)
                             && getAfter(/databases/$(database)/documents/pistas_desap_autoria/$(id + '_' + p)).data.uid == request.auth.uid)
                          : (request.resource.data.uid == request.auth.uid && valorTextoAte(request.resource.data.get('nome', ''), 80)))
                      && request.resource.data.criadoEm == request.time;
        allow update, delete: if false;
      }
    }
    match /pistas_desap_autoria/{id} {
      allow read: if podeModerar();
      allow create: if logado() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/desaparecidos/$(id.split('_')[0])/pistas/$(id.split('_')[1])).data.anonimo == true;
      allow update, delete: if false;
    }
